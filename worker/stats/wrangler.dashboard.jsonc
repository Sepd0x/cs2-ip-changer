// The stats page (src/dashboard.js), a second Worker on the same database (it writes from its cron, and since 12 Nov. 2026 its added-up answers to the memo table, src/memo.js). Only for the person who runs the project:
// Cloudflare Access in front of all of it, and the Worker checks the Access token too. Steps: publish/dashboard-passos.md
// (outside the repo). Deploy from this folder: npx wrangler deploy -c wrangler.dashboard.jsonc
// Secrets (wrangler secret put NAME -c wrangler.dashboard.jsonc): TEAM_DOMAIN, POLICY_AUD, DASHBOARD_EMAIL, GITHUB_TOKEN,
// and optionally EXCLUDE_IDS (old fixed install IDs of your own PCs) and SERVICE_TOKEN_IDS (v4: the Client IDs of the Access
// service tokens allowed to read /api/brief, and nothing else). Beta.13, optional: GSC_KEY (the JSON key of a Google service account
// added as a read-only user of the site's Search Console property) and GSC_SITE (that property, e.g. https://sepd0x.github.io/cs2-ip-changer/):
// the daily cron then keeps Google's search impressions and clicks per day (src/dashboard.js snapshotSearch).
{
  "name": "stats-dashboard",
  "main": "src/dashboard.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  // Preview URLs would be other addresses for the same code, outside the Access application
  "preview_urls": false,
  // No request logs
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "vars": { "GITHUB_REPO": "Sepd0x/cs2-ip-changer" },
  // Nov. 2026, src/dashboard.js scheduled: every 10 minutes the live signal is counted (live_hourly); at 03:07 UTC a picture of
  // GitHub's public numbers (gh_daily) and rows with an install ID older than 12 months deleted. Cron Triggers are free.
  "triggers": { "crons": ["*/10 * * * *", "7 3 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "cs2ipc-stats", "database_id": "4c55f7d0-849d-4e6b-8b46-b8a0b7a9e19f" }
  ]
}

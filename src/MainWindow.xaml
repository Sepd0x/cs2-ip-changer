<Window x:Class="SRT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SRT"
        Title="CS2 IP Changer" Width="1240" Height="800" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <!-- Tag, Key and OptSub live in Theme.xaml (shared with the Steam sign-in window) -->

        <!-- Account card -->
        <!-- Accounts: the right-click menu of a card and of a row -->
        <ContextMenu x:Key="AccMenu" x:Shared="False">
                <MenuItem Header="Log in to this account" Tag="&#xE8AB;" Click="AccSwitch_Click"/>
                <MenuItem Header="Log in and open CS2" Tag="&#xE768;" Click="AccSwitchCs2_Click"/>
                <MenuItem Header="Copy config to…" Tag="&#xE8C8;" Click="AccCfgCopy_Click"/>
                <MenuItem Header="Use as main config" Tag="&#xE8F1;" Click="AccCfgMain_Click"/>
                <Separator/>
                <MenuItem Header="Open Steam profile" Tag="&#xE8A7;" Click="AccProfile_Click"/>
                <MenuItem Header="Open in Leetify" Tag="&#xE9D9;" Click="AccLeetify_Click"/>
                <MenuItem Header="Open in csstats.gg" Tag="&#xE9D2;" Click="AccCsstats_Click"/>
                <MenuItem Header="Copy SteamID64" Tag="&#xE8C8;" Click="AccCopyId_Click"/>
                <MenuItem Header="Copy CS2 friend code" Tag="&#xE8C8;" Click="AccCopyFriendCode_Click"/>
                <MenuItem Header="Copy username" Tag="&#xE8C8;" Click="AccCopyLogin_Click"/>
                <MenuItem Header="Change profile…" Tag="&#xE77B;" Click="AccChangeProfile_Click"/>
                <MenuItem Header="Copy look to…" Tag="&#xE8B9;" Click="AccCopyLook_Click"/>
                <Separator/>
                <MenuItem Header="Cooldown: 21 hours" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="1260"/>
                <MenuItem Header="Cooldown: 3 days (72 h)" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="4320"/>
                <MenuItem Header="Cooldown: 7 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="10080"/>
                <MenuItem Header="Cooldown: 14 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="20160"/>
                <MenuItem Header="Cooldown: 31 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="44640"/>
                <MenuItem Header="Cooldown: 45 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="64800"/>
                <MenuItem Header="Cooldown: 181 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="260640"/>
                <MenuItem Header="Custom cooldown…" Tag="&#xE70F;" Click="AccCooldown_Click" CommandParameter="-1"/>
                <MenuItem Header="Clear cooldown" Tag="&#xE711;" Click="AccCooldown_Click" CommandParameter="0"/>
                <MenuItem Header="Clear server bans" Tag="&#xE711;" Click="AccClearBans_Click" IsEnabled="{Binding HasServerBans}"/>
                <Separator/>
                <MenuItem Header="{Binding QuickMenuText}" Tag="&#xE8AB;" Click="AccToggleQuick_Click"/>
                <MenuItem Header="Favorite (yes/no)" Tag="&#xE734;" Click="AccFav_Click"/>
                <MenuItem Header="Note and tags…" Tag="&#xE70F;" Click="AccNote_Click"/>
                <MenuItem Header="Refresh this one" Tag="&#xE72C;" Click="AccRefreshOne_Click"/>
                <MenuItem Header="{Binding HideMenuText}" Tag="&#xED1A;" Click="AccHide_Click"/>
            </ContextMenu>

        <DataTemplate x:Key="AccountCard">
            <Border Margin="0,0,10,10" Style="{StaticResource Card}" BorderBrush="{Binding CardBorder}" ContextMenu="{StaticResource AccMenu}" Opacity="{Binding ListOpacity}"
                    ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="700" ToolTipService.ShowDuration="30000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                <TextBlock Text="{Binding Initial}" FontSize="15" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                <TextBlock Text="  in use" Foreground="{StaticResource Good}" FontSize="11" VerticalAlignment="Center"
                                           Visibility="{Binding Active, Converter={StaticResource Vis}}" ToolTip="Account currently logged in"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LoginShown}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0">
                            <Button Style="{StaticResource IconBtn}" Content="{Binding StarGlyph}" Click="AccFav_Click" Width="24" Height="24"
                                    ToolTip="Favorite: stays at the top"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,0" MinHeight="16">
                        <TextBlock Style="{StaticResource Tag}" Text="no Steam bans" Visibility="{Binding Clean, Converter={StaticResource Vis}}"
                                   ToolTip="No VAC, game ban, trade ban or community ban on the public Steam profile. Bans from servers are separate and shown next to it."/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding VacText}" Foreground="{StaticResource Bad}" Visibility="{Binding HasVac, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding GameBanText}" Foreground="{StaticResource Bad}" Visibility="{Binding HasGameBan, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="trade ban" Foreground="{StaticResource Warn}" Visibility="{Binding HasTradeBan, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="community" Foreground="{StaticResource Bad}" Visibility="{Binding HasCommunityBan, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding ServerBansText}" Foreground="{StaticResource Bad}" Visibility="{Binding HasServerBans, Converter={StaticResource Vis}}"
                                   ToolTip="{Binding ServerBansTip}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding CooldownText}" Foreground="{StaticResource Warn}" Visibility="{Binding InCooldown, Converter={StaticResource Vis}}"
                                   ToolTip="Cooldown set by you. Right-click to change."/>
                        <TextBlock Style="{StaticResource Tag}" Text="not in rotation" Visibility="{Binding Excluded, Converter={StaticResource Vis}}"
                                   ToolTip="New IP + next account never picks this account. Tick In rotation on this card to put it back."/>
                        <TextBlock Style="{StaticResource Tag}" Text="limited" Visibility="{Binding Limited, Converter={StaticResource Vis}}"
                                   ToolTip="Limited Steam account: it has not spent 5 USD on Steam yet, so Steam blocks friend invites and some community features. It can still play."/>
                        <TextBlock Style="{StaticResource Tag}" Text="private" Visibility="{Binding Private, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding LevelText}" Visibility="{Binding HasLevel, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding HoursText}" Visibility="{Binding HasHours, Converter={StaticResource Vis}}"/>
                        <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="5,0,5,1" Margin="0,0,10,3"
                                Visibility="{Binding HasTags, Converter={StaticResource Vis}}" ToolTip="Your tags (right-click > Note and tags)">
                            <TextBlock Text="{Binding Tags}" Foreground="{StaticResource Info}" FontSize="11"/>
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Row="2" Margin="0,4,0,0">
                        <TextBlock Text="{Binding LastServerText}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasLastServer, Converter={StaticResource Vis}}" ToolTip="{Binding LastServerText}"/>
                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                    </StackPanel>
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Switch}" Content="In rotation" IsChecked="{Binding InRotation, Mode=OneWay}" Click="AccToggleQuick_Click"
                                  VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" ToolTip="{Binding QuickTip}"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Click="AccSwitch_Click" VerticalAlignment="Bottom">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowBtn}">
                                    <Setter Property="Content" Value="Log in"/>
                                    <Setter Property="ToolTip" Value="Closes Steam and reopens it on this account. Only works for accounts with 'Remember me' ticked on this PC."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                            <Setter Property="Content" Value="In use"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Accounts as rows (4 nov.): picked in Accounts, offered from 12 accounts. The same menu, star, rotation and Log in as the card, on one line. -->
        <DataTemplate x:Key="AccountRow">
            <Border Margin="0,0,10,3" Padding="10,3" Style="{StaticResource Card}" BorderBrush="{Binding CardBorder}" ContextMenu="{StaticResource AccMenu}" Opacity="{Binding ListOpacity}"
                    ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="700" ToolTipService.ShowDuration="30000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                            <TextBlock Text="{Binding Initial}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                        <TextBlock Text="  in use" Foreground="{StaticResource Good}" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding Active, Converter={StaticResource Vis}}" ToolTip="Account currently logged in"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding LoginShown}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True" Margin="0,3,0,0">
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding VacText}" Foreground="{StaticResource Bad}" Visibility="{Binding HasVac, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding GameBanText}" Foreground="{StaticResource Bad}" Visibility="{Binding HasGameBan, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="trade ban" Foreground="{StaticResource Warn}" Visibility="{Binding HasTradeBan, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="community" Foreground="{StaticResource Bad}" Visibility="{Binding HasCommunityBan, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding ServerBansText}" Foreground="{StaticResource Bad}" Visibility="{Binding HasServerBans, Converter={StaticResource Vis}}"
                                   ToolTip="{Binding ServerBansTip}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding CooldownText}" Foreground="{StaticResource Warn}" Visibility="{Binding InCooldown, Converter={StaticResource Vis}}"
                                   ToolTip="Cooldown set by you. Right-click to change."/>
                        <TextBlock Style="{StaticResource Tag}" Text="not in rotation" Visibility="{Binding Excluded, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="limited" Visibility="{Binding Limited, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding HoursText}" Visibility="{Binding HasHours, Converter={StaticResource Vis}}"/>
                        <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="5,0,5,1" Margin="0,0,10,3"
                                Visibility="{Binding HasTags, Converter={StaticResource Vis}}" ToolTip="Your tags (right-click > Note and tags)">
                            <TextBlock Text="{Binding Tags}" Foreground="{StaticResource Info}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource IconBtn}" Content="{Binding StarGlyph}" Click="AccFav_Click" Width="24" Height="24" VerticalAlignment="Center"
                            ToolTip="Favorite: stays at the top"/>
                    <CheckBox Grid.Column="5" Style="{StaticResource Switch}" IsChecked="{Binding InRotation, Mode=OneWay}" Click="AccToggleQuick_Click" Margin="10,0,0,0"
                              VerticalAlignment="Center" ToolTip="{Binding QuickTip}"/>
                    <Button Grid.Column="6" Margin="8,0,0,0" Click="AccSwitch_Click" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowBtn}">
                                <Setter Property="Content" Value="Log in"/>
                                <Setter Property="ToolTip" Value="Closes Steam and reopens it on this account. Only works for accounts with 'Remember me' ticked on this PC."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Active}" Value="True">
                                        <Setter Property="Content" Value="In use"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="AccCardsPanel">
            <UniformGrid Columns="4" VerticalAlignment="Top" Loaded="AccGrid_Loaded"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="AccRowsPanel">
            <StackPanel Loaded="AccGrid_Loaded"/>
        </ItemsPanelTemplate>

        <!-- Server list row -->
        <Style x:Key="ServerRowItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="b" Background="Transparent" Padding="8,6">
                                <ContentPresenter/>
                            </Border>
                            <!-- selected: a 2 px accent bar on the left edge, and the title in the accent -->
                            <Border x:Name="bar" Width="2" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One player under an open server row -->
        <DataTemplate x:Key="PlayerChip">
            <Border Margin="0,0,6,4" Padding="8,4" Background="{StaticResource Surface2}" ToolTip="{Binding Tip}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Flag as Staff" Tag="&#xE7C1;" Click="PlayerStaff_Click"/>
                        <MenuItem Header="{Binding FlagMenuText}" Tag="&#xE70F;" Click="PlayerFlag_Click"/>
                        <MenuItem Header="{Binding FollowMenuText}" Tag="&#xE7B3;" Click="PlayerFollow_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy name" Tag="&#xE8C8;" Click="PlayerCopy_Click"/>
                        <MenuItem Header="Remove flag" Tag="&#xE74D;" Click="PlayerUnflag_Click" IsEnabled="{Binding HasFlag}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding FlagSoftBrush}" Padding="5,0" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasFlag, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding FlagLabel}" Foreground="{Binding FlagBrush}" FontSize="11" FontWeight="SemiBold" MaxWidth="70" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Score}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Faint}" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ServerRow">
          <StackPanel>
            <Grid ToolTip="{Binding Tip}" ToolTipService.ShowDuration="30000" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Join" Tag="&#xE768;" Click="SrvConnect_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy IP:port" Tag="&#xE8C8;" Click="CopyServers_Click"/>
                        <MenuItem Header="Copy connect command" Tag="&#xE8C8;" Click="SrvCopyConnect_Click"/>
                        <MenuItem Header="Favorite (yes/no)" Tag="&#xE734;" Click="SrvFav_Click"/>
                        <Separator/>
                        <MenuItem Header="Mark the account in use as banned here" Tag="&#xE7BA;" Click="SrvMarkBan_Click"/>
                        <MenuItem Header="Clear ban marks here" Tag="&#xE711;" Click="SrvClearBans_Click" IsEnabled="{Binding HasBans}"/>
                        <MenuItem Header="Set community name…" Tag="&#xE716;" Click="SrvNetwork_Click"
                                  ToolTip="Servers with the same community name share ban marks. Empty: the app guesses from the server name."/>
                        <Separator/>
                        <MenuItem Header="Remove" Tag="&#xE74D;" Click="RemoveServers_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="3*" MinWidth="200" MaxWidth="520"/>
                    <ColumnDefinition Width="1.3*" MinWidth="120" MaxWidth="190"/>
                    <ColumnDefinition Width="1*" MinWidth="90" MaxWidth="140"/>
                    <ColumnDefinition Width="0.8*" MinWidth="70" MaxWidth="100"/>
                    <ColumnDefinition Width="1*" MinWidth="95" MaxWidth="140"/>
                    <ColumnDefinition Width="0.01*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconBtn}" Content="{Binding StarGlyph}" Click="SrvFav_Click" ToolTip="Favorite: stays at the top" Width="24" Height="24"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="{Binding RowTitle}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <!-- Narrow rows trim the "You played here" note first: the ban and the flag say more -->
                    <DockPanel Margin="0,1,10,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Faint}"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding BannedText}" Foreground="{StaticResource Bad}" FontSize="11" Margin="10,0,0,0"
                                   Visibility="{Binding HasBans, Converter={StaticResource Vis}}" ToolTip="The account you're logged in with was banned here, or on another server of the same network (they usually share their ban list). New IP + next account skips it here."/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding FlaggedText}" Foreground="{Binding FlaggedBrush}" FontSize="11" Margin="10,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasFlagged, Converter={StaticResource Vis}}" ToolTip="{Binding FlaggedText}"/>
                        <TextBlock Text="{Binding LastText}" Foreground="{StaticResource Info}" FontSize="11" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsLast, Converter={StaticResource Vis}}" ToolTip="{Binding LastText}"/>
                    </DockPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Map}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="3" Style="{StaticResource Ghost}" Padding="4,2" Margin="-4,0,0,0" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                        Click="SrvPlayers_Click" IsEnabled="{Binding HasPlayerList}" ToolTip="{Binding PlayersTip}" ToolTipService.ShowOnDisabled="True">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PlayersText}" FontFamily="{StaticResource Mono}" FontSize="11"/>
                            <TextBlock Text="{Binding ChevronGlyph}" Style="{StaticResource Icon}" FontSize="8" Margin="6,1,0,0" Foreground="{StaticResource Muted}"
                                       Visibility="{Binding HasPlayerList, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="hidden" FontSize="11" Margin="6,0,0,0" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                       Visibility="{Binding PlayersHidden, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <Grid Width="56" Height="3" HorizontalAlignment="Left" Margin="0,2,0,-5" Visibility="{Binding HasPlayers, Converter={StaticResource Vis}}">
                            <Border Background="{StaticResource Surface3}"/>
                            <Border Background="{StaticResource AccentFill}" HorizontalAlignment="Left" Width="{Binding Fill}"/>
                        </Grid>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="4" Text="{Binding PingText}" Foreground="{Binding PingBrush}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                           ToolTip="Measured on the connection the game uses now: the phone with protection on, your home connection otherwise."/>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="Protected = Windows sends this server through the phone and blocks it on the home network.">
                    <local:StatusMark Brush="{Binding RouteBrush}"/>
                    <TextBlock Text="{Binding RouteText}" Foreground="{Binding RouteTextBrush}" Margin="7,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="7" Style="{StaticResource RowBtn}" Margin="0" Click="SrvConnect_Click" HorizontalAlignment="Right" Content="Join"
                        ToolTip="Runs the checks for the way you play now (with protection on: this server's route through the phone), then opens the game. If a check fails, the game does not open."/>
            </Grid>
            <StackPanel Tag="players" Margin="32,8,0,4" Visibility="{Binding Expanded, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding Players}" ItemTemplate="{StaticResource PlayerChip}">
                    <ItemsControl.ItemsPanel>
                        <!-- As many 210 px columns as fit, so the chips fill the row (PlayerGrid_SizeChanged) -->
                        <ItemsPanelTemplate><UniformGrid VerticalAlignment="Top" SizeChanged="PlayerGrid_SizeChanged"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="Right-click a player to flag them. Servers only share names, so a flag matches anyone with that name. Add their Steam profile to the flag to keep it after a name change."
                           Foreground="{StaticResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource TopLine}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================================ Tabs -->
                <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- the logo (publish/logo-2026-11-06, its 24 px drawing on a 32 grid), in the corner above Connection -->
                        <Image x:Name="SideLogo" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                               IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="CS2 IP Changer">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H32 V32 H0 Z"/>
                                            <GeometryDrawing Geometry="M1.5,15.5c0,-7.456 6.044,-13.5 13.5,-13.5c7.456,0 13.5,6.044 13.5,13.5c0,0.927 -0.093,1.831 -0.271,2.705c-0.239,-0.064 -0.485,-0.114 -0.735,-0.149c-1.333,-5.412 -5.177,-10.056 -10.494,-10.056c-4.488,0 -9.183,5.237 -12.646,12.165l-2.026,0c-0.535,-1.454 -0.828,-3.026 -0.828,-4.665z">
                                                <GeometryDrawing.Brush><SolidColorBrush Color="{StaticResource AccentDeepColor}"/></GeometryDrawing.Brush>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="{StaticResource Accent}" Geometry="M15,29c-3.435,0 -6.57,-1.283 -8.953,-3.395c2.576,-8.171 5.601,-13.605 10.953,-13.605c5.389,0 6.517,2.103 6.859,6.696c-1.899,1.007 -3.192,3.005 -3.192,5.304c0,1.203 0.354,2.323 0.964,3.262c-1.958,1.106 -4.221,1.738 -6.631,1.738z"/>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Brush><SolidColorBrush Color="{StaticResource AccentDeepColor}"/></GeometryDrawing.Brush>
                                                <GeometryDrawing.Geometry><EllipseGeometry Center="26.667,24" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Brush><SolidColorBrush Color="{StaticResource Top3}"/></GeometryDrawing.Brush>
                                                <GeometryDrawing.Geometry><EllipseGeometry Center="26.667,24" RadiusX="2.667" RadiusY="2.667"/></GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>
                        <StackPanel Margin="0,48,-1,0">
                            <RadioButton x:Name="NavNet" Style="{StaticResource Nav}" Tag="&#xEA18;" Content="Connection" IsChecked="True" Checked="Nav_Checked"
                                         ToolTip="The IP servers see, Change IP and the phone"/>
                            <RadioButton x:Name="NavServers" Style="{StaticResource Nav}" Tag="&#xE968;" Content="Servers" Checked="Nav_Checked"
                                         ToolTip="Your servers: players, ping and Join"/>
                            <RadioButton x:Name="NavRegions" Style="{StaticResource Nav}" Tag="&#xE909;" Content="Regions" Checked="Nav_Checked"
                                         ToolTip="Pick where CS2 matchmaking can play"/>
                            <RadioButton x:Name="NavAccounts" Style="{StaticResource Nav}" Tag="&#xE716;" Content="Accounts" Checked="Nav_Checked"
                                         ToolTip="Switch Steam account with one click"/>
                            <RadioButton x:Name="NavConfigs" Style="{StaticResource Nav}" Tag="&#xE8F1;" Content="Configs" Checked="Nav_Checked"
                                         ToolTip="CS2 config copied between your accounts"/>
                            <RadioButton x:Name="NavProfiles" Style="{StaticResource Nav}" Tag="&#xE77B;" Content="Profiles" Checked="Nav_Checked"
                                         ToolTip="Change the name, picture and details of your Steam accounts, or make them all look the same"/>
                            <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" Tag="&#xE81C;" Content="Log" Checked="Nav_Checked"
                                         ToolTip="Everything the app did, with timestamps"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource Faint}" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <Button x:Name="UpdateBtn" Style="{StaticResource RowPrimary}" Click="Update_Click" Content="Update" Padding="10,0" Margin="0,6,0,0" FontSize="11"
                                    HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================================ Content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- top bar: page, status, quick switch, window -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Margin="16,0,16,0" VerticalAlignment="Center" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="CS2 IP Changer" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Text="  /  " Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" x:Name="PageTitle" Text="Connection" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <!-- the command running now (hotkeys and buttons), then how it ended -->
                            <Border x:Name="ActivityPill" HorizontalAlignment="Left" Margin="16,0,0,0" MaxWidth="440" Padding="9,3,11,3" Background="{StaticResource Surface3}"
                                    Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonUp="Activity_Click"
                                    ToolTip="{Binding Text, ElementName=ActivityText}">
                                <DockPanel>
                                    <!-- while the command only waits (CS2's menu, Steam, an answer): stop it without starting another -->
                                    <TextBlock x:Name="ActivityCancel" DockPanel.Dock="Right" Text="Cancel" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ActivityCancel_Click"
                                               ToolTip="Stops what the app is waiting for. Nothing that already happened is undone."/>
                                    <TextBlock x:Name="ActivityIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE895;" FontSize="12" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform x:Name="ActivitySpin"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="ActivityText" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                        <ProgressBar x:Name="ActivityLine" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True" Background="Transparent" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand" Background="Transparent"
                                        MouseLeftButtonUp="SideStatus_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Click to go to Connection.">
                                <local:StatusMark Brush="{Binding Fill, ElementName=SideDot}"/>
                                <Ellipse x:Name="SideDot" Width="0" Height="0" Fill="{StaticResource Warn}"/>
                                <TextBlock x:Name="SideState" Text="Checking…" Margin="7,0,0,0" Foreground="{Binding Fill, ElementName=SideDot}"/>
                                <TextBlock x:Name="SideIp" Text="—" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="SideQuick" Style="{StaticResource Primary}" Click="Quick_Click" Margin="0" Padding="12,0" MinWidth="120" WindowChrome.IsHitTestVisibleInChrome="True" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="New IP + next account (its hotkey works in game too): new IP, next account, back to the last server.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SideQuickLabel" Text="New IP + next account"/>
                                    <TextBlock x:Name="SideQuickNext" Text="" FontWeight="SemiBold" Margin="3,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                    <TextBlock x:Name="SideQuickTail" Text=""/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource Chrome}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"/>
                            <Button x:Name="MaxBtn" Style="{StaticResource Chrome}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize"/>
                            <Button Style="{StaticResource Chrome}" Tag="close" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
                        </StackPanel>
                    </Grid>

                    <!-- ======================================== Page: Connection -->
                    <ScrollViewer x:Name="PageNet" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,6">
                        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- The last group of each column reaches the bottom, so both columns end on one line (beta.9) -->
                            <Grid x:Name="NetLeft">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <HeaderedContentControl x:Name="Hero" Style="{StaticResource Group}" Header="Status">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="HeroBadge" Width="30" Height="28" Background="{StaticResource WarnSoft}" VerticalAlignment="Top" Margin="0,2,0,0">
                                                <TextBlock x:Name="HeroIcon" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="HeroTitle" Text="Checking the connection…" Style="{StaticResource H1}" Foreground="{Binding Foreground, ElementName=HeroIcon}"/>
                                                <TextBlock x:Name="HeroSub" Text="One moment." Style="{StaticResource Sub}" Margin="0,2,0,0" MaxWidth="460" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="360"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*" MaxWidth="360"/>
                                                <ColumnDefinition Width="0.01*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel ToolTip="The public IP the servers in your list see.">
                                                <TextBlock Text="IP servers see" Style="{StaticResource Key}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="EgressIp" Text="—" FontFamily="{StaticResource Mono}" FontSize="19"/>
                                                    <Button x:Name="CopyIpBtn" Style="{StaticResource IconBtn}" Content="&#xE8C8;" Click="CopyEgressIp_Click" Margin="4,0,0,0" ToolTip="Copy IP"/>
                                                </StackPanel>
                                                <TextBlock x:Name="EgressIsp" Text="—" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="Hidden so it does not show up in screenshots or streams.">
                                                <TextBlock Text="Your home IP" Style="{StaticResource Key}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="HomeIp" Text="—" FontFamily="{StaticResource Mono}" FontSize="19" Foreground="{StaticResource Faint}"/>
                                                    <Button x:Name="RevealBtn" Style="{StaticResource IconBtn}" Content="&#xE7B3;" Click="Reveal_Click" Margin="4,0,0,0"
                                                            ToolTip="Show or hide"/>
                                                </StackPanel>
                                                <TextBlock x:Name="HomeIsp" Text="—" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,1,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <WrapPanel Grid.Row="2" x:Name="ActionRow" Margin="0,16,0,-6">
                                            <!-- beta.10: protection starts off; this is the one way on (also in the tray icon's menu) -->
                                            <Button x:Name="TurnOnBtn" Style="{StaticResource Primary}" Padding="22,0" Margin="0,0,6,6" VerticalAlignment="Top" Click="TurnOn_Click" Content="Turn on protection"
                                                    Visibility="Collapsed"
                                                    ToolTip="The kill switch, the routes and the CS2 lock: servers only see the phone's IP, and if the phone drops they are blocked instead of seeing your home IP. It stays on until you turn it off."/>
                                            <Button x:Name="ChangeIpBtn" Style="{StaticResource Primary}" Padding="22,0" Margin="0,0,6,6" VerticalAlignment="Top" Click="ChangeIp_Click" Content="Change IP"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="Turns the phone's mobile data off and on until the carrier gives a new IP. Needs the phone set up over ADB. If you are on a server, you will drop."/>
                                            <StackPanel Margin="0,0,6,6" VerticalAlignment="Top">
                                                <Button x:Name="RejoinBtn" Click="Rejoin_Click" Margin="0" Content="Change IP and rejoin"
                                                        ToolTip="Changes the IP, then joins the last server again. Only joins with protection confirmed. In game: the rejoin hotkey (Settings > Hotkeys and sounds)."/>
                                                <TextBlock x:Name="RejoinHotkeyHint" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                           ToolTip="Works while CS2 is in front. Change it in Settings > Hotkeys and sounds.">
                                                    <Run x:Name="RejoinHotkeyKeys" Text="Ctrl+Shift+F10" FontFamily="{StaticResource Mono}"/><Run Text=" in game"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button x:Name="LeakBtn" Click="LeakTest_Click" Margin="0,0,6,6" VerticalAlignment="Top" Content="Run leak test"
                                                    ToolTip="Full test: Firewall, block, each server's route and whether the phone's IP really differs from your home IP."/>
                                            <Button x:Name="TurnOffBtn" Style="{StaticResource Danger}" Click="Restore_Click" Margin="0,0,0,6" VerticalAlignment="Top" Content="Turn off protection" Visibility="Collapsed"
                                                    ToolTip="Removes the block, the routes and the CS2 lock. Use it if your internet stops working. Turn on protection brings it back. Your servers stay saved, and regions you turned off stay off (Allow all on Regions lifts them)."/>
                                        </WrapPanel>

                                        <Grid Grid.Row="2" x:Name="ProgressPanel" Margin="0,16,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="560"/>
                                                <ColumnDefinition Width="0.01*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="ProgressText" Text="" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                <ProgressBar IsIndeterminate="True" Height="2"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </HeaderedContentControl>

                                <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Header="Phone">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- PhoneDot holds the colour the code sets; the marker draws it with its shape -->
                                            <Rectangle x:Name="PhoneDot" Width="0" Height="0" Fill="{StaticResource Faint}"/>
                                            <local:StatusMark Brush="{Binding Fill, ElementName=PhoneDot}"/>
                                            <TextBlock x:Name="PhoneState" Text="Searching…" Margin="7,0,0,0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="PhoneDetail" Text="" Foreground="{StaticResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="16,2,0,12"/>
                                        <!-- Until a phone has been seen once, Phone setup leads and the single steps stay out of the way (MainWindow.Phone.cs) -->
                                        <WrapPanel x:Name="PhoneButtons">
                                            <Border x:Name="AdbInstallHost">
                                                <Button x:Name="AdbInstallBtn" Style="{StaticResource Primary}" Click="AdbInstall_Click" Margin="0,0,6,6" Visibility="Collapsed" Content="Install phone tool (ADB)"
                                                        ToolTip="Downloads Google's official ADB (~7 MB) to the app folder. One time only."/>
                                            </Border>
                                            <Button x:Name="WifiOffBtn" Style="{StaticResource Primary}" Click="WifiOff_Click" Margin="0,0,6,6" Visibility="Collapsed" Content="Turn off phone Wi-Fi"
                                                    ToolTip="So USB tethering uses mobile data and not the home network."/>
                                            <Border x:Name="TetherHost">
                                                <Button x:Name="TetherBtn" Click="Tether_Click" Margin="0,0,6,6" Content="Turn on USB tethering"
                                                        ToolTip="Asks the phone to turn on USB tethering and waits up to 15 s for Windows to see it. On some models you have to turn it on by hand."/>
                                            </Border>
                                            <Button x:Name="PhoneSetupBtn" Click="PhoneHelp_Click" Margin="0,0,6,6" Content="Phone setup"
                                                    ToolTip="Installs the phone tool if it's missing, then checks the cable, the driver, USB debugging, tethering, the phone's Wi-Fi and where the rest of the PC goes, fixes what it can and tells you the one thing left to do"/>
                                        </WrapPanel>
                                        <TextBlock Text="How the PC connects to the phone" Style="{StaticResource Key}" Margin="0,8,0,5"/>
                                        <ComboBox x:Name="EgressCombo" SelectionChanged="EgressCombo_Changed" MaxWidth="420" HorizontalAlignment="Left" MinWidth="280"
                                                  ToolTip="USB cable (recommended) or the phone's Wi-Fi hotspot. A USB 4G/5G dongle or router also works."/>
                                        <TextBlock x:Name="EgressDetail" Text="" Visibility="Collapsed" Foreground="{StaticResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="DataUsage" Text="" Visibility="Collapsed" Foreground="{StaticResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Background="Transparent"
                                                   ToolTip="Everything that went through the phone's adapter (CS2, Steam and, in Whole PC, the rest of the PC), counted by Windows. Your carrier's count can differ a little. Warning: Settings > Mobile data."/>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl x:Name="ModeGroup" Grid.Row="2" Style="{StaticResource Group}" Header="What goes through the phone">
                                    <StackPanel>
                                        <RadioButton x:Name="ModeServers" Style="{StaticResource Choice}" GroupName="mode" Checked="Mode_Checked">
                                            <StackPanel>
                                                <TextBlock Text="Game only"/>
                                                <TextBlock Text="CS2, Steam and the servers on your Servers page. You can only join those. The rest of the PC stays on your home network." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ModeGame" Style="{StaticResource Choice}" GroupName="mode" Checked="Mode_Checked">
                                            <StackPanel>
                                                <TextBlock Text="Whole PC while CS2 is open"/>
                                                <TextBlock Text="You can join any server, not only the ones on your Servers page. While CS2 is open the whole PC uses the phone, so it uses more mobile data. Back to normal when you close CS2." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ModeAll" Style="{StaticResource Choice}" GroupName="mode" Checked="Mode_Checked">
                                            <StackPanel>
                                                <TextBlock Text="Whole PC, always"/>
                                                <TextBlock Text="Everything goes through the phone. Uses more data." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ModeHome" Style="{StaticResource Choice}" GroupName="mode" Checked="Mode_Checked" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="No phone: play on your home connection"/>
                                                <TextBlock Text="Not protected: servers see your home IP and there is no Change IP. Accounts, Configs, Profiles and Regions still work." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <TextBlock Text="Save mobile data and Fall back to Game only: Settings > Mobile data." Style="{StaticResource OptSub}" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="PcRouteText" Visibility="Collapsed"/>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </Grid>

                            <Grid x:Name="NetRight" Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <HeaderedContentControl Style="{StaticResource Group}" Header="Checks">
                                    <StackPanel>
                                        <!-- beta.11: only the rows that need you, unless Show all (remembered) -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ChecksSummary" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                            <Button x:Name="ChecksToggle" Grid.Column="1" Style="{StaticResource Ghost}" Padding="8,2" Margin="8,0,0,0" Content="Show all" Click="ChecksToggle_Click"
                                                    ToolTip="Every check, also the ones that are fine"/>
                                        </Grid>
                                        <ItemsControl x:Name="Checks">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,9" ToolTip="{Binding Help}" Background="Transparent" Visibility="{Binding Shown, Converter={StaticResource Vis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <local:StatusMark Brush="{Binding Brush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{Binding DetailBrush}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Header="How it works">
                                    <TextBlock Style="{StaticResource Sub}" LineHeight="19" MaxWidth="640" HorizontalAlignment="Left">
                                        The phone shares its mobile data with the PC, over a USB cable or the Wi-Fi hotspot. The app sends the game through it: servers see the carrier IP, not your home IP.<LineBreak/><LineBreak/>
                                        If the connection drops, the block stops those servers instead of letting your IP through.<LineBreak/><LineBreak/>
                                        Change IP turns data off and on until a new IP comes. A USB 4G/5G dongle or router also works.<LineBreak/><LineBreak/>
                                        <Run Foreground="{StaticResource Faint}">Other people on the same carrier can use the same IP at the same time.</Run>
                                    </TextBlock>
                                </HeaderedContentControl>

                                <HeaderedContentControl x:Name="HistoryGroup" Grid.Row="2" Style="{StaticResource Group}" Header="Previous IPs">
                                    <StackPanel>
                                        <TextBlock x:Name="HistoryEmpty" Text="No IP changes yet." Style="{StaticResource Sub}"/>
                                        <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="History">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="118"/>
                                                            <ColumnDefinition Width="*" MaxWidth="300"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Ip}" FontFamily="{StaticResource Mono}" FontSize="11"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding IspShort}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Isp}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding ReasonText}" Foreground="{StaticResource Faint}" FontSize="11" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>
                                        <Button x:Name="ClearHistoryBtn" HorizontalAlignment="Left" Margin="0,6,0,0" Content="Clear history" Click="ClearHistory_Click"/>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- ======================================== Page: Servers -->
                    <Grid x:Name="PageServers" Grid.Row="1" Margin="16,0,16,6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <HeaderedContentControl Style="{StaticResource Group}" Header="Add servers">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="640"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="0.01*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BulkInput" Height="28" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled"
                                         FontFamily="{StaticResource Mono}" VerticalContentAlignment="Center" PreviewKeyDown="BulkInput_KeyDown"
                                         Tag="Paste server IPs here, e.g. 1.2.3.4:27015 (Ctrl+Enter adds)"
                                         ToolTip="Accepts IP:port, 'IP port', 'connect IP:port', steam://connect links and whole lists. Duplicates are ignored."/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                            ToolTip="Port used when you paste only the IP (CS2 uses 27015)">
                                    <TextBlock Text="Default port" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="DefaultPortBox" Width="64" Height="28" FontFamily="{StaticResource Mono}" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                    <Button Style="{StaticResource Primary}" Click="AddServers_Click" Content="Add" ToolTip="Adds those servers to the list (Ctrl+Enter). With protection on, they only go out through the phone."/>
                                    <Button Click="PasteServers_Click" Content="Paste" ToolTip="Adds whatever is on the clipboard"/>
                                    <Button Click="ImportServers_Click" Margin="0" Content="Import" ToolTip="Reads every IP:port from a .txt, .csv or .cfg file"/>
                                </StackPanel>
                            </Grid>
                        </HeaderedContentControl>

                        <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Header="Servers" Padding="6,14,6,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="FollowBar" Grid.Row="1" Margin="8,0,8,10" Padding="12,8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto" MaxWidth="900"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="FollowText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                            <Button x:Name="FollowJoinBtn" Style="{StaticResource Primary}" Click="FollowJoin_Click" Content="Join"
                                                    ToolTip="Joins that server with the usual protection checks"/>
                                            <Button Click="FollowDismiss_Click" Margin="0" Content="Dismiss"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="SlotBar" Grid.Row="1" Margin="8,0,8,10" Padding="12,8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto" MaxWidth="900"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="SlotText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                            <CheckBox x:Name="SlotAutoBox" Style="{StaticResource Switch}" Content="Join automatically" VerticalAlignment="Center" Margin="0,0,14,0"
                                                      ToolTip="On: joins as soon as a slot opens, with the usual checks. Off: only a sound and a notice."/>
                                            <Button x:Name="SlotJoinBtn" Style="{StaticResource Primary}" Click="SlotJoin_Click" Content="Join" Visibility="Collapsed"/>
                                            <Button Click="SlotCancel_Click" Margin="0" Content="Cancel"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Margin="8,0,8,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServerSearch" Tag="Search name, IP or map" TextChanged="ServerSearch_Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ServerCount" Grid.Column="1" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <CheckBox x:Name="AutoQueryBox" Style="{StaticResource Switch}" Content="Refresh every 30 s" Margin="0,0,14,0" VerticalAlignment="Center" Click="AutoQuery_Click"
                                                  ToolTip="Players, map and ping every 30 seconds, on the connection the game uses now"/>
                                        <Button x:Name="QueryBtn" Click="QueryServers_Click" Content="Refresh all" ToolTip="Asks the marked servers, or all the ones shown when none is marked, for their name, map, players and ping. With protection on, only through the phone, never the home network. Click a marked server again, or press Escape, to unmark it."/>
                                        <Button x:Name="CopyBtn" Click="CopyServers_Click" Content="Copy IPs" ToolTip="Copies the selected servers (or all the ones shown) as IP:port"/>
                                        <Border Width="1" Background="{StaticResource Line}" Margin="4,4,14,4"/>
                                        <Button x:Name="RemoveBtn" Style="{StaticResource Danger}" Margin="0" Click="RemoveServers_Click" Content="Remove" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Removes the selected servers and their routes. Select first (Ctrl or Shift for several)."/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="ServerHeader" Grid.Row="2" Margin="8,0,18,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="3*" MinWidth="200" MaxWidth="520"/>
                                        <ColumnDefinition Width="1.3*" MinWidth="120" MaxWidth="190"/>
                                        <ColumnDefinition Width="1*" MinWidth="90" MaxWidth="140"/>
                                        <ColumnDefinition Width="0.8*" MinWidth="70" MaxWidth="100"/>
                                        <ColumnDefinition Width="1*" MinWidth="95" MaxWidth="140"/>
                                        <ColumnDefinition Width="0.01*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Server" Style="{StaticResource CardTitle}" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="Map" Style="{StaticResource CardTitle}" Margin="3,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="Players" Style="{StaticResource CardTitle}" Margin="3,0,0,0" Background="Transparent"
                                               ToolTip="Click a player count to see who is on the server. Right-click a player there to flag them."/>
                                    <TextBlock Grid.Column="4" Text="Ping" Style="{StaticResource CardTitle}" Margin="3,0,0,0"/>
                                    <TextBlock Grid.Column="5" Text="Route" Style="{StaticResource CardTitle}" Margin="3,0,0,0"/>
                                </Grid>
                                <ListBox x:Name="ServerList" Grid.Row="3" Padding="0" SelectionMode="Extended" ItemContainerStyle="{StaticResource ServerRowItem}"
                                         ItemTemplate="{StaticResource ServerRow}" MouseDoubleClick="ServerList_DoubleClick" SelectionChanged="ServerList_SelectionChanged"
                                         PreviewMouseLeftButtonDown="ServerList_PreviewMouseDown" KeyDown="ServerList_KeyDown"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                <StackPanel x:Name="ServersEmpty" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="No servers yet" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Paste the IP:port of the servers you play on, or import a .txt or .cfg file." Foreground="{StaticResource Muted}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    <!-- beta.11, 2nd round of simulated users: they know the server's name, not its IP, and a banned player can't join it to type status -->
                                    <TextBlock x:Name="ServersEmptyHelp" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,4,0,12" HorizontalAlignment="Center" TextAlignment="Center"
                                               Text="Only know its name? Join it once in CS2 with protection off (that join uses your home IP): the app offers to add it.&#x0a;Banned there? Ask on its Discord or website for the IP (it often reads connect 1.2.3.4:27015)."/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource Primary}" Click="PasteServers_Click" Content="Paste from clipboard"/>
                                        <Button Click="ImportServers_Click" Margin="0" Content="Import file"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </HeaderedContentControl>
                    </Grid>

                    <!-- ======================================== Page: Regions -->
                    <Grid x:Name="PageRegions" Grid.Row="1" Margin="16,0,16,6" Visibility="Collapsed" Loaded="PageRegions_Loaded" IsVisibleChanged="PageRegions_VisibleChanged">
                        <Grid.Resources>
                            <!-- Ping slider, the gamesense way: a 6 px bar filled up to the value, no handle; click or drag anywhere on it -->
                            <Style x:Key="RegionTrackPart" TargetType="RepeatButton">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="RegionSlider" TargetType="Slider">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid Height="16" Background="Transparent">
                                                <Border x:Name="bar" Height="6" VerticalAlignment="Center" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Edge}" BorderThickness="1"/>
                                                <Track x:Name="PART_Track" Margin="1,0">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource RegionTrackPart}" Background="{StaticResource AccentFill}" Command="Slider.DecreaseLarge"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource RegionTrackPart}" Background="Transparent" Command="Slider.IncreaseLarge"/>
                                                    </Track.IncreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <!-- An invisible grip at the end of the fill: it only gives the drag something to hold -->
                                                        <Thumb Width="8" Height="16">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Grid Background="Transparent">
                                                                        <Border Height="4" VerticalAlignment="Center" Background="{StaticResource AccentFill}"/>
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bar" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <HeaderedContentControl Style="{StaticResource Group}" Header="Matchmaking regions">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="RegionsStatus" Text="Loading regions…" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RegionsRule" Style="{StaticResource Sub}" Margin="0,3,0,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="RegionsSource" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button x:Name="RegionsRefreshBtn" Grid.Column="1" Margin="0" VerticalAlignment="Top" Click="RegionsRefresh_Click" Content="Refresh"
                                            ToolTip="Reads Valve's relay list again and measures the ping to every region on the connection the game uses now"/>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="RegionsClosestBtn" IsEnabled="False" Click="RegionsClosest_Click" Content="Closest 3" ToolTip="Keeps the 3 regions with the lowest ping and turns the rest off"/>
                                    <Button x:Name="RegionsContinentBtn" IsEnabled="False" Click="RegionsContinent_Click" Content="Europe only" Visibility="Collapsed" ToolTip="Keeps every region in your continent and turns the rest off"/>
                                    <Button x:Name="RegionsAllowAllBtn" IsEnabled="False" Click="RegionsAllowAll_Click" Content="Allow all (block off)" ToolTip="Turns every region back on and removes the Firewall rule. CS2 picks as usual."/>
                                    <Border Width="1" Background="{StaticResource Line}" Margin="4,4,14,4"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                                ToolTip="Keeps only the regions that answered with a ping at or under this value">
                                        <TextBlock Text="Ping under" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="RegionsMaxPing" Style="{StaticResource RegionSlider}" Width="150" Minimum="20" Maximum="200" SmallChange="5" LargeChange="10"
                                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="RegionsMaxPing_Changed"/>
                                        <TextBlock x:Name="RegionsMaxPingText" Text="60 ms" FontFamily="{StaticResource Mono}" Width="52" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="RegionsUnderBtn" IsEnabled="False" Click="RegionsUnder_Click" Content="Block slower" ToolTip="Turns off every region above that ping (and the ones that didn't answer)"/>
                                </WrapPanel>
                                <Border Margin="0,8,0,0" Padding="12,8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Warn}" BorderThickness="2,0,0,0" ToolTipService.ShowDuration="30000"
                                        ToolTip="Changes apply at once, but CS2 only reads the regions when it starts, so a CS2 that is already open keeps the old ones until you restart it.&#x0A;Allowing too few regions can mean long queues or no match at all, and Premier can take longer.&#x0A;Only cs2.exe is blocked, and only from Valve's relays. Steam, friends and community servers are not touched.&#x0A;Valve can still send a match to a blocked region through a relay you allow.">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="RegionsWarning" TextWrapping="Wrap"
                                                   Text="If CS2 is open, restart it after changing regions, and never change them during a match. Allowing too few regions means long queues or no match."/>
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="RegionsMaxPingHint" Style="{StaticResource Sub}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Header="Regions" Padding="6,14,6,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid x:Name="RegionHeader" Margin="14,0,14,4" Visibility="Hidden">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="2*" MinWidth="150" MaxWidth="300"/>
                                        <ColumnDefinition Width="2*" MinWidth="150" MaxWidth="300"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Allow" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="Region" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Grid.Column="2" Text="Country" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Grid.Column="3" Text="Ping" Style="{StaticResource CardTitle}" Margin="0" ToolTip="Measured on the connection the game uses now: the phone with protection on, your home connection otherwise."/>
                                    <!-- beta.10: Only this region shows on the row under the pointer or the one clicked; the header says so -->
                                    <TextBlock Grid.Column="5" Grid.ColumnSpan="2" Text="Just one region? Point at it: Only this region" Style="{StaticResource CardTitle}" Margin="0"
                                               HorizontalAlignment="Right" Foreground="{StaticResource Faint}"/>
                                </Grid>
                                <ListBox x:Name="RegionList" Grid.Row="1" ItemContainerStyle="{StaticResource ServerRowItem}" SelectionMode="Single"
                                         VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource CardTitle}" Margin="8,10,0,4">
                                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding Tip}" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="2*" MinWidth="150" MaxWidth="300"/>
                                                    <ColumnDefinition Width="2*" MinWidth="150" MaxWidth="300"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Allowed}" Click="RegionToggle_Click" VerticalAlignment="Center"
                                                          ToolTip="On: CS2 can play here. Off: cs2.exe can't reach this region's relays."/>
                                                <TextBlock Grid.Column="1" Text="{Binding City}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Country}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PingText}" Foreground="{Binding PingBrush}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"/>
                                                <!-- beta.10: the same words on 30 rows were noise; it shows on the row under the pointer (or with the keyboard on it) -->
                                                <Button Grid.Column="6" Margin="0" HorizontalAlignment="Right" Click="RegionOnly_Click" Content="Only this region"
                                                        ToolTip="Turns every other region off. Queues can get long, mostly outside peak hours.">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource RowGhost}">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="RegionsEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="RegionsEmptyTitle" Text="Loading regions…" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="RegionsEmptyText" Text="Getting the region list from Valve. A few seconds." Foreground="{StaticResource Muted}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </HeaderedContentControl>
                    </Grid>

                    <!-- ======================================== Page: Accounts -->
                    <Grid x:Name="PageAccounts" Grid.Row="1" Margin="16,0,16,6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <HeaderedContentControl Style="{StaticResource Group}" Header="Add and log in">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Left" Text="On login:" Foreground="{StaticResource Faint}" Margin="0,0,14,0" VerticalAlignment="Top"/>
                                    <WrapPanel VerticalAlignment="Center">
                                    <CheckBox x:Name="OptCs2" Style="{StaticResource Switch}" Content="Open CS2" Margin="0,0,18,0" Click="AccOpt_Click"
                                              ToolTip="After logging in, Steam opens CS2 right away. New IP + next account always opens it."/>
                                    <CheckBox x:Name="OptSilent" Style="{StaticResource Switch}" Content="Start Steam minimized" Margin="0,0,18,0" Click="AccOpt_Click"
                                              ToolTip="Steam starts in the tray, without opening its window"/>
                                    <CheckBox x:Name="OptOffline" Style="{StaticResource Switch}" Content="Offline mode" Margin="0,0,18,0" Click="AccOpt_Click"
                                              ToolTip="Steam starts in offline mode when you log in. You cannot join online servers or matchmaking while it is on."/>
                                    </WrapPanel>
                                </DockPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="AccAdd_Click" Content="Add"
                                            ToolTip="Opens the Steam login. Log in with the new account and tick 'Remember me'."/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE713;" Click="SwitchSteps_Click" Margin="0,0,6,0" ToolTip="Choose what New IP + next account does"/>
                                    <Button x:Name="QuickBtn" Margin="0" Click="Quick_Click" Content="New IP + next account"
                                            ToolTip="New IP + next account (its hotkey works in game too): new IP, next account, back to the last server."/>
                                </StackPanel>
                            </Grid>
                        </HeaderedContentControl>

                        <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Header="Accounts">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AccSearch" Tag="Search accounts" TextChanged="AccFilter_Changed" VerticalAlignment="Top"
                                             ToolTip="Name, username, SteamID, notes and tags"/>
                                    <!-- A WrapPanel: at the minimum width (1020) the filters go onto two lines instead of pushing Refresh and Show hidden off the page -->
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top">
                                        <RadioButton x:Name="FAll" Style="{StaticResource Seg}" GroupName="accf" Content="All" IsChecked="True" Checked="AccFilter_Changed"/>
                                        <RadioButton x:Name="FReady" Style="{StaticResource Seg}" GroupName="accf" Content="Ready" Checked="AccFilter_Changed"
                                                     ToolTip="Accounts New IP + next account can use now: in rotation, no cooldown, no VAC or game ban"/>
                                        <RadioButton x:Name="FFav" Style="{StaticResource Seg}" GroupName="accf" Content="Favorites" Checked="AccFilter_Changed"/>
                                        <RadioButton x:Name="FClean" Style="{StaticResource Seg}" GroupName="accf" Content="No bans" Checked="AccFilter_Changed"
                                                     ToolTip="No Steam bans. Server bans are separate."/>
                                        <RadioButton x:Name="FBan" Style="{StaticResource Seg}" GroupName="accf" Content="Banned" Checked="AccFilter_Changed"/>
                                        <RadioButton x:Name="FCool" Style="{StaticResource Seg}" GroupName="accf" Content="Cooldown" Checked="AccFilter_Changed"/>
                                        <RadioButton x:Name="FOut" Style="{StaticResource Seg}" GroupName="accf" Content="Not in rotation" Checked="AccFilter_Changed"
                                                     ToolTip="Accounts New IP + next account never picks"/>
                                        <!-- the count follows the filters; when they don't fit on one line it goes onto the next one, never cut -->
                                        <TextBlock x:Name="AccCount" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="12,0,12,0"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="AccViewBtn" Style="{StaticResource IconBtn}" Click="AccView_Click" Content="&#xE8FD;" Margin="0,0,6,0" ToolTip="Show as rows: more accounts at once"/>
                                    <ComboBox x:Name="AccSort" Width="150" SelectionChanged="AccFilter_Changed" ToolTip="Order (favorites always come first)">
                                        <ComboBoxItem Content="Most recent" Tag="recent"/>
                                        <ComboBoxItem Content="Ready first" Tag="ready" ToolTip="Ready to use, then the cooldown that ends first, banned last"/>
                                        <ComboBoxItem Content="Name" Tag="name"/>
                                        <ComboBoxItem Content="No Steam bans first" Tag="clean"/>
                                        <ComboBoxItem Content="Most CS2 hours" Tag="hours"/>
                                    </ComboBox>
                                            <Button x:Name="AccRefreshBtn" Margin="6,0,0,0" Click="AccRefresh_Click"
                                                    ToolTip="Visits each account's public profile to fetch avatar, name, bans, level and hours. One per second so Steam does not block you.">
                                                <TextBlock x:Name="AccRefreshText" Text="Refresh"/>
                                            </Button>
                                            <Button x:Name="AccUnhideBtn" Click="ShowHidden_Click" Margin="6,0,0,0" Visibility="Collapsed" Content="Show hidden" ToolTip="Shows the hidden accounts on the list, dimmed. They stay out of the rotation. Right-click one > Show in list to keep it."/>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- From 12 accounts, while no view was picked: rows show more at once (4 nov.) -->
                                        <Border x:Name="AccRowsHint" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,10,10" Visibility="Collapsed">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Click="AccView_Click" Tag="cards" Content="Keep cards" Margin="8,0,0,0"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="AccView_Click" Tag="rows" Content="Show as rows" Margin="0"/>
                                                <TextBlock Text="Many accounts? Rows put each account on one line, so bans, cooldowns and who is in rotation line up. The button next to the order switches back any time."
                                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </DockPanel>
                                        </Border>
                                        <ItemsControl x:Name="AccountsPanel" ItemTemplate="{StaticResource AccountCard}" ItemsPanel="{StaticResource AccCardsPanel}"
                                                      SizeChanged="AccountsPanel_SizeChanged" Margin="0,0,-2,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel x:Name="AccountsEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="No accounts yet" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AccountsEmptyText" Text="No saved accounts found in Steam on this PC." Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,4,0,12"/>
                                    <Button Style="{StaticResource Primary}" Click="AccAdd_Click" Content="Add account" HorizontalAlignment="Center" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </HeaderedContentControl>
                    </Grid>

                    <!-- ======================================== Page: Configs (MainWindow.Configs.cs) -->
                    <Grid x:Name="PageConfigs" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer x:Name="CfgScroll" Padding="16,0,16,6" VerticalScrollBarVisibility="Auto">
                            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <DataTemplate x:Key="CfgSourceTemplate">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="18" Height="18" Margin="0,0,8,0">
                                                <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsAccount, Converter={StaticResource Vis}}"/>
                                                        <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="9" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSnapshot, Converter={StaticResource Vis}}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Grid.Resources>

                                <!-- Left: what you do (Copy, Sync, Snapshots). Right: what you look at and undo; Backups last, like Previous IPs (docs/DESIGN.md > App layout) -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <HeaderedContentControl x:Name="CfgCopyGroup" Style="{StaticResource Group}" Header="Copy">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="From" Style="{StaticResource Key}" VerticalAlignment="Center" Margin="0"/>
                                                <ComboBox x:Name="CfgFromBox" Grid.Column="1" ItemTemplate="{StaticResource CfgSourceTemplate}" ToolTip="An account or a snapshot" SelectionChanged="CfgFrom_Changed"/>
                                            </Grid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="To" Style="{StaticResource Key}" Margin="0,6,0,0"/>
                                                <!-- beta.10: with 30 accounts the ticks were a wall. A filter, the count, and a box of even columns that scrolls -->
                                                <StackPanel Grid.Column="1">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MaxWidth="220"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="CfgToSearch" Tag="Filter accounts" TextChanged="CfgToSearch_Changed" ToolTip="Name or username. All ticks only the accounts shown."/>
                                                        <TextBlock x:Name="CfgToCount" Grid.Column="1" Style="{StaticResource OptSub}" VerticalAlignment="Center" Margin="10,0,0,0" Text="None ticked"/>
                                                    </Grid>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8,6,4,0">
                                                        <ScrollViewer MaxHeight="122" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsControl x:Name="CfgToList">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel ItemWidth="128"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Selected}" Margin="0,0,8,6" ToolTip="{Binding Name}">
                                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <DockPanel Margin="0,6,0,7">
                                                <TextBlock DockPanel.Dock="Left" Text="What to copy" Style="{StaticResource Key}" Margin="0"/>
                                                <TextBlock Text="Sync uses the same ticks." Style="{StaticResource OptSub}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                                            </DockPanel>
                                            <WrapPanel x:Name="CfgCats">
                                                <CheckBox Style="{StaticResource Switch}" Tag="binds" Content="Binds" Margin="0,0,18,8" Click="CfgCategory_Click"
                                                          ToolTip="Every key bind (cs2_user_keys)"/>
                                                <CheckBox Style="{StaticResource Switch}" Tag="crosshair" Content="Crosshair" Margin="0,0,18,8" Click="CfgCategory_Click"
                                                          ToolTip="Only the crosshair settings; the rest of the game settings stay"/>
                                                <CheckBox Style="{StaticResource Switch}" Tag="game" Content="Game settings" Margin="0,0,18,8" Click="CfgCategory_Click"
                                                          ToolTip="Sensitivity, viewmodel and the other game settings, without the crosshair (cs2_user_convars)"/>
                                                <CheckBox Style="{StaticResource Switch}" Tag="video" Content="Video" Margin="0,0,18,8" Click="CfgCategory_Click"
                                                          ToolTip="Resolution, display mode and graphics (cs2_video.txt)"/>
                                                <CheckBox Style="{StaticResource Switch}" Tag="hud" Content="HUD, radar and audio" Margin="0,0,18,8" Click="CfgCategory_Click"
                                                          ToolTip="HUD color and scale, radar, volumes, max FPS, brightness (cs2_machine_convars)"/>
                                            </WrapPanel>

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="CfgCopyHint" Style="{StaticResource OptSub}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                           Text="Each account gets a backup first (Configs > Backups)."/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button x:Name="CfgToAllBtn" Content="All" Click="CfgToAll_Click" ToolTip="Tick every other account"/>
                                                    <Button x:Name="CfgToNoneBtn" Content="None" Click="CfgToNone_Click"/>
                                                    <Button x:Name="CfgCopyBtn" Style="{StaticResource Primary}" Content="Copy" Click="CfgCopy_Click" Margin="0"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Header="Sync">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource OptSub}" Margin="0,0,0,12"
                                                       Text="Each account has its own CS2 settings (binds, crosshair, sensitivity, video). The app copies them between your accounts. It never copies while CS2 is open, and it saves a backup first."/>
                                            <RadioButton x:Name="CfgModeOff" Style="{StaticResource Choice}" GroupName="cfgmode" Tag="off" Checked="CfgMode_Checked">
                                                <StackPanel>
                                                    <TextBlock Text="Off"/>
                                                    <TextBlock Text="Nothing is copied automatically. You can still use Copy and snapshots." Style="{StaticResource OptSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="CfgModeMain" Style="{StaticResource Choice}" GroupName="cfgmode" Tag="main" Checked="CfgMode_Checked">
                                                <StackPanel>
                                                    <TextBlock Text="From a main account"/>
                                                    <TextBlock Text="New accounts and every login through the app get the main account's config." Style="{StaticResource OptSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <ComboBox x:Name="CfgMainBox" Margin="22,0,0,10" Width="260" HorizontalAlignment="Left" ItemTemplate="{StaticResource CfgSourceTemplate}"
                                                      SelectionChanged="CfgMain_Changed" ToolTip="The account the others copy from"/>
                                            <RadioButton x:Name="CfgModePrevious" Style="{StaticResource Choice}" GroupName="cfgmode" Tag="previous" Checked="CfgMode_Checked">
                                                <StackPanel>
                                                    <TextBlock Text="From the previous account"/>
                                                    <TextBlock Text="When you log in through the app, the new account gets the config of the account you were on." Style="{StaticResource OptSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="CfgModeLatest" Style="{StaticResource Choice}" GroupName="cfgmode" Tag="latest" Checked="CfgMode_Checked">
                                                <StackPanel>
                                                    <TextBlock Text="From the account changed last"/>
                                                    <TextBlock Text="When CS2 closes, the account you changed last copies its config to the others." Style="{StaticResource OptSub}"/>
                                                </StackPanel>
                                            </RadioButton>

                                            <TextBlock Text="It copies what is ticked under Copy > What to copy." Style="{StaticResource OptSub}" Margin="0,0,0,10"/>

                                            <TextBlock x:Name="CfgWhenLabel" Text="When" Style="{StaticResource Key}" Margin="0,4,0,7"/>
                                            <CheckBox x:Name="CfgOnNewBox" Style="{StaticResource Switch}" Content="A new account shows up on this PC" Margin="0,0,0,8" Click="CfgWhen_Click"/>
                                            <CheckBox x:Name="CfgOnLoginBox" Style="{StaticResource Switch}" Content="Before the app logs in or opens CS2 (Log in, New IP + next account, Join)" Click="CfgWhen_Click"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="CfgSyncNowBtn" Content="Sync now" Click="CfgSyncNow_Click"
                                                        ToolTip="Copies to every account with Sync on, from the source of the mode above"/>
                                                <Button x:Name="CfgUndoBtn" Content="Undo last sync" Click="CfgUndo_Click" Margin="0" ToolTip="Puts back the files the last sync changed"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CfgResult" Style="{StaticResource OptSub}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Grid.Row="2" Style="{StaticResource Group}" Header="Snapshots">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="From" Style="{StaticResource Key}" VerticalAlignment="Center" Margin="0"/>
                                                <ComboBox x:Name="CfgSnapFrom" Grid.Column="1" ItemTemplate="{StaticResource CfgSourceTemplate}" ToolTip="The account to save" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button x:Name="CfgSnapSaveBtn" Content="Save snapshot" Click="CfgSnapSave_Click" ToolTip="Saves this account's config under a name (Main, Practice…)"/>
                                                    <Button Content="Import" Click="CfgSnapImport_Click" Margin="0" ToolTip="A snapshot .zip exported on this or another PC"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="CfgSnapEmpty" Text="No snapshots yet. Save one to keep a config, or to take it to another PC." Style="{StaticResource Sub}"/>
                                            <ItemsControl x:Name="CfgSnapList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <DockPanel Margin="0,1,0,0">
                                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11"/>
                                                                        <TextBlock Text="{Binding What}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                                    </DockPanel>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Click="CfgSnapUse_Click" ToolTip="Copy it to accounts (picks it in Copy)"/>
                                                                    <Button Style="{StaticResource IconBtn}" Content="&#xE72D;" Click="CfgSnapExport_Click" ToolTip="Export as .zip"/>
                                                                    <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Click="CfgSnapDelete_Click" ToolTip="Delete snapshot"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <HeaderedContentControl Style="{StaticResource Group}" Header="Account configs">
                                        <StackPanel>
                                            <TextBlock x:Name="CfgAccountsEmpty" Text="No Steam accounts on this PC yet." Style="{StaticResource Sub}" Visibility="Collapsed"/>
                                            <!-- beta.10: from 8 accounts, a search; accounts with the same crosshair fold into one line (CfgDisplay) -->
                                            <Grid x:Name="CfgAccSearchHost" Margin="0,0,0,6" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MaxWidth="260"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CfgAccSearch" Tag="Search accounts" TextChanged="CfgAccSearch_Changed" ToolTip="Name or username. While you search, every match shows on its own line."/>
                                                <TextBlock x:Name="CfgAccCount" Grid.Column="1" Style="{StaticResource OptSub}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ItemsControl x:Name="CfgAccountsList">
                                                <ItemsControl.Resources>
                                                    <DataTemplate DataType="{x:Type local:CfgGroupRow}">
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="24" Height="24" Background="{StaticResource Surface3}" BorderBrush="{StaticResource Edge}" BorderThickness="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                                               Visibility="{Binding IsCrosshairGroup, Converter={StaticResource Vis}}"/>
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                                               Visibility="{Binding IsEmptyGroup, Converter={StaticResource Vis}}"/>
                                                                    <TextBlock Text="{Binding Names}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" ToolTip="{Binding Names}"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Width="28" Height="28" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                                        Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding HasCrosshair, Converter={StaticResource Vis}}">
                                                                    <Image Source="{Binding CrosshairImage}" Width="26" Height="26" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                                </Border>
                                                                <Button Grid.Column="3" Style="{StaticResource RowBtn}" Content="{Binding ToggleText}" Click="CfgGroupToggle_Click" MinWidth="58" Margin="0" VerticalAlignment="Center"
                                                                        ToolTip="Show each account of this group (Sync on or off one by one)"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                    <DataTemplate DataType="{x:Type local:CfgAccountRow}">
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                                    <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                                                        <TextBlock Text="{Binding Initial}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                                        </Border.Background>
                                                                    </Border>
                                                                </Grid>
                                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                                        <TextBlock Text="  main" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center"
                                                                                   Visibility="{Binding IsMain, Converter={StaticResource Vis}}" ToolTip="The others copy from this account"/>
                                                                        <TextBlock Text="  in use" Foreground="{StaticResource Good}" FontSize="11" VerticalAlignment="Center"
                                                                                   Visibility="{Binding Active, Converter={StaticResource Vis}}"/>
                                                                        <TextBlock Text="  waiting for CS2 to close" Foreground="{StaticResource Warn}" FontSize="11" VerticalAlignment="Center"
                                                                                   Visibility="{Binding Pending, Converter={StaticResource Vis}}"/>
                                                                    </StackPanel>
                                                                    <!-- One line under the name: the crosshair, then when it last changed -->
                                                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding ChangedText}">
                                                                        <Run Text="{Binding CrosshairText, Mode=OneWay}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}"/><Run Text="  ·  " Foreground="{StaticResource Faint}"/><Run Text="{Binding ChangedText, Mode=OneWay}" Foreground="{StaticResource Faint}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Width="28" Height="28" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                                        Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="Crosshair (approximate preview)"
                                                                        Visibility="{Binding HasCrosshair, Converter={StaticResource Vis}}">
                                                                    <Image Source="{Binding CrosshairImage}" Width="26" Height="26" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                                </Border>
                                                                <CheckBox Grid.Column="3" Style="{StaticResource Switch}" Content="Sync" IsChecked="{Binding Sync}" Click="CfgOptOut_Click" VerticalAlignment="Center"
                                                                          ToolTip="Off: the sync never touches this account's config (Copy still can)"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.Resources>
                                            </ItemsControl>
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Header="Compare">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CfgCmpA" ItemTemplate="{StaticResource CfgSourceTemplate}" SelectionChanged="CfgCompare_Changed"/>
                                                <TextBlock Grid.Column="1" Text="vs" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="10,0"/>
                                                <ComboBox x:Name="CfgCmpB" Grid.Column="2" ItemTemplate="{StaticResource CfgSourceTemplate}" SelectionChanged="CfgCompare_Changed"/>
                                            </Grid>
                                            <Grid Margin="0,10,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="Crosshair (approximate preview)">
                                                        <Image x:Name="CfgCmpImgA" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    </Border>
                                                    <TextBlock x:Name="CfgCmpXhA" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                </DockPanel>
                                                <DockPanel Grid.Column="2">
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="Crosshair (approximate preview)">
                                                        <Image x:Name="CfgCmpImgB" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    </Border>
                                                    <TextBlock x:Name="CfgCmpXhB" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                </DockPanel>
                                            </Grid>
                                            <TextBlock x:Name="CfgDiffCount" Style="{StaticResource Key}" Margin="0,4,0,6"/>
                                            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="CfgDiffList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4" ToolTip="{Binding Key}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="1.3*"/>
                                                                    <ColumnDefinition Width="1.3*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding CategoryText}" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding A}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Mono}" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding B}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Mono}" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Grid.Row="2" Style="{StaticResource Group}" Header="Backups">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource OptSub}" Margin="0,0,0,8"
                                                       Text="Saved before the app changes an account's files. The 20 newest per account are kept."/>
                                            <TextBlock x:Name="CfgBackupEmpty" Text="No backups yet." Style="{StaticResource Sub}"/>
                                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="CfgBackupList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="90"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding When}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"/>
                                                                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Account}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                                </DockPanel>
                                                                <Button Grid.Column="2" Style="{StaticResource RowBtn}" Content="Restore" Click="CfgRestore_Click" Margin="0" VerticalAlignment="Center" ToolTip="Restore these files"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ======================================== Page: Profiles (MainWindow.Profiles.cs) -->
                    <Grid x:Name="PageProfiles" Grid.Row="1" Margin="16,0,16,18" Visibility="Collapsed" Loaded="ProfilesPage_Loaded" SizeChanged="ProfBar_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.4*" MinWidth="260" MaxWidth="320"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Template -->
                        <HeaderedContentControl Style="{StaticResource Group}" Header="Template" Margin="0" Padding="14,16,6,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,8,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="TplCombo" SelectionChanged="TplCombo_Changed" ToolTip="Your saved looks"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,-6,0">
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE710;" Click="TplNew_Click" ToolTip="New template" Margin="0"/>
                                        <Button x:Name="TplCopyBtn" Style="{StaticResource IconBtn}" Content="&#xE8C8;" Click="TplCopyFrom_Click" Margin="0"
                                                ToolTip="Copy from an account or any Steam profile link: its name, picture, real name, bio and country (and privacy, if you signed in to it)"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Click="TplDelete_Click" ToolTip="Delete this template" Margin="0"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="ProfAuto" Grid.Row="2" Style="{StaticResource Switch}" Content="Use this template on new accounts" Margin="0,10,8,0" Click="ProfAuto_Click"
                                          ToolTip="When a new account shows up in Steam on this PC, the app asks you to sign in to it once and gives it this look."/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <StackPanel x:Name="TplEditor">
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="64" Height="64" VerticalAlignment="Top">
                                                <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                                    <TextBlock Text="&#xE91B;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border x:Name="TplAvatarBox" Visibility="Collapsed">
                                                    <Border.Background>
                                                        <ImageBrush x:Name="TplAvatar" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Picture" Style="{StaticResource Key}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Button Content="Pick…" Click="TplPickAvatar_Click" Padding="10,4"
                                                            ToolTip="JPG, PNG, GIF or BMP, at least 184×184. It's cropped square and saved again as a clean JPG: no photo data (EXIF, GPS) goes to Steam."/>
                                                    <Button Content="Remove" Click="TplClearAvatar_Click" Padding="10,4"/>
                                                </StackPanel>
                                                <TextBlock Text="Square, 184 px or more." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Template name" Style="{StaticResource Key}"/>
                                        <TextBox x:Name="TplTitle" Tag="E.g. Main look" TextChanged="TplField_Changed" Margin="0,0,0,10"/>
                                        <TextBlock Text="Steam name" Style="{StaticResource Key}"/>
                                        <TextBox x:Name="TplName" Tag="E.g. {name} or nightfall {n}" TextChanged="TplField_Changed"
                                                 ToolTip="{}{name} = the account's current Steam name. {n} = 1, 2, 3… in the list. Up to 32 characters. To show { or }, type {{ or }}. There is no {login} tag: showing a username on a public profile makes the account easier to steal."/>
                                        <TextBlock Text="{}{name} = current name, {n} = 1, 2, 3…"
                                                   Style="{StaticResource OptSub}" Margin="0,3,0,10"/>
                                        <TextBlock Text="Real name" Style="{StaticResource Key}"/>
                                        <TextBox x:Name="TplReal" Tag="Empty = no real name shown" TextChanged="TplField_Changed" Margin="0,0,0,10"/>
                                        <TextBlock Text="Country" Style="{StaticResource Key}"/>
                                        <ComboBox x:Name="TplCountry" SelectionChanged="TplField_Changed" Margin="0,0,0,10"/>
                                        <TextBlock Text="Bio" Style="{StaticResource Key}"/>
                                        <TextBox x:Name="TplSummary" Tag="Empty = no bio" TextChanged="TplField_Changed" Margin="0,0,0,10" Height="58"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                        <TextBlock Text="Custom URL" Style="{StaticResource Key}"/>
                                        <TextBox x:Name="TplUrl" Tag="Empty = removed, e.g. nightfall{n}" TextChanged="TplField_Changed" Margin="0,0,0,12"
                                                 ToolTip="steamcommunity.com/id/…  Each account needs its own: use {n} when you pick more than one."/>

                                        <TextBlock Text="Privacy" Style="{StaticResource Key}" Margin="0,0,0,6"/>
                                        <Grid x:Name="TplPrivacy">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Profile" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="PrivProfile" Grid.Column="1" Margin="0,0,0,4" SelectionChanged="TplField_Changed"/>
                                            <TextBlock Grid.Row="1" Text="Game details" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="PrivGames" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" SelectionChanged="TplField_Changed"/>
                                            <TextBlock Grid.Row="2" Text="Inventory" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="PrivInventory" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" SelectionChanged="TplField_Changed"/>
                                            <TextBlock Grid.Row="3" Text="Friends list" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="PrivFriends" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" SelectionChanged="TplField_Changed"/>
                                            <TextBlock Grid.Row="4" Text="Comments" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="PrivComments" Grid.Row="4" Grid.Column="1" SelectionChanged="TplField_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </HeaderedContentControl>

                        <!-- Accounts: now and after -->
                        <HeaderedContentControl Grid.Column="2" Style="{StaticResource Group}" Header="Apply to accounts" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="Change:" Foreground="{StaticResource Faint}" Margin="0,0,14,0" VerticalAlignment="Top"/>
                                    <WrapPanel VerticalAlignment="Center">
                                    <CheckBox x:Name="FName" Style="{StaticResource Switch}" Content="Name" Margin="0,0,16,0" Click="ProfField_Click"/>
                                    <CheckBox x:Name="FAvatar" Style="{StaticResource Switch}" Content="Picture" Margin="0,0,16,0" Click="ProfField_Click"/>
                                    <CheckBox x:Name="FReal" Style="{StaticResource Switch}" Content="Real name" Margin="0,0,16,0" Click="ProfField_Click"/>
                                    <CheckBox x:Name="FSummary" Style="{StaticResource Switch}" Content="Bio" Margin="0,0,16,0" Click="ProfField_Click"/>
                                    <CheckBox x:Name="FCountry" Style="{StaticResource Switch}" Content="Country" Margin="0,0,16,0" Click="ProfField_Click"/>
                                    <CheckBox x:Name="FPrivacy" Style="{StaticResource Switch}" Content="Privacy" Margin="0,0,16,0" Click="ProfField_Click"/>
                                    <CheckBox x:Name="FUrl" Style="{StaticResource Switch}" Content="Custom URL" Margin="0,0,16,0" Click="ProfField_Click"/>
                                    </WrapPanel>
                                </DockPanel>

                                <!-- Make all look like goes under the picks when the two don't fit on one line (ProfBar_SizeChanged) -->
                                <Grid x:Name="ProfBar" Grid.Row="1" Margin="0,0,0,8" SizeChanged="ProfBar_SizeChanged">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="ProfBarLeft" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="ProfBar_SizeChanged">
                                        <TextBlock Text="Pick:" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource Ghost}" Content="All" Padding="8,3" Click="ProfSelAll_Click"/>
                                        <Button Style="{StaticResource Ghost}" Content="Signed in" Padding="8,3" Click="ProfSelSigned_Click" ToolTip="Pick only the accounts the app can change now"/>
                                        <Button Style="{StaticResource Ghost}" Content="None" Padding="8,3" Click="ProfSelNone_Click"/>
                                        <TextBlock x:Name="ProfCount" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="8,0,16,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ProfBarRight" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="ProfBar_SizeChanged">
                                        <TextBlock Text="Make the others look like" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="IdentSource" Width="140" ToolTip="The account whose look the others get"/>
                                        <Button x:Name="ProfIdentBtn" Content="Preview" Click="ProfIdentical_Click" Margin="6,0,0,0"
                                                ToolTip="Copies that account's name, picture, real name, bio and country (and privacy, if you signed in to it) into a new template (&quot;Look of …&quot;), picks every other account and shows the preview. Nothing changes until you click Apply."/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- Same columns as the rows; the right margin follows the list's scrollbar (ProfScroll_Changed) -->
                                    <Grid x:Name="ProfHeader" Margin="9,0,9,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="2*" MinWidth="110" MaxWidth="200"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="2*" MinWidth="110" MaxWidth="200"/>
                                            <ColumnDefinition Width="*" MinWidth="100"/>
                                            <ColumnDefinition Width="190"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="Now" Style="{StaticResource CardTitle}" Margin="0"/>
                                        <TextBlock Grid.Column="3" Text="After" Style="{StaticResource CardTitle}" Margin="0"/>
                                        <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource CardTitle}" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="5" Text="Web sign-in" Style="{StaticResource CardTitle}" Margin="0"
                                                   ToolTip="Lets the app edit this profile on Steam's website. It is separate from logging in to Steam on this PC (Accounts), so an account can be logged in there and still say Not signed in here."/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" ScrollChanged="ProfScroll_Changed">
                                        <ItemsControl x:Name="ProfList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Surface3}"/></Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{Binding SignInText}" Tag="&#xE8D7;" Click="ProfSignIn_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="Restore original" Tag="&#xE7A7;" Click="ProfRestoreOriginal_Click"/>
                                                                <MenuItem Header="Undo the last change" Tag="&#xE7A7;" Click="ProfUndoLast_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="Copy its look into the template" Tag="&#xE8C8;" Click="ProfCopyInto_Click"/>
                                                                <MenuItem Header="Make the others look like this" Tag="&#xE8B9;" Click="ProfMakeLikeThis_Click"/>
                                                                <MenuItem Header="Open Steam's edit page" Tag="&#xE8A7;" Click="ProfOpenEdit_Click"
                                                                          ToolTip="Opens the profile edit page in your browser, for anything the app doesn't change"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="2*" MinWidth="110" MaxWidth="200"/>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="2*" MinWidth="110" MaxWidth="200"/>
                                                                <ColumnDefinition Width="*" MinWidth="100"/>
                                                                <ColumnDefinition Width="190"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Selected}" Click="ProfRowCheck_Click" VerticalAlignment="Center"/>
                                                            <DockPanel Grid.Column="1">
                                                                <Grid Width="28" Height="28">
                                                                    <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                                                        <TextBlock Text="{Binding Initial}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                                                                        <Border.Background><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Border.Background>
                                                                    </Border>
                                                                </Grid>
                                                                <StackPanel Margin="9,0,8,0" VerticalAlignment="Center" MaxWidth="150" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding NowDetail}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding HasNowDetail, Converter={StaticResource Vis}}"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <TextBlock Grid.Column="2" Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                                                       Visibility="{Binding Selected, Converter={StaticResource Vis}}"/>
                                                            <TextBlock Grid.Column="3" Text="Not picked: stays as it is" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding NotSelected, Converter={StaticResource Vis}}"/>
                                                            <DockPanel Grid.Column="3" Visibility="{Binding Selected, Converter={StaticResource Vis}}">
                                                                <Grid Width="28" Height="28">
                                                                    <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                                                        <TextBlock Text="{Binding AfterInitial}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Visibility="{Binding HasAfterAvatar, Converter={StaticResource Vis}}">
                                                                        <Border.Background><ImageBrush ImageSource="{Binding AfterAvatar}" Stretch="UniformToFill"/></Border.Background>
                                                                    </Border>
                                                                </Grid>
                                                                <StackPanel Margin="9,0,8,0" VerticalAlignment="Center" MaxWidth="150" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding After}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Accent}"/>
                                                                    <TextBlock Text="{Binding AfterDetail}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding AfterDetail}"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="8,0,8,0"
                                                                       TextWrapping="Wrap" LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="32" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusText}"/>
                                                            <DockPanel Grid.Column="5" VerticalAlignment="Center">
                                                                <!-- beta.10: the sign-in line and its button in one place. Signed in: the line ("Signed in · 187 d left", grey,
                                                                     amber when it runs out soon), and on the row under the pointer the line turns into Sign out. Not signed in:
                                                                     the line and Sign in, always in view (it is something to do). -->
                                                                <Button DockPanel.Dock="Right" Content="{Binding SignInText}" Click="ProfSignIn_Click" Margin="0"
                                                                        ToolTip="{Binding SignInTip}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource RowBtn}">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding SignedIn}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="False"/>
                                                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <TextBlock Text="{Binding Session}" Foreground="{Binding SessionBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding SignedIn}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </MultiDataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding SignedIn}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel x:Name="ProfEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="No accounts yet" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Accounts saved in Steam on this PC show up here." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Content="Sign out of all" Click="ProfForgetAll_Click"
                                                ToolTip="Deletes every sign-in the app saved. To end them on Steam's side too: Steam > Settings > Security > Authorized devices (they're named CS2 IP Changer)."/>
                                        <Button x:Name="ProfRestoreBtn" Content="Restore originals" Margin="0" Click="ProfRestoreSelected_Click"
                                                ToolTip="Puts the picked accounts back to how they were before the app first changed them"/>
                                    </WrapPanel>
                                    <!-- The one option that can't be undone sits next to Apply, and unticks itself after every Apply -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Width="1" Background="{StaticResource Line}" Margin="10,4,14,4"/>
                                        <CheckBox x:Name="ProfClearNames" Style="{StaticResource Switch}" Content="Clear name history (can't undo)" Foreground="{StaticResource Warn}" Click="ProfField_Click"
                                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                                  ToolTip="Empties the &quot;previously known as&quot; list on each profile you apply. Permanent: Steam has no way to bring the old names back, and the app can't either. Unticks itself after every Apply."/>
                                        <Button x:Name="ProfApplyBtn" Style="{StaticResource Primary}" Content="Apply" Margin="0" Click="ProfApply_Click"
                                                ToolTip="Changes the picked accounts one after another, with a pause between them. A copy of each profile is kept first, for undo."/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </HeaderedContentControl>
                    </Grid>

                    <!-- ======================================== Page: Log -->
                    <HeaderedContentControl x:Name="PageLog" Grid.Row="1" Margin="16,0,16,18" Style="{StaticResource Group}" Header="Log" Padding="6,14,6,6" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- beta.10: with 600 lines, what failed was hard to find: a filter by kind and a search -->
                            <Grid Margin="8,0,8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LogSearch" Tag="Search the Log" TextChanged="LogFilter_Changed" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <RadioButton x:Name="LogAll" Style="{StaticResource Seg}" GroupName="logf" Content="All" IsChecked="True" Checked="LogFilter_Changed"/>
                                    <RadioButton x:Name="LogWarn" Style="{StaticResource Seg}" GroupName="logf" Content="Warnings and errors" Checked="LogFilter_Changed"/>
                                    <RadioButton x:Name="LogErr" Style="{StaticResource Seg}" GroupName="logf" Content="Errors" Checked="LogFilter_Changed"/>
                                </StackPanel>
                                <TextBlock x:Name="LogCount" Grid.Column="2" Foreground="{StaticResource Faint}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid x:Name="LogTools" Grid.Row="1" Margin="8,0,8,10" Visibility="Collapsed"/>
                            <ListBox x:Name="LogList" Grid.Row="2" ItemContainerStyle="{StaticResource RowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <local:StatusMark HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0">
                                                <local:StatusMark.Style>
                                                    <Style TargetType="local:StatusMark">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Brush" Value="{StaticResource Good}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Brush" Value="{StaticResource Warn}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Brush" Value="{StaticResource Bad}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:StatusMark.Style>
                                            </local:StatusMark>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11" Margin="0,1,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Shown}" TextWrapping="Wrap" Tag="{Binding Level}" MaxWidth="900" HorizontalAlignment="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Info"><Setter Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,8,8,2">
                                <Button Click="LogCopy_Click" Content="Copy all" ToolTip="Copies the log so you can paste it where you need it (e.g. to ask for help)"/>
                                <Button Click="AppChanges_Click" Content="What the app changed"
                                        ToolTip="The Firewall rules, routes and blocked IPs the app made in Windows now, and the command that undoes them"/>
                                <Button Click="ExportReport_Click" Content="Save bug report"
                                        ToolTip="Saves a .zip on the Desktop to attach to a bug report: this log, the app's settings and rules, Steam's connection log and CS2's console. Your home IP and API key are left out."/>
                                <Button Click="ReportProblem_Click" Content="Report a problem"
                                        ToolTip="Opens a new issue on GitHub with the app and Windows versions filled in. Nothing is sent until you press Submit there."/>
                                <Button Click="LogClear_Click" Margin="0" Content="Clear screen" ToolTip="Clears this list. The log file stays in SRT_Dados."/>
                            </StackPanel>
                        </Grid>
                    </HeaderedContentControl>

                    <!-- ======================================== Page: Settings -->
                    <ScrollViewer x:Name="PageSettings" Grid.Row="1" Padding="16,0,16,6" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Settings (docs/DESIGN.md > App layout). Left: how you play (protection, mobile data, the IP, the commands and their keys). Right: what is around the game (programs, flags, Steam), then the app; Remove last -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <HeaderedContentControl Style="{StaticResource Group}" Header="Protection">
                                    <StackPanel x:Name="ProtectionOptions">
                                        <CheckBox x:Name="LockCs2Box" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,0,0,12"
                                                  ToolTip="CS2 game traffic only goes through the phone. If the phone disconnects, CS2 goes offline instead of using your home network. Web content that CS2 or its add-ons load still uses your normal connection.">
                                            <StackPanel>
                                                <TextBlock Text="CS2 only through the phone"/>
                                                <TextBlock Text="If the phone disconnects, CS2 goes offline instead of using your home network." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SteamEgressBox" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Steam through the phone"/>
                                                <TextBlock Text="Avoids the 'No Steam logon' kick. Steam downloads also use mobile data." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <!-- beta.11: features without protection, only when you choose it (a warning when you turn it on) -->
                                        <CheckBox x:Name="UseOffBox" Style="{StaticResource Switch}" Click="UseOff_Click" Margin="0,0,0,12"
                                                  ToolTip="Off (the default): with protection off, Servers, Join and Log in with CS2 wait for protection. On: they work on your home connection and nothing is blocked, so servers see your home IP. Turn on protection whenever you want to play through the phone.">
                                            <StackPanel>
                                                <TextBlock Text="Use the app with protection off"/>
                                                <TextBlock Text="Servers, Join and Log in work on your home connection. Servers see your home IP." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <!-- beta.10: when protection turns on and off by itself, apart from what it does -->
                                        <TextBlock Text="Start and close" Style="{StaticResource Key}" Margin="0,4,0,8"/>
                                        <CheckBox x:Name="ProtectOnStartBox" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,0,0,12"
                                                  ToolTip="Off (the default): the app always starts with protection off and you turn it on in Status or the tray icon. On: it turns on by itself at every start, also with Windows. With no phone connected, your servers and CS2 stay blocked until it is.">
                                            <StackPanel>
                                                <TextBlock Text="Turn on protection when the app starts"/>
                                                <TextBlock Text="Also with Windows. Without the phone, your servers and CS2 stay blocked until you connect it." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="CleanupBox" Style="{StaticResource Switch}" Click="SettingChanged"
                                                  ToolTip="Off: the block stays on after you close the app, so CS2 stays locked to the phone. The first time you close the app with protection on, it asks you and sets this from your answer. Regions you turned off stay off either way.">
                                            <StackPanel>
                                                <TextBlock Text="Turn off protection when closing the app"/>
                                                <TextBlock Text="Off: the block stays on after you close the app. Regions you turned off stay off." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Header="Mobile data">
                                    <StackPanel>
                                        <CheckBox x:Name="KeepOffBox" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Save mobile data"/>
                                                <TextBlock Text="In 'Game only' and 'No phone', stops Windows from moving the whole PC onto the phone." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="AutoModeBox" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,0,0,12"
                                                  ToolTip="When the mobile connection is weak, the app changes Whole PC to Game only, so the rest of your PC stops sharing the phone with CS2. It changes back when the connection is good and CS2 is closed. You always get a message.">
                                            <StackPanel>
                                                <TextBlock Text="Fall back to Game only on a weak connection"/>
                                                <TextBlock Text="So the rest of the PC stops sharing a weak phone connection with CS2." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Text="Warn me after (GB a month, 0 = off)" Style="{StaticResource Key}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="DataWarnBox" Width="90" HorizontalAlignment="Left" Height="28" VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" LostFocus="DataWarn_Changed"
                                                 ToolTip="The app counts what goes through the phone's adapter (shown under Phone on the Connection page) and warns once a month when it passes this."/>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Grid.Row="2" Style="{StaticResource Group}" Header="Change IP">
                                    <StackPanel>
                                    <Grid MaxWidth="560" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Method" Style="{StaticResource Key}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="MethodCombo" SelectionChanged="SettingChanged"
                                                      ToolTip="Mobile data: turns off data only. Airplane mode: the carrier almost always gives a new IP, but some phones drop USB tethering.">
                                                <ComboBoxItem Content="Turn mobile data off and on" Tag="data"/>
                                                <ComboBoxItem Content="Airplane mode" Tag="airplane"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Data off (s)" Style="{StaticResource Key}" Margin="0,0,0,5" ToolTip="How long data stays off on each attempt"/>
                                            <TextBox x:Name="OffSecondsBox" Height="28" VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" LostFocus="SettingChanged"
                                                     ToolTip="How long data stays off. 4 to 10 s is normal."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Attempts" Style="{StaticResource Key}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="AttemptsBox" Height="28" VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" LostFocus="SettingChanged"
                                                     ToolTip="If the carrier returns the same IP, the app retries up to this many times."/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="New16Box" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Keep changing until the IP is in a new range"/>
                                            <TextBlock Text="Many admins ban a whole range (the first two numbers of the IP, like 198.51.x.x). Uses the attempts above." Style="{StaticResource OptSub}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="GoodLinkBox" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,12,0,0"
                                              ToolTip="On mobile data the lag in CS2 is mostly jitter: the ping is fine, but your moves reach the server late. Mobile data off and on keeps the phone on the same cell, so each change again uses airplane mode (not on the hotspot), and the phone looks for the network again: it can land on another cell. After each new IP the app pings for about 2 s, as in Checks > Connection quality, and changes again when jitter is 20 ms or more (or 2 of the 10 pings are lost), 3 more changes at most, on top of the attempts. Each check adds 5 to 15 s to Change IP.">
                                        <StackPanel>
                                            <TextBlock Text="Keep changing until the connection is good"/>
                                            <TextBlock Text="Changes again while jitter is 20 ms or more: up to 3 more changes than the attempts above." Style="{StaticResource OptSub}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>
                                <HeaderedContentControl x:Name="SwitchGroup" Grid.Row="3" Style="{StaticResource Group}" Header="New IP + next account">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptSub}" Margin="0,0,0,12" Background="Transparent"
                                                   ToolTip="The steps ticked under Steps, in order. Both hotkeys work in game. The Change IP and rejoin hotkey is separate: it changes the IP and rejoins with the same account, or with the next one if that account is banned on the last server."
                                                   Text="What the New IP + next account button and hotkey do, in order."/>
                                        <CheckBox x:Name="SwIpBox" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Change the IP"/>
                                                <TextBlock Text="Like the Change IP button. If the phone isn't ready, only the account changes." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SwAccountBox" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,0,0,12"
                                                  ToolTip="The account you used longest ago, never the current one. Accounts not in rotation, banned or on cooldown are left out. With Rejoin the last server on, so are accounts banned on that server or its community.">
                                            <StackPanel>
                                                <TextBlock Text="Log in to the next account"/>
                                                <TextBlock Text="The account you used longest ago that is in rotation, not banned and not on cooldown." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SwRejoinBox" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Rejoin the last server"/>
                                                <TextBlock Text="Only joins when protection is confirmed. If off, CS2 opens in the main menu." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SwOpenWithBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="Open your CS2 programs"/>
                                                <TextBlock Text="The programs listed under Open with CS2. Only when this command opens CS2." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Grid.Row="4" Style="{StaticResource Group}" Header="Hotkeys and sounds">
                                    <StackPanel>
                                        <Grid MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="New IP + next account hotkey" Style="{StaticResource Key}" Margin="0,0,0,5"/>
                                                <TextBox x:Name="HotkeySwitchBox" Height="28" VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"
                                                         ToolTip="Click here and press the keys. Escape puts back Ctrl+Shift+F9."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Change IP and rejoin hotkey" Style="{StaticResource Key}" Margin="0,0,0,5"/>
                                                <TextBox x:Name="HotkeyRejoinBox" Height="28" VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"
                                                         ToolTip="Click here and press the keys. Escape puts back Ctrl+Shift+F10."/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource OptSub}" TextWrapping="Wrap" Margin="0,0,0,12"
                                                   Text="Press the keys you want. Avoid Ctrl+Alt: on many keyboards it is AltGr, which types @ and €."/>
                                        <CheckBox x:Name="SoundsBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="Sounds for commands"/>
                                                <TextBlock Text="A short sound when a hotkey or button starts something, and another when it ends or fails. You hear them in game." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>

                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <HeaderedContentControl Style="{StaticResource Group}" Header="Open with CS2">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptSub}" TextWrapping="Wrap" Margin="0,0,0,10" Background="Transparent"
                                                   ToolTip="Like Discord, Spotify or a stats tracker. They open as you, without the app's admin rights, and only if they aren't running yet."
                                                   Text="Programs that open when the app opens CS2, if they aren't running yet."/>
                                        <ItemsControl x:Name="OpenWithList" MaxWidth="620" HorizontalAlignment="Left">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Click="OpenWithToggle_Click" ToolTip="{Binding Path}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"/>
                                                                <TextBlock Text="{Binding Path}" Style="{StaticResource OptSub}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AsAdmin}" Click="OpenWithToggle_Click" VerticalAlignment="Top" Margin="16,0,8,0"
                                                                  ToolTip="Opens it with Run as administrator: Windows asks first (UAC). For programs that only work as admin.">
                                                            <TextBlock Text="As admin"/>
                                                        </CheckBox>
                                                        <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" Click="OpenWithRemove_Click" ToolTip="Remove" VerticalAlignment="Top"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button HorizontalAlignment="Left" Margin="0,2,0,0" Content="Add program" Click="OpenWithAdd_Click" ToolTip="Pick an .exe file"/>
                                    </StackPanel>
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Header="Player flags">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptSub}" TextWrapping="Wrap" Margin="0,0,0,10" Background="Transparent"
                                                   ToolTip="Servers only show player names. A flag with only a name marks anyone who uses that name. With the player's Steam profile the flag stays on them after a name change, and it can show which server they are on if their game details are public. A Steam Web API key makes this check faster."
                                                   Text="A flag with only a name marks anyone who uses that name. Add their Steam profile to keep it after a name change."/>
                                        <TextBlock x:Name="FlagsEmpty" Text="No flags yet. Right-click a player in Servers, or add one by profile link." Style="{StaticResource Sub}" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="FlagList" MaxWidth="620" HorizontalAlignment="Left">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="1" Click="FlagEdit_Click" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Colour: click to change it">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" Padding="0,4">
                                                                        <Border x:Name="sw" Width="16" Height="8" Background="{Binding Brush}" BorderBrush="{StaticResource Edge}" BorderThickness="1"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="sw" Property="BorderBrush" Value="{StaticResource Text}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" Content="Follow" IsChecked="{Binding Follow}" Click="FlagFollow_Click" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                  ToolTip="Tells you when this player shows up on another server in your list"/>
                                                        <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#xE70F;" Click="FlagEdit_Click" ToolTip="Edit"/>
                                                        <Button Grid.Column="4" Style="{StaticResource IconBtn}" Content="&#xE74D;" Click="FlagRemove_Click" ToolTip="Remove flag"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button HorizontalAlignment="Left" Margin="0,2,0,12" Content="Add by profile link" Click="FlagAdd_Click"
                                                ToolTip="Paste a steamcommunity.com link or a SteamID64"/>
                                        <CheckBox x:Name="AutoJoinBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="Join automatically when a followed player moves"/>
                                                <TextBlock Text="Only while CS2 is open, and the app always asks first. It never opens CS2 or joins by itself." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>
                                <HeaderedContentControl Grid.Row="2" Style="{StaticResource Group}" Header="Steam">
                                    <StackPanel>
                                        <TextBlock Text="Steam Web API key (optional)"/>
                                        <TextBlock Text="With it, bans come from the official API. It stays on this PC, encrypted for your Windows user." Style="{StaticResource OptSub}" Margin="0,1,0,8"/>
                                        <TextBlock x:Name="ApiKeyLostText" Visibility="Collapsed" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="The saved key was encrypted by another Windows user or on another PC, so it can't be read here. Paste it again."/>
                                        <Grid MaxWidth="560" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="200"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="ApiKeyPwd" Height="28" VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" LostFocus="SettingChanged"
                                                         ToolTip="Works without a key too. Hidden so it doesn't show on stream or in screenshots."/>
                                            <TextBox x:Name="ApiKeyBox" Height="28" VerticalContentAlignment="Center" FontFamily="{StaticResource Mono}" LostFocus="SettingChanged" Tag="Works without a key too" Visibility="Collapsed"/>
                                            <Button x:Name="ApiKeyShowBtn" Grid.Column="1" Margin="6,0,0,0" Click="ApiKeyShow_Click" Content="Show" ToolTipService.ShowOnDisabled="True" ToolTip="Shows the key"/>
                                            <Button Grid.Column="2" Margin="6,0,0,0" Click="ApiKeyLink_Click" Content="Get key" ToolTip="Opens steamcommunity.com/dev/apikey"/>
                                        </Grid>
                                        <CheckBox x:Name="LaunchOptsBox" Style="{StaticResource Switch}" Click="SettingChanged" Margin="0,12,0,0"
                                                  ToolTip="Adds -condebug -conclearlog to CS2's launch options (Steam > CS2 > Properties) of every account on this PC. What you already have there stays. Only while Steam is closed: Steam would overwrite it otherwise. A backup of each file goes to SRT_Dados\launch-options.">
                                            <StackPanel>
                                                <TextBlock Text="See kicks and bans when Steam opens CS2"/>
                                                <TextBlock Text="CS2 only writes its console log with -condebug. The app adds it to CS2's launch options while Steam is closed, and keeps what you have there." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel Orientation="Horizontal" Margin="44,6,0,0">
                                            <Button x:Name="LaunchOptsBtn" Content="Add to CS2's launch options now" Click="LaunchOpts_Click"
                                                    ToolTip="Closes Steam if it is open (it asks first), adds the two options to every account, and opens Steam again."/>
                                            <TextBlock x:Name="LaunchOptsText" Style="{StaticResource OptSub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Grid.Row="3" Style="{StaticResource Group}" Header="Privacy">
                                    <StackPanel>
                                        <CheckBox x:Name="OptStreamer" Style="{StaticResource Switch}" Click="AccOpt_Click" Margin="0,0,0,12"
                                                  ToolTip="For streams: hides usernames, your home IP in the Log page and the Steam API key">
                                            <StackPanel>
                                                <TextBlock Text="Hide usernames"/>
                                                <TextBlock Text="Also your home IP on the Log page and the Steam API key. For streams." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="AutoStreamerBox" Style="{StaticResource Switch}" Click="AutoStreamer_Click" Margin="0,0,0,12"
                                                  ToolTip="While OBS Studio or Streamlabs is running, the app hides usernames, your home IP in the Log page and the API key, as Hide usernames does. They show again when it closes.">
                                            <StackPanel>
                                                <TextBlock Text="Hide usernames while OBS or Streamlabs is open"/>
                                                <TextBlock Text="So a login or your home IP never ends up on a stream." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <!-- Telemetry (beta): required, accepted once before the app opens (App.StatsGate), README > Telemetry -->
                                        <TextBlock Style="{StaticResource OptSub}" TextWrapping="Wrap" Margin="0" Background="Transparent"
                                                   Text="Usage stats, required while the app is in beta, with a random ID made for this install, with no name (never from your PC or you). Never IPs, servers, accounts or names."
                                                   ToolTip="Sent: the app and Windows versions, your country as two letters, the mode, how the phone is connected, minutes open, how often each button and hotkey is used, a few counters, how long your lists are, and errors as their type and place in the code. Details in the README, under Telemetry."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Click="DeleteStats_Click" Margin="0,0,6,0" HorizontalAlignment="Left" Content="Delete my stats"
                                                    ToolTip="Deletes everything the stats server keeps under this install's ID, then the app starts over with a new ID."/>
                                            <Button Click="DeleteLogs_Click" Content="Delete log files" ToolTip="Deletes the log files in SRT_Dados (they hold your home IP, Steam names and servers). The log keeps about 14 days on its own."/>
                                        </StackPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Grid.Row="4" Style="{StaticResource Group}" Header="App">
                                    <StackPanel>
                                        <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource Switch}" Click="StartWithWindows_Click" Margin="0,0,0,12" ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="A scheduled task named 'CS2 IP Changer' opens the app in the notification area when you sign in, with its admin rights and without the UAC prompt each time. Protection starts off, unless Settings > Protection > Turn on protection when the app starts is on. Only for the copy installed in C:\Program Files\CS2 IP Changer. Turning this off, Remove everything and --restore delete the task.">
                                            <StackPanel>
                                                <TextBlock Text="Start with Windows"/>
                                                <TextBlock Text="Opens in the notification area when you sign in. Protection starts as set in Settings > Protection." Style="{StaticResource OptSub}"/>
                                                <TextBlock x:Name="AutostartHint" Visibility="Collapsed" Style="{StaticResource OptSub}" Foreground="{StaticResource Warn}"
                                                           Text="Only for the installed copy: start the app from Downloads and click Install."/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="CloseToTrayBox" Style="{StaticResource Switch}" Click="CloseToTray_Click" Margin="0,0,0,12"
                                                  ToolTip="The X hides the window and the app keeps running in the notification area (next to the clock). Click the icon to open it; right-click it for its menu, Quit included.">
                                            <StackPanel>
                                                <TextBlock Text="Close to the notification area"/>
                                                <TextBlock Text="The X hides the window. Quit is in the icon's menu." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="CheckUpdatesBox" Style="{StaticResource Switch}" Click="CheckUpdates_Click">
                                            <StackPanel>
                                                <TextBlock Text="Check for updates"/>
                                                <TextBlock Text="Once a day, on GitHub. Nothing installs without your OK and a matching SHA-256." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Grid.Row="5" Style="{StaticResource Group}" Header="Maintenance">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="OpenData_Click" Margin="0,0,6,0" Content="Open data folder" ToolTip="Opens the SRT_Dados folder, next to the .exe"/>
                                        <Button Click="OpenFirewall_Click" Margin="0" Content="Open Windows Firewall" ToolTip="The app's rules are under Outbound Rules, named 'ServerRouteTool'."/>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Grid.Row="6" Style="{StaticResource Group}" Header="Remove the app">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptSub}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Text="Removes the rules, routes and task the app made, then the app itself. You choose whether your settings and accounts stay."/>
                                        <Button Style="{StaticResource Danger}" HorizontalAlignment="Left" Click="RemoveAll_Click" Content="Remove CS2 IP Changer"
                                                ToolTip="Asks first. Also in Windows Settings > Apps > Installed apps, for the copy in C:\Program Files\CS2 IP Changer."/>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- Toast -->
                    <Border x:Name="ToastBox" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" MaxWidth="420"
                            Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Visibility="Collapsed" Opacity="0">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <DockPanel>
                                <Border x:Name="ToastStrip" DockPanel.Dock="Top" Height="2" Background="{StaticResource TopLine}"/>
                                <StackPanel Orientation="Horizontal" Margin="12,9,12,10">
                                    <TextBlock x:Name="ToastIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Good}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="360"/>
                                        <!-- beta.11: a toast can carry one action (Add a server you just joined) -->
                                        <Button x:Name="ToastActionBtn" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,3"
                                                Visibility="Collapsed" Click="ToastAction_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Border>

                </Grid>
            </Grid>

            <!-- Dialog -->
            <!-- beta.10: Phone setup as steps that check themselves (PhoneSetup.Steps), each with its button when the app can do it -->
            <Grid x:Name="SetupPane" Grid.Row="1" Background="#B0000000" Visibility="Collapsed">
                <HeaderedContentControl Style="{StaticResource DialogGroup}" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,20,18,16">
                    <HeaderedContentControl.Header>
                        <TextBlock Text="Phone setup"/>
                    </HeaderedContentControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="SetupSummary" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Updates by itself. Do the red step and it turns green."/>
                        <ItemsControl x:Name="SetupSteps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8" Background="{Binding RowBack}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Top" Margin="4,4,0,0">
                                                <local:StatusMark Brush="{Binding Brush}" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding TitleBrush}" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{Binding DetailBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Top"
                                                       Visibility="{Binding DetailVisibility}"/>
                                            <Button Grid.Column="3" Style="{StaticResource Primary}" Content="{Binding Action}" Click="SetupAction_Click" Margin="0" MinWidth="86" VerticalAlignment="Top"
                                                    Visibility="{Binding HasAction, Converter={StaticResource Vis}}" IsEnabled="{Binding Idle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SetupFoot" Style="{StaticResource OptSub}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="SetupCloseBtn" Grid.Column="1" Content="Close" Click="SetupClose_Click" Margin="0"/>
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>
            </Grid>
            <!-- Below the top bar (4 nov.): its Cancel stops the command that asked, so the question never hides the way out -->
            <Grid x:Name="Dialog" Grid.Row="1" Margin="0,44,0,0" Background="#B0000000" Visibility="Collapsed" MouseLeftButtonDown="DialogBackdrop_MouseDown">
                <Grid Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <HeaderedContentControl Style="{StaticResource DialogGroup}" Padding="18,20,18,16">
                    <HeaderedContentControl.Header>
                        <TextBlock x:Name="DialogTitle"/>
                    </HeaderedContentControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="DialogText" Style="{StaticResource Sub}" LineHeight="19"/>
                        <StackPanel x:Name="DialogChoices" Margin="0,14,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="DialogLabel1" Style="{StaticResource Key}" Margin="0,14,0,4" Visibility="Collapsed"/>
                        <TextBox x:Name="DialogInput" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="DialogLabel2" Style="{StaticResource Key}" Margin="0,10,0,4" Visibility="Collapsed"/>
                        <TextBox x:Name="DialogInput2" Margin="0,0,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="DialogColorLabel" Text="Color" Style="{StaticResource Key}" Margin="0,10,0,4" Visibility="Collapsed"/>
                        <WrapPanel x:Name="DialogColors" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button x:Name="DialogCancel" Content="Cancel" Click="DialogCancel_Click"/>
                            <Button x:Name="DialogOk" Style="{StaticResource Primary}" Content="Continue" Margin="0" Click="DialogOk_Click"/>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>
                <!-- Every question has a way out that does neither (like Esc): the X, or a click outside the box -->
                <Button x:Name="DialogClose" Style="{StaticResource Chrome}" Width="34" Height="30" FontSize="10" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,9,1,0" Click="DialogClose_Click" ToolTip="Close without choosing (Esc)" AutomationProperties.Name="Close"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

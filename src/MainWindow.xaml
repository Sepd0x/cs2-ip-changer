<Window x:Class="SRT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SRT"
        Title="Pickroute" Width="1240" Height="800" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <!-- Tag, Key and OptSub live in Theme.xaml (shared with the Steam sign-in window) -->

        <!-- Account card -->
        <!-- Accounts: the right-click menu of a card and of a row -->
        <ContextMenu x:Key="AccMenu" x:Shared="False">
                <MenuItem Header="Log in to this account" Tag="&#xE8AB;" Click="AccSwitch_Click"/>
                <MenuItem Header="Log in and open CS2" Tag="&#xE768;" Click="AccSwitchCs2_Click"/>
                <MenuItem Header="Copy config to…" Tag="&#xE8C8;" Click="AccCfgCopy_Click"/>
                <MenuItem Header="Use as main config" Tag="&#xE8F1;" Click="AccCfgMain_Click"/>
                <Separator/>
                <MenuItem Header="Open Steam profile" Tag="&#xE8A7;" Click="AccProfile_Click"/>
                <MenuItem Header="Open in Leetify" Tag="&#xE9D9;" Click="AccLeetify_Click"/>
                <MenuItem Header="Open in csstats.gg" Tag="&#xE9D2;" Click="AccCsstats_Click"/>
                <MenuItem Header="Copy SteamID64" Tag="&#xE8C8;" Click="AccCopyId_Click"/>
                <MenuItem Header="Copy CS2 friend code" Tag="&#xE8C8;" Click="AccCopyFriendCode_Click"/>
                <MenuItem Header="Copy username" Tag="&#xE8C8;" Click="AccCopyLogin_Click"/>
                <MenuItem Header="Change profile…" Tag="&#xE77B;" Click="AccChangeProfile_Click"/>
                <MenuItem Header="Copy look to…" Tag="&#xE8B9;" Click="AccCopyLook_Click"/>
                <Separator/>
                <MenuItem Header="Cooldown: 21 hours" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="1260"/>
                <MenuItem Header="Cooldown: 3 days (72 h)" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="4320"/>
                <MenuItem Header="Cooldown: 7 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="10080"/>
                <MenuItem Header="Cooldown: 14 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="20160"/>
                <MenuItem Header="Cooldown: 31 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="44640"/>
                <MenuItem Header="Cooldown: 45 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="64800"/>
                <MenuItem Header="Cooldown: 181 days" Tag="&#xE916;" Click="AccCooldown_Click" CommandParameter="260640"/>
                <MenuItem Header="Custom cooldown…" Tag="&#xE70F;" Click="AccCooldown_Click" CommandParameter="-1"/>
                <MenuItem Header="Clear cooldown" Tag="&#xE711;" Click="AccCooldown_Click" CommandParameter="0"/>
                <MenuItem Header="Clear server bans" Tag="&#xE711;" Click="AccClearBans_Click" IsEnabled="{Binding HasServerBans}"/>
                <Separator/>
                <MenuItem Header="{Binding QuickMenuText}" Tag="&#xE8AB;" Click="AccToggleQuick_Click"/>
                <MenuItem Header="Favorite (yes/no)" Tag="&#xE734;" Click="AccFav_Click"/>
                <MenuItem Header="Note and tags…" Tag="&#xE70F;" Click="AccNote_Click"/>
                <MenuItem Header="Refresh this one" Tag="&#xE72C;" Click="AccRefreshOne_Click"/>
                <MenuItem Header="{Binding HideMenuText}" Tag="&#xED1A;" Click="AccHide_Click"/>
            </ContextMenu>

        <!-- 26 Nov (App v3 design "Accounts"): the star in Text when it is a favorite, RouteOff when not -->
        <Style x:Key="AccStar" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource RouteOff}"/>
            <Setter Property="ToolTip" Value="Favorite: stays at the top"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Log in: a 28 px pill; filled in the accent only on the card under the pointer; "In use", off, on the account in use -->
        <Style x:Key="AccLogin" TargetType="Button" BasedOn="{StaticResource RowBtn}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Margin" Value="0"/>
            <!-- the text from the account (audit 26 nov., X2): a Setter's text is translated once into a local value, which then hid
                 the trigger's "In use" in every language but English -->
            <Setter Property="Content" Value="{Binding LoginText}"/>
            <Setter Property="ToolTip" Value="Closes Steam and reopens it on this account. Only works for accounts with 'Remember me' ticked on this PC."/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A card or a row of Accounts: Surface, the hairline, Lift under the pointer, the accent at 55 % around the account in use -->
        <Style x:Key="AccBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Lift}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A tag chip: 20 px, rounded 4, Lift (Surface3 on the card under the pointer), 11 px Muted -->
        <Style x:Key="AccChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Lift}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="7,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface3}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- " · " between the level and the hours, only when both are there -->
        <Style x:Key="AccDot" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasLevel}" Value="True"/>
                        <Condition Binding="{Binding HasHours}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A Steam state on a card: 12 px with 10 px after it; the bans and the cooldown in their colour, SemiBold -->
        <Style x:Key="AccState" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,3"/>
            <Setter Property="LineHeight" Value="16.8"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="AccBan" TargetType="TextBlock" BasedOn="{StaticResource AccState}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Bad}"/>
        </Style>

        <!-- 26 Nov (App v3): 14 px in, rounded 10, at least 224 px. The letter in a 34 px box (the Steam picture over it), the name
             14 px SemiBold with "in use", the username in mono; under it the Steam state, the level and hours, the tags, the last
             server and the note; at the bottom In rotation and Log in -->
        <DataTemplate x:Key="AccountCard">
            <Border Margin="0,0,12,12" MinHeight="224" Style="{StaticResource AccBox}" ContextMenu="{StaticResource AccMenu}" Opacity="{Binding ListOpacity}"
                    ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="700" ToolTipService.ShowDuration="30000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Top">
                            <Border Background="{StaticResource Lift}" CornerRadius="6">
                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="6" Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="130"
                                           LineHeight="19.6" LineStackingStrategy="BlockLineHeight"/>
                                <TextBlock Text="  in use" Foreground="{StaticResource Good}" FontSize="12" VerticalAlignment="Bottom" Padding="0,0,0,1"
                                           Visibility="{Binding Active, Converter={StaticResource Vis}}" ToolTip="Account currently logged in"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LoginShown}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis" LineHeight="18.2" LineStackingStrategy="BlockLineHeight"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource AccStar}" Content="{Binding StarGlyph}" Click="AccFav_Click" VerticalAlignment="Top" Margin="0,-6,-6,0"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <WrapPanel>
                            <TextBlock Style="{StaticResource AccState}" Text="no Steam bans" Visibility="{Binding Clean, Converter={StaticResource Vis}}"
                                       ToolTip="No VAC, game ban, trade ban or community ban on the public Steam profile. Bans from servers are separate and shown next to it."/>
                            <TextBlock Style="{StaticResource AccBan}" Text="{Binding VacText}" Visibility="{Binding HasVac, Converter={StaticResource Vis}}"/>
                            <TextBlock Style="{StaticResource AccBan}" Text="{Binding GameBanText}" Visibility="{Binding HasGameBan, Converter={StaticResource Vis}}"/>
                            <TextBlock Style="{StaticResource AccBan}" Text="trade ban" Foreground="{StaticResource Warn}" Visibility="{Binding HasTradeBan, Converter={StaticResource Vis}}"/>
                            <TextBlock Style="{StaticResource AccBan}" Text="community" Visibility="{Binding HasCommunityBan, Converter={StaticResource Vis}}"/>
                            <TextBlock Style="{StaticResource AccBan}" Text="{Binding ServerBansText}" Visibility="{Binding HasServerBans, Converter={StaticResource Vis}}"
                                       ToolTip="{Binding ServerBansTip}"/>
                            <TextBlock Style="{StaticResource AccBan}" Text="{Binding CooldownText}" Foreground="{StaticResource Warn}" Visibility="{Binding InCooldown, Converter={StaticResource Vis}}"
                                       ToolTip="Cooldown set by you. Right-click to change."/>
                            <TextBlock Style="{StaticResource AccState}" Text="not in rotation" Visibility="{Binding Excluded, Converter={StaticResource Vis}}"
                                       ToolTip="New IP + next account never picks this account. Tick In rotation on this card to put it back."/>
                            <TextBlock Style="{StaticResource AccState}" Text="limited" Visibility="{Binding Limited, Converter={StaticResource Vis}}"
                                       ToolTip="Limited Steam account: it has not spent 5 USD on Steam yet, so Steam blocks friend invites and some community features. It can still play."/>
                            <TextBlock Style="{StaticResource AccState}" Text="private" Visibility="{Binding Private, Converter={StaticResource Vis}}"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" TextElement.FontSize="12" TextElement.Foreground="{StaticResource Faint}">
                            <TextBlock Text="{Binding LevelText}" Visibility="{Binding HasLevel, Converter={StaticResource Vis}}"/>
                            <TextBlock Text=" · " Style="{StaticResource AccDot}"/>
                            <TextBlock Text="{Binding HoursText}" Visibility="{Binding HasHours, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <Border Style="{StaticResource AccChip}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Visibility="{Binding HasTags, Converter={StaticResource Vis}}" ToolTip="Your tags (right-click > Note and tags)">
                            <TextBlock Text="{Binding Tags}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" TextElement.FontSize="12">
                        <TextBlock Text="{Binding LastServerText}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasLastServer, Converter={StaticResource Vis}}" ToolTip="{Binding LastServerText}"/>
                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasNote, Converter={StaticResource Vis}}" ToolTip="{Binding Note}"/>
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Check}" Content="In rotation" IsChecked="{Binding InRotation, Mode=OneWay}" Click="AccToggleQuick_Click"
                                  VerticalAlignment="Center" ToolTip="{Binding QuickTip}"/>
                        <Button Grid.Column="1" Style="{StaticResource AccLogin}" Margin="8,0,0,0" Click="AccSwitch_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Accounts as rows (4 nov.): picked in Accounts, offered from 12 accounts. The same menu, star, rotation and Log in as the card, on one line. -->
        <DataTemplate x:Key="AccountRow">
            <Border Margin="0,0,12,4" Padding="10,4" CornerRadius="8" Style="{StaticResource AccBox}" ContextMenu="{StaticResource AccMenu}" Opacity="{Binding ListOpacity}"
                    ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="700" ToolTipService.ShowDuration="30000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <Border Background="{StaticResource Lift}" CornerRadius="5">
                            <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="5" Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                        <TextBlock Text="  in use" Foreground="{StaticResource Good}" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding Active, Converter={StaticResource Vis}}" ToolTip="Account currently logged in"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding LoginShown}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True" Margin="0,3,0,0">
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding VacText}" Foreground="{StaticResource Bad}" Visibility="{Binding HasVac, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding GameBanText}" Foreground="{StaticResource Bad}" Visibility="{Binding HasGameBan, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="trade ban" Foreground="{StaticResource Warn}" Visibility="{Binding HasTradeBan, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="community" Foreground="{StaticResource Bad}" Visibility="{Binding HasCommunityBan, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding ServerBansText}" Foreground="{StaticResource Bad}" Visibility="{Binding HasServerBans, Converter={StaticResource Vis}}"
                                   ToolTip="{Binding ServerBansTip}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding CooldownText}" Foreground="{StaticResource Warn}" Visibility="{Binding InCooldown, Converter={StaticResource Vis}}"
                                   ToolTip="Cooldown set by you. Right-click to change."/>
                        <TextBlock Style="{StaticResource Tag}" Text="not in rotation" Visibility="{Binding Excluded, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="limited" Visibility="{Binding Limited, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Tag}" Text="{Binding HoursText}" Visibility="{Binding HasHours, Converter={StaticResource Vis}}"/>
                        <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="5,0,5,1" Margin="0,0,10,3"
                                Visibility="{Binding HasTags, Converter={StaticResource Vis}}" ToolTip="Your tags (right-click > Note and tags)">
                            <TextBlock Text="{Binding Tags}" Foreground="{StaticResource Info}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource AccStar}" Content="{Binding StarGlyph}" Click="AccFav_Click" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="5" Style="{StaticResource Check}" IsChecked="{Binding InRotation, Mode=OneWay}" Click="AccToggleQuick_Click" Margin="10,0,0,0"
                              VerticalAlignment="Center" ToolTip="{Binding QuickTip}"/>
                    <Button Grid.Column="6" Style="{StaticResource AccLogin}" Margin="10,0,0,0" Click="AccSwitch_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="AccCardsPanel">
            <UniformGrid Columns="4" VerticalAlignment="Top" Loaded="AccGrid_Loaded"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="AccRowsPanel">
            <StackPanel Loaded="AccGrid_Loaded"/>
        </ItemsPanelTemplate>

        <!-- Server list row (26 Nov, App v3 "Servers"): no box around it, a hairline under each row; the row under the pointer or
             picked gets Lift, rounded 8 (in ServerRow), and its Join fills with the accent -->
        <Style x:Key="ServerRowItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <ContentPresenter/>
                            <Border x:Name="bar" Height="1" VerticalAlignment="Bottom" Background="{StaticResource Line}" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bar" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bar" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:RegionPingBrush x:Key="ServerPingBrush"/>
        <!-- The row itself: 46 px at least, 4 and 8 px in, rounded 8; Lift under the pointer or picked -->
        <Style x:Key="ServerRowBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Lift}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Lift}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Join: a 28 px pill; filled in the accent on the row under the pointer or picked -->
        <Style x:Key="JoinBtn" TargetType="Button" BasedOn="{StaticResource RowBtn}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The favorite star: Text when it is one, RouteOff when not -->
        <Style x:Key="SrvStar" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource RouteOff}"/>
            <Setter Property="ToolTip" Value="Favorite: stays at the top"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One player under an open server row (26 Nov, App v3): a 24 px line, no box; the flag in a small rounded tag, the name,
             the score in mono Muted and the time in mono Faint on the right; 22 px to the next column -->
        <DataTemplate x:Key="PlayerChip">
            <Border Margin="0,0,22,0" Height="24" Background="Transparent" ToolTip="{Binding Tip}" TextElement.FontSize="12">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Flag as Staff" Tag="&#xE7C1;" Click="PlayerStaff_Click"/>
                        <MenuItem Header="{Binding FlagMenuText}" Tag="&#xE70F;" Click="PlayerFlag_Click"/>
                        <MenuItem Header="{Binding FollowMenuText}" Tag="&#xE7B3;" Click="PlayerFollow_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy name" Tag="&#xE8C8;" Click="PlayerCopy_Click"/>
                        <MenuItem Header="Remove flag" Tag="&#xE74D;" Click="PlayerUnflag_Click" IsEnabled="{Binding HasFlag}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding FlagSoftBrush}" Height="18" CornerRadius="4" Padding="6,0" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding HasFlag, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding FlagLabel}" Foreground="{Binding FlagBrush}" FontSize="11" FontWeight="SemiBold" MaxWidth="70" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Score}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Faint}" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 26 Nov (App v3): star 20 | Server | Map 104 | Players 128 | Ping 66 | Route 100 | Join 56, 12 px between them. The
             name 13 px SemiBold over the IP:port in mono; the player count with a 36 px bar and the arrow that opens the players;
             the ping in mono, coloured against Regions > Ping under; Protected with its mark; Join a pill -->
        <DataTemplate x:Key="ServerRow">
          <StackPanel TextElement.FontSize="13">
           <Border Style="{StaticResource ServerRowBox}">
            <Grid ToolTip="{Binding Tip}" ToolTipService.ShowDuration="30000" Background="Transparent" VerticalAlignment="Center">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Join" Tag="&#xE768;" Click="SrvConnect_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy IP:port" Tag="&#xE8C8;" Click="CopyServers_Click"/>
                        <MenuItem Header="Copy connect command" Tag="&#xE8C8;" Click="SrvCopyConnect_Click"/>
                        <MenuItem Header="Favorite (yes/no)" Tag="&#xE734;" Click="SrvFav_Click"/>
                        <Separator/>
                        <MenuItem Header="Mark the account in use as banned here" Tag="&#xE7BA;" Click="SrvMarkBan_Click"/>
                        <MenuItem Header="Clear ban marks here" Tag="&#xE711;" Click="SrvClearBans_Click" IsEnabled="{Binding HasBans}"/>
                        <MenuItem Header="Set community name…" Tag="&#xE716;" Click="SrvNetwork_Click"
                                  ToolTip="Servers with the same community name share ban marks. Empty: the app guesses from the server name."/>
                        <Separator/>
                        <MenuItem Header="Remove" Tag="&#xE74D;" Click="RemoveServers_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="112"/>
                    <!-- 80, not 56 (26 nov., critics): "Conectar", "Unirse" and "Войти" were cut to "Conecta", "Unirs" -->
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource SrvStar}" Content="{Binding StarGlyph}" Click="SrvFav_Click" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0" TextElement.FontWeight="SemiBold">
                    <TextBlock Text="{Binding RowTitle}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <!-- Narrow rows trim the "You played here" note first: the ban and the flag say more -->
                    <DockPanel LastChildFill="True" TextElement.FontSize="12" TextElement.FontWeight="Normal" Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Bottom"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding BannedText}" Foreground="{StaticResource Bad}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                   Visibility="{Binding HasBans, Converter={StaticResource Vis}}" ToolTip="The account you're logged in with was banned here, or on another server of the same community (they usually share their ban list). New IP + next account skips it here."/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding FlaggedText}" Foreground="{Binding FlaggedBrush}" Margin="8,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"
                                   Visibility="{Binding HasFlagged, Converter={StaticResource Vis}}" ToolTip="{Binding FlaggedText}"/>
                        <TextBlock Text="{Binding LastText}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"
                                   Visibility="{Binding IsLast, Converter={StaticResource Vis}}" ToolTip="{Binding LastText}"/>
                    </DockPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Map}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <Button Grid.Column="3" Style="{StaticResource Ghost}" Padding="0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalAlignment="Center"
                        Click="SrvPlayers_Click" IsEnabled="{Binding HasPlayerList}" ToolTip="{Binding PlayersTip}" ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PlayersText}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <!-- the 36 px bar: Fill is on a 60 px scale -->
                        <Grid Width="60" Height="3" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPlayers, Converter={StaticResource Vis}}">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="0.6"/>
                            </Grid.LayoutTransform>
                            <Border Background="{StaticResource BtnFillHover}" CornerRadius="2"/>
                            <Border Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding Fill}"/>
                        </Grid>
                        <Path Margin="8,0,0,0" Width="8" Height="5" Stretch="None" VerticalAlignment="Center" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                              Visibility="{Binding HasPlayerList, Converter={StaticResource Vis}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M 0.5,0.5 L 4,4 L 7.5,0.5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Expanded}" Value="True">
                                            <Setter Property="Data" Value="M 0.5,4 L 4,0.5 L 7.5,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="hidden" FontSize="11" Margin="8,0,0,0" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                   Visibility="{Binding PlayersHidden, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="4" Text="{Binding PingText}" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center"
                           ToolTip="Measured on the connection the game uses now: the phone with protection on, your home connection otherwise.">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource ServerPingBrush}">
                            <Binding Path="PingMs"/>
                            <Binding Path="Value" ElementName="RegionsMaxPing"/>
                        </MultiBinding>
                    </TextBlock.Foreground>
                </TextBlock>
                <!-- 26 nov. (critics): a DockPanel, not a StackPanel, so a long state trims before the Join pill instead of running under it -->
                <DockPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,8,0" LastChildFill="True"
                            ToolTip="Protected = Windows sends this server through the phone and blocks it on the home network.">
                    <local:StatusMark DockPanel.Dock="Left" Brush="{Binding RouteBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RouteText}" FontSize="12" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding RouteTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Protected}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <Button Grid.Column="6" Style="{StaticResource JoinBtn}" Click="SrvConnect_Click" HorizontalAlignment="Right" Content="Join"
                        ToolTip="Runs the checks for the way you play now (with protection on: this server's route through the phone), then opens the game. If a check fails, the game does not open."/>
            </Grid>
           </Border>
            <!-- the players: 40 px in, 14 and 10 px inside, rounded 8, the hairline; four columns at the window's usual width -->
            <Border Tag="players" Margin="40,0,8,6" Padding="14,10" CornerRadius="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Visibility="{Binding Expanded, Converter={StaticResource Vis}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Players}" ItemTemplate="{StaticResource PlayerChip}">
                        <ItemsControl.ItemsPanel>
                            <!-- As many 210 px columns as fit, so the chips fill the row (PlayerGrid_SizeChanged) -->
                            <ItemsPanelTemplate><UniformGrid VerticalAlignment="Top" SizeChanged="PlayerGrid_SizeChanged"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="Right-click a player to flag them. Servers only share names, so a flag matches anyone with that name. Add their Steam profile to the flag to keep it after a name change."
                               Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <Grid>
            <!-- 26 Nov (App v3 design): the 2 px line on top lies over the frame (drawn after it, below), in full -->
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================================ Pages (26 Nov: 168 px; that night, the owner: the logo
                     was weak in its corner, the pages all stuck under it and an empty black below them; he asked for the logo and the
                     version centred, the icon over the name, the pages under the logo with a clean gap, and Log and Settings at the
                     foot). The logo 40 px centred on top, 24 px of air, the six pages you use in 66 px rows; at the foot Log and
                     Settings, then the version centred. At the 660 px minimum height everything still fits -->
                <Border x:Name="SideBar" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" SizeChanged="SideBar_SizeChanged">
                    <Grid Margin="0,14,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- the logo (publish/logo-2026-11-06, its 24 px drawing on a 32 grid), centred on top -->
                        <Image x:Name="SideLogo" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                               IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="Pickroute">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H32 V32 H0 Z"/>
                                            <GeometryDrawing Geometry="M1.5,15.5c0,-7.456 6.044,-13.5 13.5,-13.5c7.456,0 13.5,6.044 13.5,13.5c0,0.927 -0.093,1.831 -0.271,2.705c-0.239,-0.064 -0.485,-0.114 -0.735,-0.149c-1.333,-5.412 -5.177,-10.056 -10.494,-10.056c-4.488,0 -9.183,5.237 -12.646,12.165l-2.026,0c-0.535,-1.454 -0.828,-3.026 -0.828,-4.665z">
                                                <GeometryDrawing.Brush><SolidColorBrush Color="{StaticResource AccentDeepColor}"/></GeometryDrawing.Brush>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="{StaticResource Accent}" Geometry="M15,29c-3.435,0 -6.57,-1.283 -8.953,-3.395c2.576,-8.171 5.601,-13.605 10.953,-13.605c5.389,0 6.517,2.103 6.859,6.696c-1.899,1.007 -3.192,3.005 -3.192,5.304c0,1.203 0.354,2.323 0.964,3.262c-1.958,1.106 -4.221,1.738 -6.631,1.738z"/>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Brush><SolidColorBrush Color="{StaticResource AccentDeepColor}"/></GeometryDrawing.Brush>
                                                <GeometryDrawing.Geometry><EllipseGeometry Center="26.667,24" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Brush><SolidColorBrush Color="{StaticResource Top3}"/></GeometryDrawing.Brush>
                                                <GeometryDrawing.Geometry><EllipseGeometry Center="26.667,24" RadiusX="2.667" RadiusY="2.667"/></GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>
                        <StackPanel x:Name="SideNavTop" Grid.Row="1" Margin="0,24,0,0">
                            <RadioButton x:Name="NavNet" Style="{StaticResource Nav}" Tag="&#xEA18;" Content="Connection" IsChecked="True" Checked="Nav_Checked"
                                         ToolTip="The IP servers see, Change IP and the phone"/>
                            <RadioButton x:Name="NavServers" Style="{StaticResource Nav}" Tag="&#xE968;" Content="Servers" Checked="Nav_Checked"
                                         ToolTip="Your servers: players, ping and Join"/>
                            <RadioButton x:Name="NavRegions" Style="{StaticResource Nav}" Tag="&#xE909;" Content="Regions" Checked="Nav_Checked"
                                         ToolTip="Pick where CS2 matchmaking can play"/>
                            <RadioButton x:Name="NavAccounts" Style="{StaticResource Nav}" Tag="&#xE716;" Content="Accounts" Checked="Nav_Checked"
                                         ToolTip="Switch Steam account with one click"/>
                            <RadioButton x:Name="NavConfigs" Style="{StaticResource Nav}" Tag="&#xE8F1;" Content="Configs" Checked="Nav_Checked"
                                         ToolTip="CS2 config copied between your accounts"/>
                            <RadioButton x:Name="NavProfiles" Style="{StaticResource Nav}" Tag="&#xE77B;" Content="Profiles" Checked="Nav_Checked"
                                         ToolTip="Change the name, picture and details of your Steam accounts, or make them all look the same"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" Tag="&#xE81C;" Content="Log" Checked="Nav_Checked"
                                         ToolTip="Everything the app did, with timestamps"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked" Margin="0,0,0,10"/>
                            <Button x:Name="UpdateBtn" Style="{StaticResource RowPrimary}" Click="Update_Click" Content="Update" Padding="10,0" Margin="0,0,0,8" FontSize="11"
                                    HorizontalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================================ Content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- top bar: app / page, the state chip, the quick switch, the window (26 Nov, App v3) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Margin="24,0,16,0" VerticalAlignment="Center" LastChildFill="True" TextElement.FontSize="13">
                            <TextBlock DockPanel.Dock="Left" Text="Pickroute" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Text="/" Margin="8,0" Foreground="{StaticResource Faint}" Opacity="0.55" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" x:Name="PageTitle" Text="Connection" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <!-- the command running now (hotkeys and buttons), then how it ended -->
                            <Border x:Name="ActivityPill" HorizontalAlignment="Left" Margin="16,0,0,0" MaxWidth="440" Padding="9,3,11,3" Background="{StaticResource Surface3}"
                                    Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonUp="Activity_Click"
                                    ToolTip="{Binding Text, ElementName=ActivityText}">
                                <DockPanel>
                                    <!-- while the command only waits (CS2's menu, Steam, an answer): stop it without starting another -->
                                    <TextBlock x:Name="ActivityCancel" DockPanel.Dock="Right" Text="Cancel" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ActivityCancel_Click"
                                               ToolTip="Stops what the app is waiting for. Nothing that already happened is undone."/>
                                    <TextBlock x:Name="ActivityIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE895;" FontSize="12" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform x:Name="ActivitySpin"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="ActivityText" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                        <ProgressBar x:Name="ActivityLine" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True" Background="Transparent" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- the state chip: 24 px, rounded, a 10 % wash of the state's colour behind the mark, the state and the IP -->
                            <Grid VerticalAlignment="Center" Height="24" Cursor="Hand" Background="Transparent"
                                  MouseLeftButtonUp="SideStatus_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Click to go to Connection.">
                                <Border CornerRadius="12" Background="{Binding Fill, ElementName=SideDot}" Opacity="0.1"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                    <local:StatusMark Brush="{Binding Fill, ElementName=SideDot}"/>
                                    <Ellipse x:Name="SideDot" Width="0" Height="0" Fill="{StaticResource Warn}"/>
                                    <TextBlock x:Name="SideState" Text="Checking…" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding Fill, ElementName=SideDot}"/>
                                    <TextBlock x:Name="SideIp" Text="—" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Info}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="SideQuick" Style="{StaticResource TopPill}" Click="Quick_Click" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="New IP + next account (its hotkey works in game too): new IP, next account, back to the last server.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SideQuickLabel" Text="New IP + next account"/>
                                    <!-- 26 nov. (critics: "atlas" read as a word, not an account): the account with a person mark, in the accent -->
                                    <TextBlock x:Name="SideQuickIcon" Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Accent}"
                                               Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock x:Name="SideQuickNext" Text="" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="3,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                    <TextBlock x:Name="SideQuickTail" Text=""/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                            <Button Style="{StaticResource Chrome}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"/>
                            <Button x:Name="MaxBtn" Style="{StaticResource Chrome}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize"/>
                            <Button Style="{StaticResource Chrome}" Tag="close" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
                        </StackPanel>
                    </Grid>

                    <!-- ======================================== Page: Connection -->
                    <!-- 26 Nov (App v3 design): the title and its line, then two columns. Left (600 of 1024 at 1240 px): the state,
                         the IP servers see, the route This PC > phone > servers, the buttons, what goes through the phone. Right: Checks,
                         Phone, Previous IPs, How it works, each under a hairline. Look.Round draws the buttons the code picks as pills -->
                    <ScrollViewer x:Name="PageNet" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,18" local:Look.Round="True">
                        <ScrollViewer.Resources>
                            <local:UpperText x:Key="Upper"/>
                            <!-- A section: its title (14 px SemiBold, Display) on a 28 px line, then what is in it. An action of the title
                                 (Show all, Phone setup, Clear history) sits on that line with a -28 px top margin, on the right -->
                            <Style x:Key="NetSection" TargetType="HeaderedContentControl">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="HeaderedContentControl">
                                            <StackPanel>
                                                <Grid MinHeight="28">
                                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource DisplayFont}"
                                                                      TextElement.FontSize="14" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Text}"/>
                                                </Grid>
                                                <ContentPresenter/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- How it works: the same title line with a chevron on the right; a click folds it -->
                            <Style x:Key="NetFold" TargetType="Expander">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Expander">
                                            <StackPanel>
                                                <ToggleButton Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{TemplateBinding Header}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Grid MinHeight="28" Background="Transparent">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                                <Path x:Name="chev" Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="chev" Property="Data" Value="M 0,3.5 L 3.5,0 L 7,3.5"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="chev" Property="Stroke" Value="{StaticResource Text}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                    <ContentPresenter Content="{TemplateBinding Header}" TextElement.FontFamily="{StaticResource DisplayFont}"
                                                                      TextElement.FontSize="14" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Text}"/>
                                                </ToggleButton>
                                                <ContentPresenter x:Name="body" Margin="0,4,0,0" Visibility="Collapsed"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- What goes through the phone: a 14 px round radio, 12 px to the text; the one picked in a box (Field, the
                                 accent at 35 %, rounded 8) with the ring 4 px thick in the accent -->
                            <Style x:Key="ModeChoice" TargetType="RadioButton">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="ring" Width="14" Height="14" Stroke="{StaticResource RouteOff}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    <ContentPresenter Grid.Column="1" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Muted}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Field}"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                                                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="ring" Property="StrokeThickness" Value="4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="ModeTitle" TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="LineHeight" Value="18.2"/>
                                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                            </Style>
                            <Style x:Key="ModeSub" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Margin" Value="0,2,0,0"/>
                                <Setter Property="LineHeight" Value="16.8"/>
                                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                            </Style>
                            <!-- How the PC connects to the phone: 28 px, rounded 6, Field with the hairline, the chevron in Muted -->
                            <Style x:Key="NetCombo" TargetType="ComboBox">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                                                                <Path Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
                                                            <ScrollViewer>
                                                                <ItemsPresenter/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- Copy IP: a 28 px square, rounded 6, the hairline; the light wash under the mouse -->
                            <Style x:Key="CopyBtn" TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource InfoSoft}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- The hotkey in a small key box (Ctrl+Shift+F10) -->
                            <Style x:Key="KeyBox" TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="Padding" Value="6,2"/>
                            </Style>
                            <Style x:Key="RouteHead" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="LineHeight" Value="18.2"/>
                            </Style>
                            <!-- The line under the title: the picked mode, then how the PC connects (not in No phone) -->
                            <Style x:Key="NetSubLink" TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModeHome}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel TextElement.FontSize="13">
                            <!-- the title and its line -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Connection" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" LineHeight="26.4" LineStackingStrategy="BlockLineHeight"/>
                                <Button Style="{StaticResource PageSettingsLink}" Tag="net" Content="Settings for this page" Click="PageSettingsLink_Click"
                                        ToolTip="Protection, mobile data, Change IP and the hotkeys"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0" TextElement.FontSize="12.5" TextElement.Foreground="{StaticResource Muted}">
                                <TextBlock Text="Game only" Visibility="{Binding IsChecked, ElementName=ModeServers, Converter={StaticResource Vis}}"/>
                                <TextBlock Text="Whole PC while CS2 is open" Visibility="{Binding IsChecked, ElementName=ModeGame, Converter={StaticResource Vis}}"/>
                                <TextBlock Text="Whole PC, always" Visibility="{Binding IsChecked, ElementName=ModeAll, Converter={StaticResource Vis}}"/>
                                <TextBlock Text="No phone" Visibility="{Binding IsChecked, ElementName=ModeHome, Converter={StaticResource Vis}}"/>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource NetSubLink}">
                                    <TextBlock Text=" · "/>
                                    <TextBlock Text="{Binding SelectedItem.Content, ElementName=EgressCombo, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="600*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="396*" MinWidth="300"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="NetLeft">
                                    <StackPanel x:Name="Hero">
                                        <!-- the state: its mark (the shape per state of StatusMark), the title in its colour, the sentence.
                                             HeroBadge and HeroIcon keep the colour the code sets; the mark and the title read it -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="HeroBadge" Visibility="Collapsed" Background="{StaticResource WarnSoft}">
                                                <TextBlock x:Name="HeroIcon" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Warn}"/>
                                            </Border>
                                            <local:StatusMark Brush="{Binding Foreground, ElementName=HeroIcon}" Margin="0,1,7,0"/>
                                            <TextBlock x:Name="HeroTitle" Text="Checking the connection…" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, ElementName=HeroIcon}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HeroSub" Text="One moment." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                        <!-- the IP servers see, big, and Copy -->
                                        <StackPanel Margin="0,25,0,0" ToolTip="The public IP the servers in your list see.">
                                            <TextBlock x:Name="EgressIpKey" Text="IP servers see" Visibility="Collapsed"/>
                                            <TextBlock Text="{Binding Text, ElementName=EgressIpKey, Converter={StaticResource Upper}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock x:Name="EgressIp" Text="—" FontFamily="{StaticResource Mono}" FontSize="40" FontWeight="SemiBold" LineHeight="44"
                                                           LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/>
                                                <Button x:Name="CopyIpBtn" Style="{StaticResource CopyBtn}" Content="&#xE8C8;" Click="CopyEgressIp_Click" Margin="14,0,0,0" ToolTip="Copy IP"/>
                                            </StackPanel>
                                            <TextBlock x:Name="EgressIsp" Text="—" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </StackPanel>

                                        <!-- the route: one flat accent line while protected (RouteOn; a blue to magenta gradient until 26 Nov at
                                             night), grey rings and dashes otherwise (RouteOff) -->
                                        <Grid Height="14" Margin="0,26,0,0">
                                            <Grid x:Name="RouteOn" Visibility="Collapsed">
                                                <Rectangle Height="2" Margin="6,6,6,0" VerticalAlignment="Top" Fill="{StaticResource Accent}"/>
                                                <Ellipse Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" Fill="{StaticResource Bg}" StrokeThickness="2"
                                                         Stroke="{StaticResource Accent}"/>
                                                <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" Fill="{StaticResource RouteMid}"/>
                                                <Ellipse Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-1,0" Stroke="{StaticResource Bg}" StrokeThickness="3"
                                                         Fill="{StaticResource Accent}"/>
                                            </Grid>
                                            <Grid x:Name="RouteOff">
                                                <Line X1="0" X2="1" Y1="0" Y2="0" Stretch="Fill" Margin="12,6,12,0" VerticalAlignment="Top" Stroke="{StaticResource RouteDash}"
                                                      StrokeThickness="2" StrokeDashArray="2,2"/>
                                                <Ellipse Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" Fill="{StaticResource Bg}" Stroke="{StaticResource RouteOff}" StrokeThickness="2"/>
                                                <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" Fill="{StaticResource Bg}" Stroke="{StaticResource RouteOff}" StrokeThickness="2"
                                                         StrokeDashArray="1.2,1"/>
                                                <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" Fill="{StaticResource Bg}" Stroke="{StaticResource RouteOff}" StrokeThickness="2"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="0,10,0,0" TextElement.FontSize="12" TextElement.Foreground="{StaticResource Muted}" TextBlock.LineHeight="16.8" TextBlock.LineStackingStrategy="BlockLineHeight">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- This PC: the home IP (hidden, the eye shows it) and its network -->
                                            <StackPanel ToolTip="Hidden so it does not show up in screenshots or streams.">
                                                <TextBlock Text="This PC" Style="{StaticResource RouteHead}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Name="HomeIp" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button x:Name="RevealBtn" Style="{StaticResource IconBtn}" Content="&#xE7B3;" Click="Reveal_Click" Width="22" Height="18" FontSize="13" Margin="3,-2,0,-2"
                                                            ToolTip="Show or hide"/>
                                                </StackPanel>
                                                <TextBlock x:Name="HomeIsp" Text="—" Visibility="Collapsed"/>
                                                <!-- two lines at most (26 nov., critics: a long carrier name took four and pushed the buttons down) -->
                                                <TextBlock x:Name="HomeLine" Text="—" Foreground="{StaticResource Faint}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="33.6" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <!-- the phone: its name, carrier and battery, and its state (PhoneDot, PhoneState); the full line in the tooltip -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" ToolTip="{Binding Text, ElementName=PhoneDetail}">
                                                <TextBlock x:Name="RoutePhoneName" Text="Phone" Style="{StaticResource RouteHead}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="PhoneDetail" Text="" Visibility="Collapsed"/>
                                                <TextBlock x:Name="RoutePhoneDetail" Text="" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                    <!-- PhoneDot holds the colour the code sets; the marker draws it with its shape -->
                                                    <Rectangle x:Name="PhoneDot" Width="0" Height="0" Fill="{StaticResource Faint}"/>
                                                    <local:StatusMark Brush="{Binding Fill, ElementName=PhoneDot}"/>
                                                    <TextBlock x:Name="PhoneState" Text="Searching…" Margin="6,0,0,0" Foreground="{Binding Fill, ElementName=PhoneDot}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- the servers: what they see -->
                                            <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                                                <TextBlock Text="Servers" Style="{StaticResource RouteHead}" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="RouteServersSee" Text="" TextWrapping="Wrap" TextAlignment="Right" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="RouteServersNever" Text="" Foreground="{StaticResource Faint}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- the buttons: the main one filled (the code picks it: Change IP, Change IP and rejoin, Turn on protection),
                                             the others outlined, the leak test a word, Turn off protection red on the right -->
                                        <Grid Margin="0,24,0,0">
                                            <DockPanel x:Name="ActionRow" LastChildFill="False">
                                                <!-- beta.10: protection starts off; this is the one way on (also in the tray icon's menu) -->
                                                <Button x:Name="TurnOnBtn" Style="{StaticResource Primary}" Padding="13,0" Height="28" Margin="0,0,8,0" VerticalAlignment="Top" Click="TurnOn_Click" Content="Turn on protection"
                                                        Visibility="Collapsed"
                                                        ToolTip="The kill switch, the routes and the CS2 lock: servers only see the phone's IP, and if the phone drops they are blocked instead of seeing your home IP. It stays on until you turn it off."/>
                                                <Button x:Name="ChangeIpBtn" Style="{StaticResource Primary}" Padding="13,0" Height="28" Margin="0,0,8,0" VerticalAlignment="Top" Click="ChangeIp_Click" Content="Change IP"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ToolTip="Turns the phone's mobile data off and on until the carrier gives a new IP. Needs the phone set up over ADB. If you are on a server, you will drop."/>
                                                <StackPanel Margin="0,0,8,0" VerticalAlignment="Top">
                                                    <Button x:Name="RejoinBtn" Click="Rejoin_Click" Padding="13,0" Height="28" Margin="0" Content="Change IP and rejoin"
                                                            ToolTip="Changes the IP, then joins the last server again. Only joins with protection confirmed. In game: the rejoin hotkey (Settings > Hotkeys and sounds)."/>
                                                    <!-- under the button, out of the row's height (the next section's 48 px leave room for it) -->
                                                    <Canvas Height="0">
                                                        <StackPanel x:Name="RejoinHotkeyHint" Orientation="Horizontal" Canvas.Left="4" Canvas.Top="6" Background="Transparent"
                                                                    ToolTip="Works anywhere, also in game. Change it in Settings > Hotkeys and sounds.">
                                                            <Border Style="{StaticResource KeyBox}">
                                                                <TextBlock x:Name="RejoinHotkeyKeys" Text="Ctrl+Shift+F10" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                                            </Border>
                                                            <TextBlock Text=" in game" FontSize="12" Foreground="{StaticResource Faint}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Canvas>
                                                </StackPanel>
                                                <Button x:Name="LeakBtn" Style="{StaticResource LinkBtn}" Click="LeakTest_Click" VerticalAlignment="Top" Content="Run leak test"
                                                        ToolTip="Full test: Firewall, block, each server's route and whether the phone's IP really differs from your home IP."/>
                                                <Button x:Name="TurnOffBtn" DockPanel.Dock="Right" Style="{StaticResource DangerLink}" Click="Restore_Click" Margin="8,0,-8,0" VerticalAlignment="Top" Content="Turn off protection" Visibility="Collapsed"
                                                        ToolTip="Removes the block, the routes and the CS2 lock. Use it if your internet stops working. Turn on protection brings it back. Your servers stay saved, and regions you turned off stay off (Regions > Allow all (block off) lifts them)."/>
                                            </DockPanel>

                                            <Grid x:Name="ProgressPanel" VerticalAlignment="Center" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock x:Name="ProgressText" Text="" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                    <ProgressBar IsIndeterminate="True" Height="2"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>

                                    <HeaderedContentControl x:Name="ModeGroup" Style="{StaticResource NetSection}" Header="What goes through the phone" Margin="0,48,0,0">
                                        <StackPanel>
                                            <RadioButton x:Name="ModeServers" Style="{StaticResource ModeChoice}" GroupName="mode" Checked="Mode_Checked">
                                                <StackPanel>
                                                    <TextBlock Text="Game only" Style="{StaticResource ModeTitle}"/>
                                                    <TextBlock Text="CS2, Steam and the servers on your Servers page. Other servers are blocked while Settings > Protection > CS2 only through the phone is on. The rest of the PC stays on your home network." Style="{StaticResource ModeSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ModeGame" Style="{StaticResource ModeChoice}" GroupName="mode" Checked="Mode_Checked">
                                                <StackPanel>
                                                    <TextBlock Text="Whole PC while CS2 is open" Style="{StaticResource ModeTitle}"/>
                                                    <TextBlock Text="You can join any server, not only the ones on your Servers page. While CS2 is open the whole PC uses the phone, so it uses more mobile data. Back to normal when you close CS2." Style="{StaticResource ModeSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ModeAll" Style="{StaticResource ModeChoice}" GroupName="mode" Checked="Mode_Checked">
                                                <StackPanel>
                                                    <TextBlock Text="Whole PC, always" Style="{StaticResource ModeTitle}"/>
                                                    <TextBlock Text="Everything goes through the phone. Uses more data." Style="{StaticResource ModeSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ModeHome" Style="{StaticResource ModeChoice}" GroupName="mode" Checked="Mode_Checked">
                                                <StackPanel>
                                                    <TextBlock Text="No phone: play on your home connection" Style="{StaticResource ModeTitle}"/>
                                                    <TextBlock Text="Not protected: servers see your home IP and there is no Change IP. Accounts, Configs, Profiles and Regions still work." Style="{StaticResource ModeSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <TextBlock Text="Save mobile data and Fall back to Game only: Settings > Mobile data." FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="13,8,0,0"/>
                                            <TextBlock x:Name="PcRouteText" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </StackPanel>

                                <StackPanel x:Name="NetRight" Grid.Column="2">
                                    <HeaderedContentControl Style="{StaticResource NetSection}" Header="Checks">
                                        <StackPanel>
                                            <!-- beta.11: only the rows that need you, unless Show all (remembered) -->
                                            <Button x:Name="ChecksToggle" Style="{StaticResource LinkBtn}" HorizontalAlignment="Right" Margin="0,-28,-8,0" Content="Show all" Click="ChecksToggle_Click"
                                                    ToolTip="Every check, also the ones that are fine"/>
                                            <DockPanel Margin="0,2,0,0">
                                                <local:StatusMark x:Name="ChecksMark" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,8,0" Brush="{StaticResource Good}"/>
                                                <TextBlock x:Name="ChecksSummary" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <ItemsControl x:Name="Checks" TextElement.FontSize="12">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,8,0,0" ToolTip="{Binding Help}" Background="Transparent" Visibility="{Binding Shown, Converter={StaticResource Vis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="17"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <local:StatusMark Brush="{Binding Brush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{Binding DetailBrush}" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,22,0,0">
                                        <HeaderedContentControl x:Name="PhoneGroup" Style="{StaticResource NetSection}" Header="Phone">
                                            <StackPanel>
                                                <!-- Until a phone has been seen once, Phone setup leads and the single steps stay out of the way (MainWindow.Phone.cs) -->
                                                <WrapPanel x:Name="PhoneButtons" HorizontalAlignment="Right" Margin="60,-28,0,0">
                                                    <Border x:Name="AdbInstallHost">
                                                        <Button x:Name="AdbInstallBtn" Style="{StaticResource Primary}" Click="AdbInstall_Click" Padding="13,0" Height="28" Margin="8,0,0,6" Visibility="Collapsed" Content="Install phone tool (ADB)"
                                                                ToolTip="Downloads Google's official ADB (~7 MB) to the app folder. One time only."/>
                                                    </Border>
                                                    <Button x:Name="WifiOffBtn" Style="{StaticResource Primary}" Click="WifiOff_Click" Padding="13,0" Height="28" Margin="8,0,0,6" Visibility="Collapsed" Content="Turn off phone Wi-Fi"
                                                            ToolTip="So USB tethering uses mobile data and not the home network."/>
                                                    <Border x:Name="TetherHost">
                                                        <Button x:Name="TetherBtn" Click="Tether_Click" Padding="13,0" Height="28" Margin="8,0,0,6" Content="Turn on USB tethering"
                                                                ToolTip="Asks the phone to turn on USB tethering and waits up to 30 s for Windows to see it. On some models you have to turn it on by hand."/>
                                                    </Border>
                                                    <Button x:Name="PhoneSetupBtn" Click="PhoneHelp_Click" Padding="13,0" Height="28" Margin="8,0,0,6" Content="Phone setup"
                                                            ToolTip="Installs the phone tool if it's missing, then checks the cable, the driver, USB debugging, tethering, the phone's Wi-Fi and where the rest of the PC goes, fixes what it can and tells you the one thing left to do"/>
                                                </WrapPanel>
                                                <TextBlock Text="How the PC connects to the phone" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="EgressCombo" Style="{StaticResource NetCombo}" SelectionChanged="EgressCombo_Changed" Width="260" HorizontalAlignment="Left"
                                                          ToolTip="USB cable (recommended) or the phone's Wi-Fi hotspot. A USB 4G/5G dongle or router also works."/>
                                                <TextBlock x:Name="EgressDetail" Text="" Visibility="Collapsed" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock x:Name="DataUsage" Text="" Visibility="Collapsed" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Background="Transparent"
                                                           ToolTip="Everything that went through the phone's adapter (CS2, Steam and, in Whole PC, the rest of the PC), counted by Windows. Your carrier's count can differ a little. Warning: Settings > Mobile data."/>
                                            </StackPanel>
                                        </HeaderedContentControl>
                                    </Border>

                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,22,0,0">
                                        <HeaderedContentControl x:Name="HistoryGroup" Style="{StaticResource NetSection}" Header="Previous IPs">
                                            <StackPanel>
                                                <Button x:Name="ClearHistoryBtn" Style="{StaticResource LinkBtn}" HorizontalAlignment="Right" Margin="0,-28,-8,0" Content="Clear history" Click="ClearHistory_Click"/>
                                                <TextBlock x:Name="HistoryEmpty" Text="No IP changes yet." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <ScrollViewer MaxHeight="168" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="History" TextElement.FontSize="12" TextBlock.LineHeight="16.8" TextBlock.LineStackingStrategy="BlockLineHeight">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="44"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="118"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Ip}" FontFamily="{StaticResource Mono}"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding IspShort}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Isp}"/>
                                                                <TextBlock Grid.Column="5" Text="{Binding ReasonText}" Foreground="{StaticResource Faint}" Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </HeaderedContentControl>
                                    </Border>

                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,22,0,0">
                                        <Expander x:Name="HowFold" Style="{StaticResource NetFold}" Header="How it works" IsExpanded="True">
                                            <StackPanel TextElement.FontSize="12.5" TextElement.Foreground="{StaticResource Muted}" TextBlock.LineHeight="17.5" TextBlock.LineStackingStrategy="BlockLineHeight">
                                                <TextBlock TextWrapping="Wrap" Text="The phone shares its mobile data with the PC, over a USB cable or the Wi-Fi hotspot. The app sends the game through it: servers see the carrier IP, not your home IP."/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="If the connection drops, the block stops those servers instead of letting your IP through."/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="Change IP turns data off and on until a new IP comes. A USB 4G/5G dongle or router also works."/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="Other people on the same carrier can use the same IP at the same time."/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================================== Page: Servers -->
                    <!-- 26 Nov (App v3 design "Servers"): no group boxes. The title and "12 servers on 2 IPs · all protected"; the
                         paste field with Default port, Add, Paste and Import on one line; search, Refresh every 30 s, Refresh all, Copy IPs and
                         Remove on the next; then the table, with no box around it -->
                    <Grid x:Name="PageServers" Grid.Row="1" Margin="24,16,24,18" Visibility="Collapsed" local:Look.Round="True" TextElement.FontSize="13">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Servers" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" LineHeight="26.4" LineStackingStrategy="BlockLineHeight"/>
                                <Button Style="{StaticResource PageSettingsLink}" Tag="servers" Content="Settings for this page" Click="PageSettingsLink_Click"
                                        ToolTip="Protection, player flags, the programs that open with CS2, and kicks and bans"/>
                            </StackPanel>
                            <TextBlock x:Name="ServerCount" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BulkInput" Style="{StaticResource FieldBox}" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled"
                                     FontFamily="{StaticResource Mono}" FontSize="12" PreviewKeyDown="BulkInput_KeyDown"
                                     Tag="Paste server IPs here, e.g. 1.2.3.4:27015 (Ctrl+Enter adds)"
                                     ToolTip="Accepts IP:port, 'IP port', 'connect IP:port', steam://connect links and whole lists. Duplicates are ignored."/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip="Port used when you paste only the IP (CS2 uses 27015)">
                                <TextBlock Text="Default port" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="DefaultPortBox" Style="{StaticResource FieldBox}" Width="70" FontFamily="{StaticResource Mono}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Click="AddServers_Click" Content="Add" Margin="0,0,8,0" ToolTip="Adds those servers to the list (Ctrl+Enter). With protection on, they only go out through the phone."/>
                                <Button Style="{StaticResource LinkBtn}" Click="PasteServers_Click" Content="Paste" Margin="0,0,8,0" ToolTip="Adds whatever is on the clipboard"/>
                                <Button Style="{StaticResource LinkBtn}" Click="ImportServers_Click" Content="Import" ToolTip="Reads every IP:port from a .txt, .csv, .cfg or .log file"/>
                                <!-- 26 nov. (critics): the field asks for IPs without saying where they come from -->
                                <Button x:Name="WhereIpsBtn" Style="{StaticResource LinkBtn}" Click="WhereIps_Click" Content="Where to find IPs?" Margin="0,0,-8,0"/>
                            </StackPanel>
                        </Grid>

                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="FollowBar" Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource Field}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto" MaxWidth="900"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="FollowText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                            <Button x:Name="FollowJoinBtn" Style="{StaticResource Primary}" Click="FollowJoin_Click" Content="Join"
                                                    ToolTip="Joins that server with the usual protection checks"/>
                                            <Button Click="FollowDismiss_Click" Margin="0" Content="Dismiss"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="SlotBar" Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource Field}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto" MaxWidth="900"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="SlotText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                            <CheckBox x:Name="SlotAutoBox" Style="{StaticResource Check}" Content="Join automatically" VerticalAlignment="Center" Margin="0,0,14,0"
                                                      ToolTip="On: joins as soon as a slot opens, with the usual checks. Off: only a sound and a notice."/>
                                            <Button x:Name="SlotJoinBtn" Style="{StaticResource Primary}" Click="SlotJoin_Click" Content="Join" Visibility="Collapsed"/>
                                            <Button Click="SlotCancel_Click" Margin="0" Content="Cancel"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServerSearch" Style="{StaticResource FieldBox}" Tag="Search name, IP or map" TextChanged="ServerSearch_Changed" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <CheckBox x:Name="AutoQueryBox" Style="{StaticResource Check}" Content="Refresh every 30 s" Margin="0,0,8,0" VerticalAlignment="Center" Click="AutoQuery_Click"
                                                  ToolTip="Players, map and ping every 30 seconds, on the connection the game uses now"/>
                                        <Button x:Name="QueryBtn" Click="QueryServers_Click" Content="Refresh all" Margin="0,0,8,0" ToolTip="Asks the marked servers, or all the ones shown when none is marked, for their name, map, players and ping. With protection on, only through the phone, never the home network. Click a marked server again, or press Escape, to unmark it."/>
                                        <Button x:Name="CopyBtn" Click="CopyServers_Click" Content="Copy IPs" Margin="0,0,8,0" ToolTip="Copies the selected servers (or all the ones shown) as IP:port"/>
                                        <Button x:Name="RemoveBtn" Style="{StaticResource Danger}" Margin="0" Click="RemoveServers_Click" Content="Remove" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Removes the selected servers and their routes. Select first (Ctrl or Shift for several)."/>
                                    </StackPanel>
                                </Grid>
                                <!-- the column titles: 26 px, 12 px Faint, the hairline under them; 14 px on the right for the list's scroll bar -->
                                <Border Grid.Row="2" Margin="0,12,0,0" Height="26" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,0,14,0"
                                        Visibility="{Binding Visibility, ElementName=ServerHeader}">
                                <Grid x:Name="ServerHeader" VerticalAlignment="Center" TextElement.FontSize="12" TextElement.Foreground="{StaticResource Faint}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="116"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Server"/>
                                    <TextBlock Grid.Column="2" Text="Map"/>
                                    <TextBlock Grid.Column="3" Text="Players" Background="Transparent"
                                               ToolTip="Click a player count to see who is on the server. Right-click a player there to flag them."/>
                                    <TextBlock Grid.Column="4" Text="Ping"/>
                                    <TextBlock Grid.Column="5" Text="Route"/>
                                </Grid>
                                </Border>
                                <ListBox x:Name="ServerList" Grid.Row="3" Padding="0" Margin="0,4,0,0" SelectionMode="Extended" ItemContainerStyle="{StaticResource ServerRowItem}"
                                         ItemTemplate="{StaticResource ServerRow}" MouseDoubleClick="ServerList_DoubleClick" SelectionChanged="ServerList_SelectionChanged"
                                         PreviewMouseLeftButtonDown="ServerList_PreviewMouseDown" KeyDown="ServerList_KeyDown"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                <StackPanel x:Name="ServersEmpty" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="No servers yet" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Paste the IP:port of the servers you play on, or import a .txt, .csv, .cfg or .log file." Foreground="{StaticResource Muted}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    <!-- beta.11, 2nd round of simulated users: they know the server's name, not its IP, and a banned player can't join it to type status -->
                                    <TextBlock x:Name="ServersEmptyHelp" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,4,0,12" HorizontalAlignment="Center" TextAlignment="Center"
                                               Text="Only know its name? Join it once in CS2 with protection off (that join uses your home IP): the app offers to add it.&#x0a;Banned there? Ask on its Discord or website for the IP (it often reads connect 1.2.3.4:27015)."/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource Primary}" Click="PasteServers_Click" Content="Paste from clipboard"/>
                                        <Button Click="ImportServers_Click" Margin="0" Content="Import file"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                    </Grid>

                    <!-- ======================================== Page: Regions -->
                    <!-- 26 Nov (App v3 design "Regions"): no group boxes. On top the title and the state, the game's tabs,
                         Preset and the shortcuts on one row; under it on the left Ping under and the list by continent, on the right the
                         dial, which draws the same list (spoke = ping, ring = Ping under, the lit arc = where CS2 may play) -->
                    <Grid x:Name="PageRegions" Grid.Row="1" Margin="24,16,24,0" Visibility="Collapsed" Loaded="PageRegions_Loaded" IsVisibleChanged="PageRegions_VisibleChanged">
                        <Grid.Resources>
                            <local:RegionPingBrush x:Key="RegionPingBrush"/>
                            <local:RegionBarLength x:Key="RegionBarLength"/>
                            <local:RegionGroupOpen x:Key="RegionGroupOpen"/>
                            <local:RegionGroupNote x:Key="RegionGroupNote"/>
                            <!-- Ping under: a 2 px track, the part under the value in Info, a 12 px knob in Text -->
                            <Style x:Key="RegionTrackPart" TargetType="RepeatButton">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="2" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="RegionSlider" TargetType="Slider">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid Height="20" Background="Transparent">
                                                <Border x:Name="bar" Height="2" CornerRadius="1" VerticalAlignment="Center" Background="{StaticResource Surface3}"/>
                                                <Track x:Name="PART_Track">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource RegionTrackPart}" Background="{StaticResource Info}" Command="Slider.DecreaseLarge"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource RegionTrackPart}" Background="Transparent" Command="Slider.IncreaseLarge"/>
                                                    </Track.IncreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Width="12" Height="12">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Ellipse Fill="{StaticResource Text}"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bar" Property="Background" Value="{StaticResource LineStrong}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- Preset: a 28 px pill (Surface2, the accent dot, the preset, a chevron) that opens the presets under it -->
                            <Style x:Key="PresetPill" TargetType="Expander">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Expander">
                                            <Grid>
                                                <ToggleButton x:Name="head" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" Foreground="{StaticResource Text}"
                                                              AutomationProperties.Name="{TemplateBinding Header}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="b" Height="28" Padding="11,0" CornerRadius="14" Background="{StaticResource Surface2}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                                    <ContentPresenter Margin="8,0" VerticalAlignment="Center"/>
                                                                    <Path Data="M 0,0 L 3,3 L 6,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" FontWeight="SemiBold"/>
                                                </ToggleButton>
                                                <Popup x:Name="pop" PlacementTarget="{Binding ElementName=head}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                                       IsOpen="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" Padding="12,12,12,10" MaxWidth="560">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger SourceName="pop" Property="IsOpen" Value="True">
                                                    <Setter TargetName="head" Property="IsHitTestVisible" Value="False"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- The warning and the tip: one line with its sign and a chevron; a click opens the rest under it -->
                            <Style x:Key="FoldLine" TargetType="Expander">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Expander">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="8,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <ToggleButton Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="-8,-5" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent"/>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ContentPresenter ContentSource="Header" IsHitTestVisible="False"/>
                                                    <Path x:Name="chev" Grid.Column="1" Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                                                          VerticalAlignment="Top" Margin="12,6,0,0" IsHitTestVisible="False"/>
                                                    <ContentPresenter x:Name="body" Grid.Row="1" Margin="26,3,0,0" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="chev" Property="Data" Value="M 0,3.5 L 3.5,0 L 7,3.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- A continent: a 26 px line (28 px with a hairline on top when closed), the chevron, the name, the count, and on
                                 the right what is allowed in it. Open when one of its regions is allowed -->
                            <Style x:Key="RegionGroupHead" TargetType="ToggleButton">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="b" Height="28" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,6,6,0" Padding="12,0,8,0">
                                                <DockPanel VerticalAlignment="Center" TextElement.FontSize="12">
                                                    <Path x:Name="chev" Data="M 0,0 L 3.5,3.5 L 0,7" Stroke="{StaticResource Muted}" StrokeThickness="1.5" VerticalAlignment="Center" Width="7" Margin="0,0,9,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Info}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ItemCount}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Faint}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource RegionGroupNote}">
                                                                <Binding Path="Items"/>
                                                                <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="b" Property="Height" Value="26"/>
                                                    <Setter TargetName="b" Property="BorderThickness" Value="0"/>
                                                    <Setter TargetName="chev" Property="Data" Value="M 0,1.75 L 3.5,5.25 L 7,1.75"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- A region's row: 24 px, rounded on the right, Surface2 under the mouse (and when picked) -->
                            <Style x:Key="RegionRowItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="0,6,6,0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                                                </Trigger>
                                                <!-- the mouse on this region's spoke on the dial lights the row the same way -->
                                                <DataTrigger Binding="{Binding Hot}" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- Only this region: a plain underlined word, on the row under the mouse in place of its bar -->
                            <Style x:Key="RegionOnlyLink" TargetType="Button" BasedOn="{StaticResource Btn}">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" BorderBrush="#66FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,1" VerticalAlignment="Center">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Hot}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title, the state in one line, and on the right where the list and the pings come from -->
                        <Grid Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="240"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Regions" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" LineHeight="26.4" LineStackingStrategy="BlockLineHeight"/>
                                    <Button Style="{StaticResource PageSettingsLink}" Tag="regions" Content="Settings for this page" Click="PageSettingsLink_Click"
                                            ToolTip="When the app starts and closes, and what stays blocked"/>
                                </StackPanel>
                                <TextBlock x:Name="RegionsSummary" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowDuration="30000"><Run x:Name="RegionsSummaryCount" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><Run x:Name="RegionsSummaryRest"/></TextBlock>
                                <!-- Before the list is here (loading, or Valve couldn't be reached): this line says so in place of the summary -->
                                <TextBlock x:Name="RegionsStatus" Text="Loading regions…" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                <TextBlock x:Name="RegionsSource" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" Visibility="Collapsed"/>
                                <Button x:Name="RegionsRefreshBtn" Style="{StaticResource LinkBtn}" Margin="10,0,-8,0" Click="RegionsRefresh_Click" Content="Refresh"
                                        ToolTip="Reads Valve's relay list again and measures the ping to every region on the connection the game uses now"/>
                            </StackPanel>
                        </Grid>

                        <!-- The game's tabs | Preset | the shortcuts -->
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                            <ComboBox x:Name="RegionGamePicker" Style="{StaticResource Tabs}" DisplayMemberPath="Name" IsEnabled="False" Margin="0,0,10,0" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static local:Texts.RegionGame}" SelectionChanged="RegionGamePicker_Changed"/>
                            <Border Width="1" Height="18" Background="{StaticResource LineStrong}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Preset" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Expander x:Name="RegionPresetsPanel" Style="{StaticResource PresetPill}" Header="{x:Static local:Texts.RegionPresets}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <StackPanel>
                                    <WrapPanel>
                                        <ComboBox x:Name="RegionPresetPicker" Width="210" Margin="0,0,8,6" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectionChanged="RegionPresetPicker_Changed"/>
                                        <Button x:Name="RegionPresetApply" Content="{x:Static local:Texts.RegionPresetApply}" Click="RegionPresetApply_Click"/>
                                        <Button x:Name="RegionPresetSave" Content="{x:Static local:Texts.RegionPresetSave}" Click="RegionPresetSave_Click"/>
                                        <Button x:Name="RegionPresetRename" Content="{x:Static local:Texts.RegionPresetRename}" Click="RegionPresetRename_Click"/>
                                        <Button x:Name="RegionPresetRemove" Content="{x:Static local:Texts.RegionPresetRemove}" Click="RegionPresetRemove_Click"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Label x:Name="RegionPresetStartupLabel" Content="{x:Static local:Texts.RegionPresetStart}" Foreground="{StaticResource Muted}" Padding="0" Margin="0,0,10,6"
                                               VerticalAlignment="Center" Target="{Binding ElementName=RegionPresetStartup}"/>
                                        <ComboBox x:Name="RegionPresetStartup" Width="210" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RegionPresetStartup_Changed"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="RegionPresetStartupHint" Text="{x:Static local:Texts.RegionPresetStartHint}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Expander>
                            <Border Width="1" Height="18" Background="{StaticResource LineStrong}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Button x:Name="RegionsClosestBtn" Style="{StaticResource Pill}" Margin="0,0,10,0" IsEnabled="False" Click="RegionsClosest_Click" Content="Closest 3" ToolTip="Keeps the 3 regions with the lowest ping and turns the rest off"/>
                            <Button x:Name="RegionsContinentBtn" Style="{StaticResource Pill}" Margin="0,0,10,0" IsEnabled="False" Click="RegionsContinent_Click" Content="Europe only" Visibility="Collapsed" ToolTip="Keeps every region in your continent and turns the rest off"/>
                            <Button x:Name="RegionsAllowAllBtn" Style="{StaticResource Pill}" Margin="0" IsEnabled="False" Click="RegionsAllowAll_Click" Content="Allow all (block off)" ToolTip="Turns every region back on and removes the Firewall rule. CS2 picks as usual."/>
                        </WrapPanel>

                        <!-- Left: Ping under, the list by continent, the warning and the tip -->
                        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
                            <StackPanel>
                                <Grid Height="30" ToolTip="Keeps only the regions that answered with a ping at or under this value">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ping under" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider x:Name="RegionsMaxPing" Grid.Column="1" Style="{StaticResource RegionSlider}" Minimum="20" Maximum="200" SmallChange="5" LargeChange="10"
                                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="RegionsMaxPing_Changed" MinWidth="60"/>
                                    <TextBlock x:Name="RegionsMaxPingText" Grid.Column="2" Text="60 ms" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                    <Button x:Name="RegionsUnderBtn" Grid.Column="3" Style="{StaticResource PrimaryFill}" Margin="0" IsEnabled="False" Click="RegionsUnder_Click" Content="Block slower" ToolTip="Turns off every region above that ping (and the ones that didn't answer)"/>
                                </Grid>

                                <Grid x:Name="RegionHeader" Margin="0,14,0,0" Visibility="Hidden">
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,5">
                                        <DockPanel>
                                            <TextBlock x:Name="RegionsCount" Text="Regions by continent" FontWeight="SemiBold" Foreground="{StaticResource Info}"/>
                                            <!-- beta.10: Only this region shows on the row under the pointer or the one clicked; the header says so -->
                                            <TextBlock Text="Just one region? Point at it: Only this region" Foreground="{StaticResource Faint}" HorizontalAlignment="Right" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                                <Grid MinHeight="120">
                                    <ListBox x:Name="RegionList" ItemContainerStyle="{StaticResource RegionRowItem}" SelectionMode="Single" Tag="0"
                                             VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <!-- no scroll of its own: the column scrolls, so the warning and the tip follow the list -->
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <ItemsPresenter/>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="GroupItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="GroupItem">
                                                                    <StackPanel>
                                                                        <ToggleButton x:Name="head" Style="{StaticResource RegionGroupHead}"
                                                                                      IsChecked="{Binding Items, Converter={StaticResource RegionGroupOpen}, Mode=OneTime}"
                                                                                      MouseEnter="RegionGroup_MouseEnter" MouseLeave="RegionRow_MouseLeave"/>
                                                                        <ItemsPresenter x:Name="items" Margin="0,0,0,6" Visibility="Collapsed"/>
                                                                    </StackPanel>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger SourceName="head" Property="IsChecked" Value="True">
                                                                            <Setter TargetName="items" Property="Visibility" Value="Visible"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Tip}" Background="Transparent" Height="24" MouseEnter="RegionRow_MouseEnter" MouseLeave="RegionRow_MouseLeave">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="104"/>
                                                        <ColumnDefinition Width="56"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="mark" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource RoundCheck}" IsChecked="{Binding Allowed}" Click="RegionToggle_Click" VerticalAlignment="Center"
                                                              ToolTip="On: CS2 can play here. Off: cs2.exe can't reach this region's relays."/>
                                                    <TextBlock x:Name="city" Grid.Column="3" Text="{Binding City}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Country}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    <!-- the ping as a bar on the 0 to 200 ms scale, the tick at Ping under -->
                                                    <Grid Grid.Column="5" Width="104" Height="10" VerticalAlignment="Center">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Hot}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border Height="2" VerticalAlignment="Center" Background="{StaticResource Surface3}"/>
                                                        <Border x:Name="fill" Height="4" CornerRadius="0,2,2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Faint}"
                                                                Width="{Binding PingMs, Converter={StaticResource RegionBarLength}}"/>
                                                        <Border Width="1" Height="10" HorizontalAlignment="Left" Background="{StaticResource Text}" Opacity="0.7"
                                                                Margin="{Binding Value, ElementName=RegionsMaxPing, Converter={StaticResource RegionBarLength}}"/>
                                                    </Grid>
                                                    <!-- beta.10: the same words on 30 rows were noise; it shows on the row under the pointer (or with the keyboard on it) -->
                                                    <Button Grid.Column="5" Style="{StaticResource RegionOnlyLink}" HorizontalAlignment="Right" Click="RegionOnly_Click" Content="Only this region"
                                                            ToolTip="Turns every other region off. Queues can get long, mostly outside peak hours."/>
                                                    <TextBlock Grid.Column="6" Text="{Binding PingText}" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource RegionPingBrush}">
                                                                <Binding Path="PingMs"/>
                                                                <Binding Path="Value" ElementName="RegionsMaxPing"/>
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Allowed}" Value="True">
                                                        <Setter TargetName="mark" Property="Background" Value="{StaticResource Accent}"/>
                                                        <Setter TargetName="fill" Property="Background" Value="{StaticResource Accent}"/>
                                                        <Setter TargetName="city" Property="Foreground" Value="{StaticResource Text}"/>
                                                        <Setter TargetName="city" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="RegionsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="RegionsEmptyTitle" Text="Loading regions…" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RegionsEmptyText" Text="Getting the region list from Valve. A few seconds." Foreground="{StaticResource Muted}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 10 Nov: once, what the phone adds (every new user used Regions, none plugged in a phone) -->
                                <Border x:Name="RegionsPitch" Margin="0,10,0,0" Padding="12,8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0" CornerRadius="0,6,6,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static local:Texts.RegionsPitch}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource Primary}" Click="RegionsPitchSetup_Click" Content="{x:Static local:Texts.RegionsPitchSetup}"/>
                                            <Button Margin="0" Click="RegionsPitchHide_Click" Content="{x:Static local:Texts.RegionsPitchHide}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,14,0,0">
                                    <Border x:Name="RegionsWarningNote" ToolTipService.ShowDuration="30000"
                                            ToolTip="Changes apply at once, but CS2 only reads the regions when it starts, so a CS2 that is already open keeps the old ones until you restart it.&#x0A;Allowing too few regions can mean long queues or no match at all, and Premier can take longer.&#x0A;Only cs2.exe is blocked, and only from Valve's relays. Steam, friends and community servers are not touched.&#x0A;Valve can still send a match to a blocked region through a relay you allow.">
                                        <Expander x:Name="RegionsWarningFold" Style="{StaticResource FoldLine}">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <Border Width="16" Height="16" CornerRadius="8" BorderBrush="{StaticResource Warn}" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,0,10,0">
                                                        <TextBlock Text="!" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock x:Name="RegionsWarning" TextWrapping="Wrap" Text="If CS2 is open, restart it after changing regions."/>
                                                </DockPanel>
                                            </Expander.Header>
                                            <StackPanel TextElement.FontSize="12">
                                                <TextBlock x:Name="RegionsWarningMore" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                           Text="Never change them during a match. Allowing too few regions means long queues or no match."/>
                                                <!-- What the rule does now, and that it stays after the app closes (24 Nov); open by itself when it failed -->
                                                <TextBlock x:Name="RegionsRule" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                    <Expander x:Name="RegionsTipFold" Style="{StaticResource FoldLine}" Margin="0,2,0,0" Visibility="{Binding Visibility, ElementName=RegionsMaxPingHint}">
                                        <Expander.Header>
                                            <DockPanel>
                                                <Border Width="16" Height="16" CornerRadius="8" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,0,10,0">
                                                    <TextBlock Text="i" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="RegionsMaxPingHead" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                            </DockPanel>
                                        </Expander.Header>
                                        <TextBlock x:Name="RegionsMaxPingHint" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right: the dial, as big as the room, 576 px in the 1240 x 800 window -->
                        <local:RegionDial x:Name="RegionDialView" Grid.Row="2" Grid.Column="2" Margin="0,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Limit="{Binding Value, ElementName=RegionsMaxPing}"/>
                    </Grid>

                    <!-- ======================================== Page: Accounts -->
                    <!-- 26 Nov (App v3 design "Accounts"): no group boxes. The title and "8 of 8 · 2 banned · nightfall in use"; on
                         the right On login with its three boxes and Add, whose arrow holds the rest (what New IP + next account does, and the
                         button itself, which is also in the top bar); then search, the filters in a capsule, cards or rows, the order and
                         Refresh; then the cards, four to a row -->
                    <Grid x:Name="PageAccounts" Grid.Row="1" Margin="24,16,24,0" Visibility="Collapsed" local:Look.Round="True" TextElement.FontSize="13">
                        <Grid.Resources>
                            <!-- a filter: a 24 px tab rounded 12; the one picked in Surface3, SemiBold and Text (as the Tabs style) -->
                            <Style x:Key="AccFilter" TargetType="RadioButton">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="GroupName" Value="accf"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="b" Background="Transparent" Height="24" Padding="12,0" CornerRadius="12">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- Cards or rows: one button in a capsule with both pictures; the view shown sits in Surface3. The code puts the
                                 other view's glyph in Content (E8FD = rows next, so cards are shown) -->
                            <Style x:Key="AccViewSwitch" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="rows" Width="30" Height="24" CornerRadius="12" Background="Transparent">
                                                        <StackPanel Width="12" VerticalAlignment="Center">
                                                            <Border x:Name="r1" Height="1.5" Background="{StaticResource Muted}"/>
                                                            <Border x:Name="r2" Height="1.5" Margin="0,2.5,0,0" Background="{StaticResource Muted}"/>
                                                            <Border x:Name="r3" Height="1.5" Margin="0,2.5,0,0" Background="{StaticResource Muted}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="cards" Width="30" Height="24" CornerRadius="12" Background="{StaticResource Surface3}">
                                                        <UniformGrid x:Name="grid" Columns="2" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Border Margin="0,0,1,1" CornerRadius="1" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                            <Border Margin="1,0,0,1" CornerRadius="1" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                            <Border Margin="0,1,1,0" CornerRadius="1" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                            <Border Margin="1,1,0,0" CornerRadius="1" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        </UniformGrid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Content" Value="&#xE80A;">
                                                    <Setter TargetName="rows" Property="Background" Value="{StaticResource Surface3}"/>
                                                    <Setter TargetName="cards" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="r1" Property="Background" Value="{StaticResource Text}"/>
                                                    <Setter TargetName="r2" Property="Background" Value="{StaticResource Text}"/>
                                                    <Setter TargetName="r3" Property="Background" Value="{StaticResource Text}"/>
                                                    <Setter Property="Tag" Value="{StaticResource Muted}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Tag" Value="{StaticResource Text}"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- title | On login and Add -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Accounts" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" LineHeight="26.4" LineStackingStrategy="BlockLineHeight"/>
                                    <Button Style="{StaticResource PageSettingsLink}" Tag="accounts" Content="Settings for this page" Click="PageSettingsLink_Click"
                                            ToolTip="New IP + next account, its hotkey, the Steam API key and hiding usernames"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" TextElement.FontSize="12.5" TextElement.Foreground="{StaticResource Muted}">
                                    <TextBlock x:Name="AccCount"/>
                                    <TextBlock x:Name="AccInUse"/>
                                    <!-- 26 nov. (critics): Refresh's "Checking 1/4…" goes here, so Refresh keeps its width and the filters stay on one line -->
                                    <TextBlock x:Name="AccChecking"/>
                                </StackPanel>
                            </StackPanel>
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                <TextBlock Text="On login" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <CheckBox x:Name="OptCs2" Style="{StaticResource Check}" Content="Open CS2" Margin="0,0,14,0" Click="AccOpt_Click" VerticalAlignment="Center"
                                          ToolTip="After logging in, Steam opens CS2 right away. New IP + next account opens CS2 whatever this is set to, when it logs in to another account or rejoins."/>
                                <CheckBox x:Name="OptSilent" Style="{StaticResource Check}" Content="Start Steam minimized" Margin="0,0,14,0" Click="AccOpt_Click" VerticalAlignment="Center"
                                          ToolTip="Steam starts in the tray, without opening its window"/>
                                <CheckBox x:Name="OptOffline" Style="{StaticResource Check}" Content="Offline mode" Margin="0,0,14,0" Click="AccOpt_Click" VerticalAlignment="Center"
                                          ToolTip="Steam starts in offline mode when you log in. You cannot join online servers or matchmaking while it is on."/>
                                <Border Width="1" Height="18" Background="{StaticResource LineStrong}" Margin="0,0,14,0" VerticalAlignment="Center" Opacity="0.7"/>
                                <!-- Add, split: the word opens the Steam login, the arrow the rest -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="AccAdd_Click" Content="Add" Margin="0" Padding="14,0,12,0"
                                            ToolTip="Opens the Steam login. Log in with the new account and tick 'Remember me'.">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Height="28" Background="Transparent" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="14,0,0,14"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.FontSize="12"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource InfoSoft}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <ToggleButton x:Name="AccAddMore" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="More"
                                                  ToolTip="Choose what New IP + next account does">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="b" Width="30" Height="28" Background="Transparent" BorderBrush="{StaticResource LineStrong}" BorderThickness="0,1,1,1" CornerRadius="0,14,14,0">
                                                    <Path x:Name="chev" Data="M 0.5,0.5 L 4,4 L 7.5,0.5" Stroke="{StaticResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource InfoSoft}"/>
                                                        <Setter TargetName="chev" Property="Stroke" Value="{StaticResource Text}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="chev" Property="Data" Value="M 0.5,4 L 4,0.5 L 7.5,4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=AccAddMore, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AccAddMore}" Placement="Bottom"
                                           HorizontalOffset="-220" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" Padding="12" local:Look.Round="True"
                                                ButtonBase.Click="AccAddMore_Picked">
                                            <StackPanel>
                                                <Button x:Name="QuickBtn" Margin="0,0,0,8" HorizontalAlignment="Left" Click="Quick_Click" Content="New IP + next account"
                                                        ToolTip="New IP + next account (its hotkey works in game too): new IP, next account, back to the last server."/>
                                                <Button Style="{StaticResource LinkBtn}" Margin="-8,0,0,0" HorizontalAlignment="Left" Click="SwitchSteps_Click"
                                                        Content="Choose what New IP + next account does" ToolTip="Choose what New IP + next account does"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </WrapPanel>
                        </Grid>

                        <!-- search | filters | cards or rows, the order, Refresh. At the minimum width (1020) the filters go onto two lines
                             inside their capsule instead of pushing Refresh and Show hidden off the page -->
                        <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="True">
                            <TextBox x:Name="AccSearch" DockPanel.Dock="Left" Width="200" Style="{StaticResource FieldBox}" Tag="Search accounts" TextChanged="AccFilter_Changed" VerticalAlignment="Top"
                                     ToolTip="Name, username, SteamID, notes and tags"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                <Button x:Name="AccViewBtn" Style="{StaticResource AccViewSwitch}" Click="AccView_Click" Content="&#xE8FD;" Margin="0,0,10,0" ToolTip="Show as rows: more accounts at once"/>
                                <ComboBox x:Name="AccSort" Style="{StaticResource FieldCombo}" Width="140" SelectionChanged="AccFilter_Changed" ToolTip="Order (favorites always come first)">
                                    <ComboBoxItem Content="Most recent" Tag="recent"/>
                                    <ComboBoxItem Content="Ready first" Tag="ready" ToolTip="Ready to use, then the cooldown that ends first, banned last"/>
                                    <ComboBoxItem Content="Name" Tag="name"/>
                                    <ComboBoxItem Content="No Steam bans first" Tag="clean"/>
                                    <ComboBoxItem Content="Most CS2 hours" Tag="hours"/>
                                </ComboBox>
                                <Button x:Name="AccRefreshBtn" Style="{StaticResource LinkBtn}" Margin="10,0,0,0" Click="AccRefresh_Click"
                                        ToolTip="Visits each account's public profile to fetch avatar, name, bans, level and hours. One per second so Steam does not block you.">
                                    <TextBlock x:Name="AccRefreshText" Text="Refresh"/>
                                </Button>
                                <Button x:Name="AccUnhideBtn" Click="ShowHidden_Click" Style="{StaticResource LinkBtn}" Margin="2,0,0,0" Visibility="Collapsed" Content="Show hidden" ToolTip="Shows the hidden accounts on the list, dimmed. They stay out of the rotation. Right-click one > Show in list to keep it."/>
                            </StackPanel>
                            <Border Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Padding="2">
                                <WrapPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FAll" Style="{StaticResource AccFilter}" Content="All" IsChecked="True" Checked="AccFilter_Changed"/>
                                    <RadioButton x:Name="FReady" Style="{StaticResource AccFilter}" Content="Ready" Checked="AccFilter_Changed"
                                                 ToolTip="Accounts New IP + next account can use now: in rotation, no cooldown, no VAC or game ban"/>
                                    <RadioButton x:Name="FFav" Style="{StaticResource AccFilter}" Content="Favorites" Checked="AccFilter_Changed"/>
                                    <RadioButton x:Name="FClean" Style="{StaticResource AccFilter}" Content="No bans" Checked="AccFilter_Changed"
                                                 ToolTip="No Steam bans. Server bans are separate."/>
                                    <RadioButton x:Name="FBan" Style="{StaticResource AccFilter}" Content="Banned" Checked="AccFilter_Changed"/>
                                    <RadioButton x:Name="FCool" Style="{StaticResource AccFilter}" Content="Cooldown" Checked="AccFilter_Changed"/>
                                    <RadioButton x:Name="FOut" Style="{StaticResource AccFilter}" Content="Not in rotation" Checked="AccFilter_Changed"
                                                 ToolTip="Accounts New IP + next account never picks"/>
                                </WrapPanel>
                            </Border>
                        </DockPanel>

                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- From 12 accounts, while no view was picked: rows show more at once (4 nov.) -->
                                        <Border x:Name="AccRowsHint" Padding="12,8" Margin="0,0,0,12" CornerRadius="8" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" Visibility="Collapsed">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Click="AccView_Click" Tag="cards" Content="Keep cards" Margin="8,0,0,0"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="AccView_Click" Tag="rows" Content="Show as rows" Margin="0"/>
                                                <TextBlock Text="Many accounts? Rows put each account on one line, so bans, cooldowns and who is in rotation line up. The button next to the order switches back any time."
                                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </DockPanel>
                                        </Border>
                                        <ItemsControl x:Name="AccountsPanel" ItemTemplate="{StaticResource AccountCard}" ItemsPanel="{StaticResource AccCardsPanel}"
                                                      SizeChanged="AccountsPanel_SizeChanged" Margin="0,0,-12,6"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel x:Name="AccountsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="No accounts yet" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AccountsEmptyText" Text="No saved accounts found in Steam on this PC." Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,4,0,12"/>
                                    <Button Style="{StaticResource Primary}" Click="AccAdd_Click" Content="Add account" HorizontalAlignment="Center" Margin="0"/>
                                </StackPanel>
                            </Grid>
                    </Grid>

                    <!-- ======================================== Page: Configs (MainWindow.Configs.cs) -->
                    <!-- 26 Nov (App v4, p5): the account list is the page (crosshair, summary, last change, sync status and Gets sync per
                         account). Sync is one line under the title; a click on it opens its menu (the four modes, When, What it copies, Sync
                         now, Undo last sync). Copy config… and Compare open side panels; Backups and snapshots fold under the list -->
                    <Grid x:Name="PageConfigs" Grid.Row="1" Visibility="Collapsed" local:Look.Round="True">
                        <Grid.Resources>
                            <!-- The colours of App v4 that the theme has no brush for: the "·" between parts, the crosshair's box, the Sync
                                 menu, the side panels and the dim over the page behind them -->
                            <SolidColorBrush x:Key="CfgSep" Color="#58585D"/>
                            <SolidColorBrush x:Key="CfgXhBg" Color="#0A0A0B"/>
                            <SolidColorBrush x:Key="CfgMenuBg" Color="#151517"/>
                            <SolidColorBrush x:Key="CfgMenuEdge" Color="#1AFFFFFF"/>
                            <SolidColorBrush x:Key="CfgPanelBg" Color="#121213"/>
                            <SolidColorBrush x:Key="CfgPanelEdge" Color="#14FFFFFF"/>
                            <SolidColorBrush x:Key="CfgDimBrush" Color="#8C070708"/>
                            <!-- An account or snapshot in a picker: an 18 px letter box rounded 6 (Lift, 8 px SemiBold Muted), 8 px to the name -->
                            <DataTemplate x:Key="CfgSourceTemplate">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="18" Height="18" Margin="0,0,8,0">
                                        <Border Background="{StaticResource Lift}" CornerRadius="6">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsAccount, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="9" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSnapshot, Converter={StaticResource Vis}}"/>
                                            </Grid>
                                        </Border>
                                        <Border CornerRadius="6" Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                            <!-- A section title: 14 px SemiBold, Display, on a 28 px line -->
                            <Style x:Key="CfgHead" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <!-- A row's label: 12 px Muted in a 96 px column, 10 px to the field -->
                            <Style x:Key="CfgLabel" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="Width" Value="96"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="CfgNote" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="LineHeight" Value="16.8"/>
                                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                            </Style>
                            <!-- A section under another: a hairline above, 18 px before it, 14 px after it -->
                            <Style x:Key="CfgSection" TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                <Setter Property="Margin" Value="0,18,0,0"/>
                                <Setter Property="Padding" Value="0,14,0,0"/>
                            </Style>
                            <!-- A sync mode in the Sync menu: a 14 px round radio, 12 px to the text, 7 and 10 px in, rounded 8; the one picked
                                 (and the one under the pointer) on Surface2, its ring 4 px thick in the accent -->
                            <Style x:Key="CfgMode" TargetType="RadioButton">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="10,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="ring" Width="14" Height="14" Stroke="{StaticResource RouteOff}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    <ContentPresenter Grid.Column="1" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                                                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Muted}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                                                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="ring" Property="StrokeThickness" Value="4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="CfgModeTitle" TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="LineHeight" Value="18.2"/>
                                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                            </Style>
                            <Style x:Key="CfgModeSub" TargetType="TextBlock" BasedOn="{StaticResource CfgNote}">
                                <Setter Property="Margin" Value="0,1,0,0"/>
                            </Style>
                            <!-- Backups and snapshots (and Snapshots inside it): a 42 px line (MinHeight sets it), 8 px in, rounded 6, Surface
                                 under the pointer; the chevron first (right, down when open), 10 px, then the header -->
                            <Style x:Key="CfgFold" TargetType="Expander">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Expander">
                                            <StackPanel>
                                                <ToggleButton Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                                              Height="{TemplateBinding MinHeight}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="8,0">
                                                                <Grid>
                                                                    <!-- 26 nov. (critics): the chevron on the right of the title's line, down when
                                                                         folded and up when open, like How it works on Connection (NetFold) -->
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                    <Path x:Name="chev" Grid.Column="1" Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5" Width="7"
                                                                          VerticalAlignment="Center" Margin="10,0,1,0"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="chev" Property="Data" Value="M 0,3.5 L 3.5,0 L 7,3.5"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource Surface}"/>
                                                                    <Setter TargetName="chev" Property="Stroke" Value="{StaticResource Text}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                    <ContentPresenter Content="{TemplateBinding Header}" TextElement.FontFamily="{StaticResource DisplayFont}"
                                                                      TextElement.FontSize="14" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Text}"/>
                                                </ToggleButton>
                                                <ContentPresenter x:Name="body" Margin="0,2,0,0" Visibility="Collapsed"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- The crosshair's box (36 px in the list and Compare, 28 under From, 20 under To; the parent sets it): rounded 6,
                                 #0A0910 with the hairline -->
                            <Style x:Key="XhBox" TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Background" Value="{StaticResource CfgXhBg}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                            <!-- The list's column titles: 12 px Faint -->
                            <Style x:Key="CfgColHead" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <!-- A title inside a side panel or the Sync menu: 12 px SemiBold Info -->
                            <Style x:Key="CfgPanelHead" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource Info}"/>
                            </Style>
                            <!-- An account's row: 54 px, 8 px in, the hairline above, Surface under the pointer -->
                            <Style x:Key="CfgRowBox" TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="MinHeight" Value="54"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <!-- Gets sync: the switch of Settings (32 x 18; on in the accent with a dark 12 px knob, off a RouteOff ring with a
                                 Muted 10 px knob), on its own without the option's line -->
                            <Style x:Key="CfgSwitch" TargetType="CheckBox">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Grid Width="32" Height="18" Background="Transparent">
                                                <Border x:Name="track" CornerRadius="9" BorderBrush="{StaticResource RouteOff}" BorderThickness="1.5" Background="Transparent"/>
                                                <Ellipse x:Name="knob" Width="10" Height="10" Fill="{StaticResource Muted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="track" Property="BorderThickness" Value="0"/>
                                                    <Setter TargetName="knob" Property="Fill" Value="{StaticResource AccentText}"/>
                                                    <Setter TargetName="knob" Property="Width" Value="12"/>
                                                    <Setter TargetName="knob" Property="Height" Value="12"/>
                                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsChecked" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Muted}"/>
                                                </MultiTrigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="track" Property="Background" Value="{StaticResource AccentHover}"/>
                                                </MultiTrigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </Trigger>
                                                <!-- Tag paused (Sync off for the page, 26 nov.): the off look whatever it holds -->
                                                <Trigger Property="Tag" Value="paused">
                                                    <Setter TargetName="track" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource RouteOff}"/>
                                                    <Setter TargetName="track" Property="BorderThickness" Value="1.5"/>
                                                    <Setter TargetName="knob" Property="Fill" Value="{StaticResource Muted}"/>
                                                    <Setter TargetName="knob" Property="Width" Value="10"/>
                                                    <Setter TargetName="knob" Property="Height" Value="10"/>
                                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter TargetName="knob" Property="Margin" Value="4,0,0,0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- More (…) and Close (×): a 28 px square rounded 6, the white at 6 % under the pointer -->
                            <Style x:Key="CfgSq" TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource InfoSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- The Sync line: 26 px, 8 px in (and 8 px out to the left, so its text lines up with the title), rounded 6, Field
                                 under the pointer and while its menu is open -->
                            <Style x:Key="CfgSyncToggle" TargetType="ToggleButton">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="-8,0,0,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="b" Height="26" Padding="8,0" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Field}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Field}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- An account's letter: 28 px rounded 6, Lift, 12 px SemiBold Muted; the Steam picture over it -->
                            <Style x:Key="CfgLetter" TargetType="Border">
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Background" Value="{StaticResource Lift}"/>
                            </Style>
                        </Grid.Resources>
                        <ScrollViewer x:Name="CfgScroll" Padding="24,16,24,18" VerticalScrollBarVisibility="Auto">
                            <StackPanel TextElement.FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Configs" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" LineHeight="26.4" LineStackingStrategy="BlockLineHeight"/>
                                    <Button Style="{StaticResource PageSettingsLink}" Tag="configs" Content="Settings for this page" Click="PageSettingsLink_Click"
                                            ToolTip="CS2's launch options and the programs that open with CS2"/>
                                </StackPanel>
                                <!-- App v3's line under the title ("8 accounts · sync from main account nightfall"): the Sync line and the count
                                     above the list say both now, so it stays filled in but out of view -->
                                <TextBlock x:Name="CfgSummary" Visibility="Collapsed"/>

                                <!-- Sync: "Sync: from main account nightfall ⌄ · last run 6 Nov 16:00 2 copied, 3 already the same" (MainWindow.Configs.cs
                                     fills the mode and the last run); a click opens the menu with everything the Sync box had -->
                                <Grid HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <ToggleButton x:Name="CfgSyncBtn" Style="{StaticResource CfgSyncToggle}" AutomationProperties.Name="Sync"
                                                  ToolTip="How the app copies configs between your accounts on its own">
                                        <StackPanel Orientation="Horizontal" TextElement.FontSize="12.5">
                                            <!-- "Sync" on its own: the texts that say Configs > Sync > When point here (OrganizacaoTests 7) -->
                                            <TextBlock Text="Sync" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text=":" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CfgSyncMode" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <Path Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="8,1,6,0"/>
                                            <TextBlock Text="·" Foreground="{StaticResource CfgSep}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CfgSyncLast" Foreground="{StaticResource Faint}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Popup x:Name="CfgSyncMenu" IsOpen="{Binding IsChecked, ElementName=CfgSyncBtn, Mode=TwoWay}" PlacementTarget="{Binding ElementName=CfgSyncBtn}"
                                           Placement="Bottom" HorizontalOffset="-24" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                                        <Border Margin="24,0,24,48" Width="540" Padding="14,14,14,12" CornerRadius="10" Background="{StaticResource CfgMenuBg}"
                                                BorderBrush="{StaticResource CfgMenuEdge}" BorderThickness="1" local:Look.Round="True"
                                                TextElement.FontSize="13" TextElement.Foreground="{StaticResource Text}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="48" ShadowDepth="18" Direction="270" Opacity="0.55" Color="Black"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Margin="10,0" Style="{StaticResource CfgNote}" Foreground="{StaticResource Muted}"
                                                           Text="Copies CS2 settings between your accounts on its own. Never while CS2 is open, and a backup is saved first."/>
                                                <StackPanel Margin="0,10,0,0">
                                                    <RadioButton x:Name="CfgModeOff" Style="{StaticResource CfgMode}" GroupName="cfgmode" Tag="off" Checked="CfgMode_Checked">
                                                        <StackPanel>
                                                            <TextBlock Text="Off" Style="{StaticResource CfgModeTitle}"/>
                                                            <TextBlock Text="Nothing copies on its own. Copy config… still works." Style="{StaticResource CfgModeSub}"/>
                                                        </StackPanel>
                                                    </RadioButton>
                                                    <!-- The main account's picker sits on its option's title line, only while that option is picked -->
                                                    <RadioButton x:Name="CfgModeMain" Style="{StaticResource CfgMode}" GroupName="cfgmode" Tag="main" Checked="CfgMode_Checked">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" MinHeight="20">
                                                                <TextBlock Text="From a main account" Style="{StaticResource CfgModeTitle}" VerticalAlignment="Center"/>
                                                                <ComboBox x:Name="CfgMainBox" Style="{StaticResource FieldCombo}" Width="170" Height="24" MinHeight="24" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                          ItemTemplate="{StaticResource CfgSourceTemplate}" SelectionChanged="CfgMain_Changed" ToolTip="The account the others copy from"/>
                                                            </StackPanel>
                                                            <TextBlock Text="New accounts and every login through the app get its config." Style="{StaticResource CfgModeSub}"/>
                                                        </StackPanel>
                                                    </RadioButton>
                                                    <RadioButton x:Name="CfgModePrevious" Style="{StaticResource CfgMode}" GroupName="cfgmode" Tag="previous" Checked="CfgMode_Checked">
                                                        <StackPanel>
                                                            <TextBlock Text="From the previous account" Style="{StaticResource CfgModeTitle}"/>
                                                            <TextBlock Text="When you log in through the app, the new account gets the config of the one you were on." Style="{StaticResource CfgModeSub}"/>
                                                        </StackPanel>
                                                    </RadioButton>
                                                    <RadioButton x:Name="CfgModeLatest" Style="{StaticResource CfgMode}" GroupName="cfgmode" Tag="latest" Checked="CfgMode_Checked" Margin="0">
                                                        <StackPanel>
                                                            <TextBlock Text="From the account changed last" Style="{StaticResource CfgModeTitle}"/>
                                                            <TextBlock Text="When CS2 closes, the account you changed last copies to the others." Style="{StaticResource CfgModeSub}"/>
                                                        </StackPanel>
                                                    </RadioButton>
                                                </StackPanel>
                                                <Border Margin="10,10,10,0" Padding="0,12,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock x:Name="CfgWhenLabel" Text="When" Style="{StaticResource CfgLabel}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                                            <StackPanel>
                                                                <CheckBox x:Name="CfgOnNewBox" Style="{StaticResource Check}" Content="A new account shows up on this PC" Margin="0,0,0,7" Click="CfgWhen_Click"
                                                                          HorizontalAlignment="Left"/>
                                                                <CheckBox x:Name="CfgOnLoginBox" Style="{StaticResource Check}" Content="Before the app logs in or opens CS2" Click="CfgWhen_Click" HorizontalAlignment="Left"
                                                                          ToolTip="Log in, New IP + next account, Join"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <!-- The same ticks as What to copy in Copy config… (one setting in the app for both): each is bound to its twin there -->
                                                        <DockPanel Margin="0,10,0,0">
                                                            <TextBlock Text="What it copies" Style="{StaticResource CfgLabel}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                                            <WrapPanel x:Name="CfgSyncCats">
                                                                <CheckBox Style="{StaticResource Check}" Content="Binds" Margin="0,0,14,7" Click="CfgCategory_Click"
                                                                          IsChecked="{Binding IsChecked, ElementName=CfgCatBinds, Mode=TwoWay}" ToolTip="{Binding ToolTip, ElementName=CfgCatBinds}"/>
                                                                <CheckBox Style="{StaticResource Check}" Content="Crosshair" Margin="0,0,14,7" Click="CfgCategory_Click"
                                                                          IsChecked="{Binding IsChecked, ElementName=CfgCatCrosshair, Mode=TwoWay}" ToolTip="{Binding ToolTip, ElementName=CfgCatCrosshair}"/>
                                                                <CheckBox Style="{StaticResource Check}" Content="Game settings" Margin="0,0,14,7" Click="CfgCategory_Click"
                                                                          IsChecked="{Binding IsChecked, ElementName=CfgCatGame, Mode=TwoWay}" ToolTip="{Binding ToolTip, ElementName=CfgCatGame}"/>
                                                                <CheckBox Style="{StaticResource Check}" Content="Video" Margin="0,0,14,7" Click="CfgCategory_Click"
                                                                          IsChecked="{Binding IsChecked, ElementName=CfgCatVideo, Mode=TwoWay}" ToolTip="{Binding ToolTip, ElementName=CfgCatVideo}"/>
                                                                <CheckBox Style="{StaticResource Check}" Content="HUD, radar and audio" Margin="0,0,14,7" Click="CfgCategory_Click"
                                                                          IsChecked="{Binding IsChecked, ElementName=CfgCatHud, Mode=TwoWay}" ToolTip="{Binding ToolTip, ElementName=CfgCatHud}"/>
                                                            </WrapPanel>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="10,12,10,0" Padding="0,12,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                                    <DockPanel>
                                                        <Button x:Name="CfgSyncNowBtn" Style="{StaticResource Pill}" Content="Sync now" Click="CfgSyncNow_Click" Margin="0,0,8,0"
                                                                ToolTip="Copies to every account with Sync on, from the source of the mode above"/>
                                                        <Button x:Name="CfgUndoBtn" Style="{StaticResource LinkBtn}" Content="Undo last sync" Click="CfgUndo_Click" Margin="0,0,8,0" ToolTip="Puts back the files the last sync changed"/>
                                                        <TextBlock x:Name="CfgResult" FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Search (from 8 accounts) and the count; Compare and Copy config… on the right -->
                                <DockPanel Margin="0,16,0,0" MinHeight="28">
                                    <Button x:Name="CfgCopyOpenBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryFill}" Content="Copy config…" Margin="10,0,0,0" Click="CfgCopyOpen_Click"
                                            ToolTip="Copy one account's config (or a snapshot) to other accounts, once"/>
                                    <Button x:Name="CfgCompareBtn" DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="Compare" Click="CfgCompareOpen_Click"
                                            ToolTip="Two accounts or snapshots side by side: the settings that differ"/>
                                    <!-- beta.10: from 8 accounts, a search; accounts with the same crosshair fold into one line (CfgDisplay) -->
                                    <Grid x:Name="CfgAccSearchHost" Margin="0,0,10,0" Visibility="Collapsed">
                                        <TextBox x:Name="CfgAccSearch" Style="{StaticResource FieldBox}" Width="200" Tag="Search accounts" TextChanged="CfgAccSearch_Changed" ToolTip="Name or username. While you search, every match shows on its own line."/>
                                    </Grid>
                                    <TextBlock x:Name="CfgAccCount" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock x:Name="CfgAccountsEmpty" Text="No Steam accounts on this PC yet." Style="{StaticResource CfgNote}" Margin="0,14,0,0" Visibility="Collapsed"/>
                                <!-- The columns: 22 | crosshair 40 | account | last change 220 | sync status 230 | gets sync 70 | more 28, 12 apart;
                                     the three wide ones shrink together in a narrow window -->
                                <Border Height="26" Margin="0,14,0,0" Padding="8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="326*" MinWidth="110"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="220*" MaxWidth="220"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="230*" MaxWidth="230"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="4" Text="Account" Style="{StaticResource CfgColHead}"/>
                                        <TextBlock Grid.Column="6" Text="Last change" Style="{StaticResource CfgColHead}"/>
                                        <TextBlock Grid.Column="8" Text="Sync status" Style="{StaticResource CfgColHead}"/>
                                        <TextBlock Grid.Column="10" Grid.ColumnSpan="3" Text="Gets sync" Style="{StaticResource CfgColHead}"
                                                   ToolTip="Off: the sync never touches that account's config (Copy config… still can)"/>
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="CfgAccountsList">
                                    <ItemsControl.Resources>
                                        <!-- Many accounts: the ones with the same crosshair as one line ("23 accounts with the same crosshair as nightfall"), Show opens it -->
                                        <DataTemplate DataType="{x:Type local:CfgGroupRow}">
                                            <Border Style="{StaticResource CfgRowBox}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="326*" MinWidth="110"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="220*" MaxWidth="220"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="230*" MaxWidth="230"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="2" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource XhBox}"/>
                                                        <TextBlock Text="{Binding Rows.Count}" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmptyGroup, Converter={StaticResource Vis}}"/>
                                                        <Image Source="{Binding CrosshairImage}" Width="36" Height="36" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" LineHeight="18.2" LineStackingStrategy="BlockLineHeight"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                                   LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Visibility="{Binding IsCrosshairGroup, Converter={StaticResource Vis}}"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Visibility="{Binding IsEmptyGroup, Converter={StaticResource Vis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="6" Grid.ColumnSpan="3" Text="{Binding Names}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                                               TextTrimming="CharacterEllipsis" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" ToolTip="{Binding Names}"/>
                                                    <Button Grid.Column="10" Grid.ColumnSpan="3" Style="{StaticResource LinkBtn}" Content="{Binding ToggleText}" Click="CfgGroupToggle_Click"
                                                            HorizontalAlignment="Left" Margin="-8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ToggleTip}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type local:CfgAccountRow}">
                                            <Border Style="{StaticResource CfgRowBox}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="326*" MinWidth="110"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="220*" MaxWidth="220"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="230*" MaxWidth="230"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- The crosshair (approximate preview); an account with none shows its letter -->
                                                    <Grid Grid.Column="2" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Crosshair (approximate preview)">
                                                        <Border Style="{StaticResource XhBox}"/>
                                                        <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasCrosshair}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding CrosshairImage}" Width="36" Height="36" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    </Grid>
                                                    <!-- The name (main, in use after it), the crosshair in mono under it -->
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="200" LineHeight="18.2" LineStackingStrategy="BlockLineHeight"/>
                                                            <TextBlock Text="  main" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                                       Visibility="{Binding IsMain, Converter={StaticResource Vis}}" ToolTip="The others copy from this account"/>
                                                            <TextBlock Text="  in use" Foreground="{StaticResource Good}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                                       Visibility="{Binding Active, Converter={StaticResource Vis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CrosshairText}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                                   LineHeight="16.8" LineStackingStrategy="BlockLineHeight" ToolTip="{Binding CrosshairText}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="6" Text="{Binding ChangedText}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                                               TextTrimming="CharacterEllipsis" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" ToolTip="{Binding ChangedText}"/>
                                                    <!-- Sync status: its mark and a short line (MainWindow.CfgStatus); the main account's line has no mark -->
                                                    <DockPanel Grid.Column="8" VerticalAlignment="Center">
                                                        <local:StatusMark DockPanel.Dock="Left" Brush="{Binding StatusBrush}" Margin="0,0,8,0" Visibility="{Binding HasStatusMark, Converter={StaticResource Vis}}"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMain}" Value="True"><Setter Property="Foreground" Value="{StaticResource Info}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <!-- Gets sync: the switch; the main account is the source -->
                                                    <Grid Grid.Column="10" VerticalAlignment="Center">
                                                        <CheckBox IsChecked="{Binding Sync}" Click="CfgOptOut_Click" HorizontalAlignment="Left" AutomationProperties.Name="Gets sync">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox" BasedOn="{StaticResource CfgSwitch}">
                                                                    <!-- from the row (audit 26 nov., X1): a Setter's text is translated once into a local value, which hid the paused one -->
                                                                    <Setter Property="ToolTip" Value="{Binding SyncTip}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMain}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        <!-- Sync off for the page: drawn off and dimmed, the value kept (the switch still works) -->
                                                                        <DataTrigger Binding="{Binding SyncPaused}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.4"/>
                                                                            <Setter Property="Tag" Value="paused"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                        <TextBlock Text="Source" FontSize="12" Foreground="{StaticResource Faint}" Visibility="{Binding IsMain, Converter={StaticResource Vis}}"
                                                                   ToolTip="The others copy from this account"/>
                                                    </Grid>
                                                    <Button Grid.Column="12" Style="{StaticResource CfgSq}" Click="CfgMore_Click" ToolTip="More" AutomationProperties.Name="More" VerticalAlignment="Center">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Copy config from this account…" Tag="&#xE8C8;" Click="CfgRowCopy_Click"/>
                                                                <MenuItem Header="Compare with another account" Tag="&#xE8B9;" Click="CfgRowCompare_Click"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="3" Height="3" Fill="{StaticResource Muted}"/>
                                                            <Ellipse Width="3" Height="3" Fill="{StaticResource Muted}" Margin="3,0"/>
                                                            <Ellipse Width="3" Height="3" Fill="{StaticResource Muted}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>

                                <!-- Backups and snapshots, folded: the backups first, then Snapshots folded inside -->
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,6,0,0">
                                    <Expander Style="{StaticResource CfgFold}" AutomationProperties.Name="Backups and snapshots">
                                        <Expander.Header>
                                            <DockPanel>
                                                <TextBlock Text="Backups and snapshots" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Text="Saved before the app changes an account's files. The 20 newest per account are kept, and the first one (Original) for good."/>
                                            </DockPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="8,0,8,4">
                                            <!-- Opened: Backups (where "Configs > Backups" points), then Snapshots folded -->
                                            <TextBlock Text="Backups" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="CfgBackupEmpty" Text="No backups yet." Style="{StaticResource CfgNote}" Margin="0,0,0,6"/>
                                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="CfgBackupList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,0,0,6" TextElement.FontSize="12">
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="Restore" Click="CfgRestore_Click" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Restore these files"/>
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11.5" VerticalAlignment="Center"/>
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Account}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MinWidth="70" MaxWidth="150" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Expander Style="{StaticResource CfgFold}" MinHeight="36" Margin="-8,2,0,0" AutomationProperties.Name="Snapshots">
                                                <Expander.Header>
                                                    <TextBlock Text="Snapshots" FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold"/>
                                                </Expander.Header>
                                                <StackPanel Margin="8,0,0,4">
                                                    <DockPanel MinHeight="30">
                                                        <TextBlock Text="From" Style="{StaticResource CfgLabel}"/>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                            <Button x:Name="CfgSnapSaveBtn" Style="{StaticResource Pill}" Content="Save snapshot" Click="CfgSnapSave_Click" Margin="0,0,6,0" ToolTip="Saves this account's config under a name (Main, Practice…)"/>
                                                            <Button Style="{StaticResource LinkBtn}" Content="Import" Click="CfgSnapImport_Click" ToolTip="A snapshot .zip exported on this or another PC"/>
                                                        </StackPanel>
                                                        <ComboBox x:Name="CfgSnapFrom" Style="{StaticResource FieldCombo}" ItemTemplate="{StaticResource CfgSourceTemplate}" ToolTip="The account to save"/>
                                                    </DockPanel>
                                                    <TextBlock x:Name="CfgSnapEmpty" Text="No snapshots yet. Save one to keep a config, or to take it to another PC." Style="{StaticResource CfgNote}" Margin="0,6,0,0"/>
                                                    <ItemsControl x:Name="CfgSnapList" Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                            <DockPanel Margin="0,1,0,0">
                                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11.5"/>
                                                                                <TextBlock Text="{Binding What}" Foreground="{StaticResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                                            </DockPanel>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Click="CfgSnapUse_Click" ToolTip="Copy it to accounts (opens Copy config…)"/>
                                                                            <Button Style="{StaticResource IconBtn}" Content="&#xE72D;" Click="CfgSnapExport_Click" ToolTip="Export as .zip"/>
                                                                            <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Click="CfgSnapDelete_Click" ToolTip="Delete snapshot"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- The side panels: the page dimmed under them, a click on it closes them -->
                        <Border x:Name="CfgDim" Background="{StaticResource CfgDimBrush}" Visibility="Collapsed" MouseLeftButtonDown="CfgDim_MouseDown"/>

                        <!-- Copy config…: From, To and What to copy, a one-time copy; Copy to N accounts is the panel's one filled button -->
                        <Grid x:Name="CfgCopyPanel" Width="440" HorizontalAlignment="Right" Visibility="Collapsed" TextElement.FontSize="13">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Background="{StaticResource CfgPanelBg}" BorderBrush="{StaticResource CfgPanelEdge}" BorderThickness="1,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="48" ShadowDepth="24" Direction="180" Opacity="0.45" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <StackPanel Margin="20,16,20,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CfgSq}" Click="CfgPanelClose_Click" ToolTip="Close" AutomationProperties.Name="Close">
                                        <Path Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/>
                                    </Button>
                                    <TextBlock Text="Copy config" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="A one-time copy. Automatic sync is set on the Sync line."/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Padding="20,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CfgCopyGroup">
                                    <TextBlock Text="From" Style="{StaticResource CfgPanelHead}"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0">
                                            <Border Style="{StaticResource XhBox}" CornerRadius="4"/>
                                            <Image x:Name="CfgFromXh" Width="28" Height="28" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Grid>
                                        <ComboBox x:Name="CfgFromBox" Style="{StaticResource FieldCombo}" ItemTemplate="{StaticResource CfgSourceTemplate}" ToolTip="An account or a snapshot" SelectionChanged="CfgFrom_Changed"/>
                                    </DockPanel>
                                    <TextBlock x:Name="CfgFromXhText" Margin="38,4,0,0" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>

                                    <!-- beta.10: with 30 accounts the ticks were a wall. A filter, the count, and one line per account that scrolls -->
                                    <DockPanel Margin="0,18,0,0" MinHeight="24">
                                        <Button x:Name="CfgToNoneBtn" DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Content="None" Height="24" MinHeight="24" Click="CfgToNone_Click" ToolTip="Unticks every account, also the ones the search hides"/>
                                        <Button x:Name="CfgToAllBtn" DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Content="All" Height="24" MinHeight="24" Click="CfgToAll_Click" ToolTip="Ticks every account shown, except the one you copy from"/>
                                        <TextBlock Text="To" Style="{StaticResource CfgPanelHead}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CfgToCount" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" Text="None ticked"/>
                                    </DockPanel>
                                    <TextBox x:Name="CfgToSearch" Style="{StaticResource FieldBox}" Margin="0,6,0,0" Tag="Filter accounts" TextChanged="CfgToSearch_Changed" ToolTip="Name or username. All ticks only the accounts shown."/>
                                    <ItemsControl x:Name="CfgToList" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="32" Padding="6,0" CornerRadius="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Field}"/></Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected}" ToolTip="{Binding Name}">
                                                        <DockPanel Margin="2,0,0,0">
                                                            <Grid DockPanel.Dock="Left" Width="20" Height="20">
                                                                <Border Style="{StaticResource XhBox}" CornerRadius="4"/>
                                                                <Image Source="{Binding CrosshairSmall}" Width="20" Height="20" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                            </Grid>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="70" Margin="10,0,10,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CrosshairText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="What to copy" Style="{StaticResource CfgPanelHead}" Margin="0,18,0,0"/>
                                    <WrapPanel x:Name="CfgCats" Margin="0,8,0,0">
                                        <CheckBox x:Name="CfgCatBinds" Style="{StaticResource Check}" Tag="binds" Content="Binds" Margin="0,0,14,8" Click="CfgCategory_Click"
                                                  ToolTip="Every key bind (cs2_user_keys)"/>
                                        <CheckBox x:Name="CfgCatCrosshair" Style="{StaticResource Check}" Tag="crosshair" Content="Crosshair" Margin="0,0,14,8" Click="CfgCategory_Click"
                                                  ToolTip="Only the crosshair settings; the rest of the game settings stay"/>
                                        <CheckBox x:Name="CfgCatGame" Style="{StaticResource Check}" Tag="game" Content="Game settings" Margin="0,0,14,8" Click="CfgCategory_Click"
                                                  ToolTip="Sensitivity, viewmodel and the other game settings, without the crosshair (cs2_user_convars)"/>
                                        <CheckBox x:Name="CfgCatVideo" Style="{StaticResource Check}" Tag="video" Content="Video" Margin="0,0,14,8" Click="CfgCategory_Click"
                                                  ToolTip="Resolution, display mode and graphics (cs2_video.txt)"/>
                                        <CheckBox x:Name="CfgCatHud" Style="{StaticResource Check}" Tag="hud" Content="HUD, radar and audio" Margin="0,0,14,8" Click="CfgCategory_Click"
                                                  ToolTip="HUD color and scale, radar, volumes, max FPS, brightness (cs2_machine_convars)"/>
                                    </WrapPanel>
                                    <TextBlock Text="Sync uses the same ticks." Style="{StaticResource CfgNote}" Margin="0,-2,0,16"/>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
                                <DockPanel>
                                    <Button x:Name="CfgCopyBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryFill}" Content="Copy" Click="CfgCopy_Click" Margin="8,0,0,0"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Content="Cancel" Click="CfgPanelClose_Click" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="CfgCopyHint" Style="{StaticResource CfgNote}" VerticalAlignment="Center"
                                               Text="Each account gets a backup first (Configs > Backups)."/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Compare: two accounts or snapshots, their crosshairs and the settings that differ -->
                        <Grid x:Name="CfgComparePanel" Width="460" HorizontalAlignment="Right" Visibility="Collapsed" TextElement.FontSize="13">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="5" Background="{StaticResource CfgPanelBg}" BorderBrush="{StaticResource CfgPanelEdge}" BorderThickness="1,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="48" ShadowDepth="24" Direction="180" Opacity="0.45" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <DockPanel Margin="20,16,20,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource CfgSq}" Click="CfgPanelClose_Click" ToolTip="Close" AutomationProperties.Name="Close">
                                    <Path Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/>
                                </Button>
                                <TextBlock Text="Compare" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="20,12,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CfgCmpA" Style="{StaticResource FieldCombo}" ItemTemplate="{StaticResource CfgSourceTemplate}" SelectionChanged="CfgCompare_Changed"/>
                                <TextBlock Grid.Column="1" Text="vs" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0"/>
                                <ComboBox x:Name="CfgCmpB" Grid.Column="2" Style="{StaticResource FieldCombo}" ItemTemplate="{StaticResource CfgSourceTemplate}" SelectionChanged="CfgCompare_Changed"/>
                            </Grid>
                            <!-- Image in Border in DockPanel in Grid: UpdateCompare hides a side's box and the whole line through these parents -->
                            <Grid Grid.Row="2" Margin="20,12,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource XhBox}" Width="36" Height="36" VerticalAlignment="Center" ToolTip="Crosshair (approximate preview)">
                                        <Image x:Name="CfgCmpImgA" Width="36" Height="36" Margin="-1" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <TextBlock x:Name="CfgCmpXhA" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Margin="10,0,0,0"/>
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource XhBox}" Width="36" Height="36" VerticalAlignment="Center" ToolTip="Crosshair (approximate preview)">
                                        <Image x:Name="CfgCmpImgB" Width="36" Height="36" Margin="-1" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <TextBlock x:Name="CfgCmpXhB" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Margin="10,0,0,0"/>
                                </DockPanel>
                            </Grid>
                            <TextBlock x:Name="CfgDiffCount" Grid.Row="3" FontSize="12" Foreground="{StaticResource Muted}" Margin="20,16,20,0"/>
                            <ScrollViewer Grid.Row="4" Margin="20,6,20,16" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CfgDiffList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="28" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                                                <Grid ToolTip="{Binding Key}" TextElement.FontSize="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="96"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding CategoryText}" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding A}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Mono}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding B}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Mono}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ======================================== Page: Profiles (MainWindow.Profiles.cs) -->
                    <!-- 26 Nov (App v4, p6): three numbered steps read top to bottom. 1 The look (the template: fields, picture, privacy;
                         Copy the look of an account… fills it), 2 Accounts (who gets it, the web sign-in on each row), 3 Review and apply
                         (the fields, Now → After for the picked accounts only, Apply; Restore originals, Sign out of all and Clear name
                         history in a quiet row below) -->
                    <Grid x:Name="PageProfiles" Grid.Row="1" Visibility="Collapsed" Loaded="ProfilesPage_Loaded" SizeChanged="ProfBar_SizeChanged"
                          local:Look.Round="True" TextElement.FontSize="13">
                        <Grid.Resources>
                            <!-- The step's number: a 26 px circle, its edge white at 22 %, 12 px SemiBold Display; the line down to the next step at 8 % -->
                            <SolidColorBrush x:Key="ProfNumEdge" Color="#38FFFFFF"/>
                            <SolidColorBrush x:Key="ProfStepLine" Color="#14FFFFFF"/>
                            <Style x:Key="ProfNum" TargetType="Border">
                                <Setter Property="Width" Value="26"/>
                                <Setter Property="Height" Value="26"/>
                                <Setter Property="CornerRadius" Value="13"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ProfNumEdge}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                            </Style>
                            <Style x:Key="ProfNumText" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <!-- The step's title (16 px SemiBold Display) and its line (12 px Faint), 12 px apart -->
                            <Style x:Key="ProfStepTitle" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                            </Style>
                            <Style x:Key="ProfStepSub" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                            <!-- A row's label: 12 px Muted in a 96 px column, 10 px to the field -->
                            <Style x:Key="TplLabel" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <!-- 112, not 96 (26 nov., critics): "URL personalizada" ran up to its field -->
                                <Setter Property="Width" Value="112"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="TplRow" TargetType="DockPanel">
                                <Setter Property="MinHeight" Value="30"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                            </Style>
                            <!-- New, copy, delete: a 28 px square rounded 6 with the hairline, the glyph in Muted -->
                            <Style x:Key="TplSq" TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="6,0,0,0"/>
                                <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource InfoSoft}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- Bio: the field of FieldBox, 48 px high, the text from the top -->
                            <Style x:Key="TplArea" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                <Grid>
                                                    <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Faint}" Margin="{TemplateBinding Padding}" FontFamily="{StaticResource UiFont}"
                                                               FontSize="12.5" Padding="2,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Stretch"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- The table's titles: 12 px Faint -->
                            <Style x:Key="ProfHead" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>
                        <ScrollViewer x:Name="ProfPageScroll" Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Profiles" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" LineHeight="26.4" LineStackingStrategy="BlockLineHeight"/>
                                    <Button Style="{StaticResource PageSettingsLink}" Tag="profiles" Content="Settings for this page" Click="PageSettingsLink_Click"
                                            ToolTip="The Steam API key and hiding usernames"/>
                                </StackPanel>
                                <TextBlock Margin="0,3,0,0" FontSize="12.5" Foreground="{StaticResource Muted}" Text="Give your accounts one Steam look in three steps."/>
                                <!-- App v3's line under the title ("Template Team look · 6 of 8 accounts picked"): the steps show both now -->
                                <TextBlock x:Name="ProfSummary" Visibility="Collapsed"/>

                                <!-- ============ 1 The look -->
                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ProfNum}"><TextBlock Text="1" Style="{StaticResource ProfNumText}"/></Border>
                                    <Rectangle Width="1" Fill="{StaticResource ProfStepLine}" Margin="0,34,0,-14"/>
                                    <StackPanel Grid.Column="2" Margin="0,0,0,6">
                                        <DockPanel MinHeight="28">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock Text="Shortcut" FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Button x:Name="TplCopyBtn" Style="{StaticResource Pill}" Content="Copy the look of an account…" Click="TplCopyFrom_Click"
                                                        ToolTip="Copy from an account or any Steam profile link: its name, picture, real name, bio and country (and privacy, if you signed in to it)"/>
                                            </StackPanel>
                                            <TextBlock Text="The look" Style="{StaticResource ProfStepTitle}"/>
                                            <TextBlock Text="What every picked account will show on Steam." Style="{StaticResource ProfStepSub}"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="Template" Style="{StaticResource TplLabel}"/>
                                            <ComboBox x:Name="TplCombo" Style="{StaticResource FieldCombo}" Width="240" SelectionChanged="TplCombo_Changed" ToolTip="Your saved looks"/>
                                            <Button Style="{StaticResource TplSq}" Content="&#xE710;" Click="TplNew_Click" ToolTip="New template"/>
                                            <Button Style="{StaticResource TplSq}" Content="&#xE74D;" Click="TplDelete_Click" ToolTip="Delete this template"/>
                                        </StackPanel>
                                        <!-- The fields | the picture (150) | privacy (270), 32 apart -->
                                        <StackPanel x:Name="TplEditor" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="260"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="270"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <DockPanel Style="{StaticResource TplRow}">
                                                        <TextBlock Text="Template name" Style="{StaticResource TplLabel}"/>
                                                        <TextBox x:Name="TplTitle" Style="{StaticResource FieldBox}" Tag="E.g. Main look" TextChanged="TplField_Changed"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource TplRow}">
                                                        <TextBlock Text="Steam name" Style="{StaticResource TplLabel}"/>
                                                        <TextBox x:Name="TplName" Style="{StaticResource FieldBox}" Tag="E.g. {name} or nightfall {n}" TextChanged="TplField_Changed"
                                                                 ToolTip="{}{name} = the account's current Steam name. {n} = 1, 2, 3… in the list. Up to 32 characters. To show { or }, type {{ or }}. There is no {login} tag: showing a username on a public profile makes the account easier to steal."/>
                                                    </DockPanel>
                                                    <TextBlock Text="{}{name} = current name, {n} = 1, 2, 3…" FontSize="12" Foreground="{StaticResource Faint}" Margin="106,-2,0,6"/>
                                                    <DockPanel Style="{StaticResource TplRow}">
                                                        <TextBlock Text="Real name" Style="{StaticResource TplLabel}"/>
                                                        <TextBox x:Name="TplReal" Style="{StaticResource FieldBox}" Tag="Empty = no real name shown" TextChanged="TplField_Changed"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource TplRow}">
                                                        <TextBlock Text="Country" Style="{StaticResource TplLabel}"/>
                                                        <ComboBox x:Name="TplCountry" Style="{StaticResource FieldCombo}" SelectionChanged="TplField_Changed"/>
                                                    </DockPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock Text="Bio" Style="{StaticResource TplLabel}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                                                        <TextBox x:Name="TplSummary" Style="{StaticResource TplArea}" Tag="Empty = no bio" TextChanged="TplField_Changed"
                                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource TplRow}" Margin="0">
                                                        <TextBlock Text="Custom URL" Style="{StaticResource TplLabel}"/>
                                                        <TextBox x:Name="TplUrl" Style="{StaticResource FieldBox}" Tag="Empty = removed, e.g. nightfall{n}" TextChanged="TplField_Changed"
                                                                 ToolTip="steamcommunity.com/id/…  Each account needs its own: use {n} when you pick more than one."/>
                                                    </DockPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <!-- 26 nov. (critics): Picture and Privacy in one style, 13 px Muted -->
                                                    <TextBlock Text="Picture" FontSize="13" Foreground="{StaticResource Muted}" MinHeight="20" Margin="0,0,0,6"/>
                                                    <Grid Width="96" Height="96" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                        <Border Background="{StaticResource Lift}" CornerRadius="10">
                                                            <TextBlock Text="&#xE91B;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border x:Name="TplAvatarBox" CornerRadius="10" Visibility="Collapsed">
                                                            <Border.Background>
                                                                <ImageBrush x:Name="TplAvatar" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Style="{StaticResource Pill}" Content="Pick…" Click="TplPickAvatar_Click" Margin="0,0,4,0"
                                                                ToolTip="JPG, PNG, GIF or BMP, at least 184×184. It's cropped square and saved again as a clean JPG: no photo data (EXIF, GPS) goes to Steam."/>
                                                        <Button Style="{StaticResource LinkBtn}" Content="Remove" Click="TplClearAvatar_Click"/>
                                                    </StackPanel>
                                                    <TextBlock Text="184×184 px or more. It's cropped square." FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Privacy" FontSize="13" Foreground="{StaticResource Muted}" MinHeight="20" Margin="0,0,0,6"/>
                                                    <!-- Comments: the fifth list, which the design doesn't show, stays last -->
                                                    <Grid x:Name="TplPrivacy">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="36"/>
                                                            <RowDefinition Height="36"/>
                                                            <RowDefinition Height="36"/>
                                                            <RowDefinition Height="36"/>
                                                            <RowDefinition Height="30"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="Profile" Style="{StaticResource TplLabel}" Width="90" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="PrivProfile" Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,0,0,6" SelectionChanged="TplField_Changed"/>
                                                        <TextBlock Grid.Row="1" Text="Game details" Style="{StaticResource TplLabel}" Width="90" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="PrivGames" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,0,0,6" SelectionChanged="TplField_Changed"/>
                                                        <TextBlock Grid.Row="2" Text="Inventory" Style="{StaticResource TplLabel}" Width="90" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="PrivInventory" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,0,0,6" SelectionChanged="TplField_Changed"/>
                                                        <TextBlock Grid.Row="3" Text="Friends list" Style="{StaticResource TplLabel}" Width="90" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="PrivFriends" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,0,0,6" SelectionChanged="TplField_Changed"/>
                                                        <TextBlock Grid.Row="4" Text="Comments" Style="{StaticResource TplLabel}" Width="90"/>
                                                        <ComboBox x:Name="PrivComments" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldCombo}" SelectionChanged="TplField_Changed"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- ============ 2 Accounts -->
                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ProfNum}"><TextBlock Text="2" Style="{StaticResource ProfNumText}"/></Border>
                                    <Rectangle Width="1" Fill="{StaticResource ProfStepLine}" Margin="0,34,0,-14"/>
                                    <StackPanel Grid.Column="2" Margin="0,0,0,6">
                                        <!-- ProfBar: the step's title line, the picks on its right (Make the others look like is in step 3's quiet row) -->
                                        <Grid x:Name="ProfBar" MinHeight="28" SizeChanged="ProfBar_SizeChanged">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="Accounts" Style="{StaticResource ProfStepTitle}"/>
                                                <TextBlock Text="Who gets the look. Steam changes need a web sign-in." Style="{StaticResource ProfStepSub}"
                                                           ToolTip="Lets the app edit this profile on Steam's website. It is separate from logging in to Steam on this PC (Accounts), so an account can be logged in there and still say Not signed in here."/>
                                            </DockPanel>
                                            <StackPanel x:Name="ProfBarLeft" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="ProfBar_SizeChanged">
                                                <TextBlock Text="Pick" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Button Style="{StaticResource LinkBtn}" Content="All" Click="ProfSelAll_Click"/>
                                                <Button Style="{StaticResource LinkBtn}" Content="Signed in" Click="ProfSelSigned_Click" ToolTip="Pick only the accounts the app can change now"/>
                                                <Button Style="{StaticResource LinkBtn}" Content="None" Click="ProfSelNone_Click"/>
                                                <TextBlock x:Name="ProfCount" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Two columns 32 apart: the tick, the letter, the name (Muted when not picked), the web sign-in and Sign in.
                                             beta.10: the sign-in line and its button in one place. Signed in: the line ("Signed in · 187 d left", grey,
                                             amber when it runs out soon), and on the row under the pointer the line turns into Sign out. Not signed in:
                                             the line and Sign in, always in view (it is something to do). -->
                                        <ItemsControl x:Name="ProfList" Margin="0,10,-32,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="42" Padding="8,0" Margin="0,0,32,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Surface}"/></Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{Binding SignInText}" Tag="&#xE8D7;" Click="ProfSignIn_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="Restore original" Tag="&#xE7A7;" Click="ProfRestoreOriginal_Click"/>
                                                                <MenuItem Header="Undo the last change" Tag="&#xE7A7;" Click="ProfUndoLast_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="Copy its look into the template" Tag="&#xE8C8;" Click="ProfCopyInto_Click"/>
                                                                <MenuItem Header="Make the others look like this" Tag="&#xE8B9;" Click="ProfMakeLikeThis_Click"/>
                                                                <MenuItem Header="Open Steam's edit page" Tag="&#xE8A7;" Click="ProfOpenEdit_Click"
                                                                          ToolTip="Opens the profile edit page in your browser, for anything the app doesn't change"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <DockPanel>
                                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" IsChecked="{Binding Selected}" Click="ProfRowCheck_Click" VerticalAlignment="Center"/>
                                                            <Grid DockPanel.Dock="Left" Width="24" Height="24" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <Border Background="{StaticResource Lift}" CornerRadius="6">
                                                                    <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Border CornerRadius="6" Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                                                                    <Border.Background><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Border.Background>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" Margin="10,0,10,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Selected}" Value="False"><Setter Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Button DockPanel.Dock="Right" Content="{Binding SignInText}" Click="ProfSignIn_Click" Margin="10,0,0,0" Height="26" MinHeight="26"
                                                                    VerticalAlignment="Center" ToolTip="{Binding SignInTip}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource Pill}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding SignedIn}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="False"/>
                                                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <TextBlock Text="{Binding Session}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{Binding SessionBrush}"/>
                                                                        <Style.Triggers>
                                                                            <!-- App v4: a picked account without a sign-in is something to do (amber, like Sign in first in step 3) -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding SignedIn}" Value="False"/>
                                                                                    <Condition Binding="{Binding Selected}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding SignedIn}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding SignedIn}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel x:Name="ProfEmpty" Margin="0,24,0,12" HorizontalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="No accounts yet" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Accounts saved in Steam on this PC show up here." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- ============ 3 Review and apply -->
                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ProfNum}"><TextBlock Text="3" Style="{StaticResource ProfNumText}"/></Border>
                                    <StackPanel Grid.Column="2" Margin="0,0,0,6">
                                        <DockPanel MinHeight="28">
                                            <TextBlock Text="Review and apply" Style="{StaticResource ProfStepTitle}"/>
                                            <TextBlock Text="Only picked accounts. Nothing changes until you apply." Style="{StaticResource ProfStepSub}"/>
                                        </DockPanel>
                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock Text="Fields to change" Style="{StaticResource TplLabel}" Width="96" Margin="0,0,14,0"/>
                                            <CheckBox x:Name="FName" Style="{StaticResource Check}" Content="Name" Margin="0,0,14,0" MinHeight="28" Click="ProfField_Click"/>
                                            <CheckBox x:Name="FAvatar" Style="{StaticResource Check}" Content="Picture" Margin="0,0,14,0" MinHeight="28" Click="ProfField_Click"/>
                                            <CheckBox x:Name="FReal" Style="{StaticResource Check}" Content="Real name" Margin="0,0,14,0" MinHeight="28" Click="ProfField_Click"/>
                                            <CheckBox x:Name="FSummary" Style="{StaticResource Check}" Content="Bio" Margin="0,0,14,0" MinHeight="28" Click="ProfField_Click"/>
                                            <CheckBox x:Name="FCountry" Style="{StaticResource Check}" Content="Country" Margin="0,0,14,0" MinHeight="28" Click="ProfField_Click"/>
                                            <CheckBox x:Name="FPrivacy" Style="{StaticResource Check}" Content="Privacy" Margin="0,0,14,0" MinHeight="28" Click="ProfField_Click"/>
                                            <CheckBox x:Name="FUrl" Style="{StaticResource Check}" Content="Custom URL" Margin="0,0,14,0" MinHeight="28" Click="ProfField_Click"/>
                                        </WrapPanel>
                                        <!-- Now → After and Status, for the picked accounts only (the same rows as step 2; the others fold away) -->
                                        <Border Height="26" Margin="0,14,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                            <Grid x:Name="ProfHeader" Margin="8,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200*" MaxWidth="200"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="400*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="200*" MaxWidth="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Now" Style="{StaticResource ProfHead}"/>
                                                <TextBlock Grid.Column="4" Text="After" Style="{StaticResource ProfHead}"/>
                                                <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource ProfHead}"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl x:Name="ProfReview" ItemsSource="{Binding ItemsSource, ElementName=ProfList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinHeight="44" Padding="8,0" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Surface}"/></Trigger>
                                                                    <DataTrigger Binding="{Binding Selected}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{Binding SignInText}" Tag="&#xE8D7;" Click="ProfSignIn_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="Restore original" Tag="&#xE7A7;" Click="ProfRestoreOriginal_Click"/>
                                                                <MenuItem Header="Undo the last change" Tag="&#xE7A7;" Click="ProfUndoLast_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="Copy its look into the template" Tag="&#xE8C8;" Click="ProfCopyInto_Click"/>
                                                                <MenuItem Header="Make the others look like this" Tag="&#xE8B9;" Click="ProfMakeLikeThis_Click"/>
                                                                <MenuItem Header="Open Steam's edit page" Tag="&#xE8A7;" Click="ProfOpenEdit_Click"
                                                                          ToolTip="Opens the profile edit page in your browser, for anything the app doesn't change"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="200*" MaxWidth="200"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="400*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="200*" MaxWidth="200"/>
                                                            </Grid.ColumnDefinitions>
                                                            <DockPanel VerticalAlignment="Center">
                                                                <Grid Width="24" Height="24">
                                                                    <Border Background="{StaticResource Lift}" CornerRadius="6">
                                                                        <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border CornerRadius="6" Visibility="{Binding HasAvatar, Converter={StaticResource Vis}}">
                                                                        <Border.Background><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Border.Background>
                                                                    </Border>
                                                                </Grid>
                                                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding NowDetail}" Foreground="{StaticResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding HasNowDetail, Converter={StaticResource Vis}}"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <TextBlock Grid.Column="2" Text="&#x2192;" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                                            <DockPanel Grid.Column="4" VerticalAlignment="Center">
                                                                <Grid Width="24" Height="24">
                                                                    <Border Background="{StaticResource Lift}" CornerRadius="4">
                                                                        <TextBlock Text="{Binding AfterInitial}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border CornerRadius="4" Visibility="{Binding HasAfterAvatar, Converter={StaticResource Vis}}">
                                                                        <Border.Background><ImageBrush ImageSource="{Binding AfterAvatar}" Stretch="UniformToFill"/></Border.Background>
                                                                    </Border>
                                                                </Grid>
                                                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding After}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}"/>
                                                                    <TextBlock Text="{Binding AfterDetail}" Foreground="{StaticResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding AfterDetail}"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <!-- Status: its mark and 12 px; nothing in the way is Ready; what keeps an account from changing before
                                                                 Apply (Sign in first) in amber; a step running in the accent, a result in green or red -->
                                                            <DockPanel Grid.Column="6" VerticalAlignment="Center">
                                                                <local:StatusMark DockPanel.Dock="Left" Margin="0,0,8,0">
                                                                    <local:StatusMark.Style>
                                                                        <Style TargetType="local:StatusMark">
                                                                            <Setter Property="Brush" Value="{Binding StatusBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Brush" Value="{StaticResource Good}"/></DataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding HasProblem}" Value="True"/>
                                                                                        <Condition Binding="{Binding Result}" Value="{x:Null}"/>
                                                                                        <Condition Binding="{Binding Step}" Value="{x:Null}"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Brush" Value="{StaticResource Warn}"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </local:StatusMark.Style>
                                                                </local:StatusMark>
                                                                <TextBlock Text="Ready" FontSize="12" Foreground="{StaticResource Info}" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="34"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding HasProblem}" Value="True"/>
                                                                                        <Condition Binding="{Binding Result}" Value="{x:Null}"/>
                                                                                        <Condition Binding="{Binding Step}" Value="{x:Null}"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ProfNotPicked" Margin="8,8,0,0" FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Visibility="Collapsed"/>

                                        <!-- Use this template on new accounts | who is skipped, Apply to N accounts (filled) -->
                                        <Border Margin="0,18,0,0" Padding="8,14,8,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                            <DockPanel>
                                                <Button x:Name="ProfApplyBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryFill}" Content="Apply" Margin="0" Click="ProfApply_Click"
                                                        ToolTip="Changes the picked accounts one after another, with a pause between them. A copy of each profile is kept first, for undo."/>
                                                <CheckBox x:Name="ProfAuto" DockPanel.Dock="Left" Style="{StaticResource Check}" Content="Use this template on new accounts" Click="ProfAuto_Click" VerticalAlignment="Center"
                                                          ToolTip="When a new account shows up in Steam on this PC, the app asks you to sign in to it once and gives it this look."/>
                                                <TextBlock x:Name="ProfApplyNote" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" Margin="16,0,12,0"/>
                                            </DockPanel>
                                        </Border>
                                        <!-- The quiet row: Restore originals, Sign out of all, Make the others look like (App v3's second way to apply);
                                             the one option that can't be undone on the right, and it unticks itself after every Apply -->
                                        <DockPanel Margin="0,10,0,0">
                                            <CheckBox x:Name="ProfClearNames" DockPanel.Dock="Right" Style="{StaticResource Check}" Content="Also clear name history (can't undo)" Foreground="{StaticResource Warn}" Click="ProfField_Click"
                                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                                      ToolTip="Empties the &quot;previously known as&quot; list on each profile you apply. Permanent: Steam has no way to bring the old names back, and the app can't either. Unticks itself after every Apply."/>
                                            <WrapPanel VerticalAlignment="Center">
                                                <Button x:Name="ProfRestoreBtn" Style="{StaticResource LinkBtn}" Content="Restore originals" Margin="0,0,4,0" Click="ProfRestoreSelected_Click"
                                                        ToolTip="Puts the picked accounts back to how they were before the app first changed them"/>
                                                <Button Style="{StaticResource LinkBtn}" Content="Sign out of all" Click="ProfForgetAll_Click" Margin="0,0,4,0"
                                                        ToolTip="Deletes every sign-in the app saved. To end them on Steam's side too: Steam > Settings > Security > Authorized devices (they're named Pickroute, or CS2 IP Changer before 1.0.0)."/>
                                                <StackPanel x:Name="ProfBarRight" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" SizeChanged="ProfBar_SizeChanged">
                                                    <TextBlock Text="Make the others look like" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox x:Name="IdentSource" Style="{StaticResource FieldCombo}" Width="130" ToolTip="The account whose look the others get"/>
                                                    <Button x:Name="ProfIdentBtn" Style="{StaticResource LinkBtn}" Content="Preview" Click="ProfIdentical_Click" Margin="4,0,0,0"
                                                            ToolTip="Copies that account's name, picture, real name, bio and country (and privacy, if you signed in to it) into a new template (&quot;Look of …&quot;), picks every other account and shows the preview. Nothing changes until you click Apply."/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ======================================== Page: Log -->
                    <!-- Log (26 Nov, App v3 design, p7): the title and "3 entries · no warnings or errors" on the left, the search and
                         the filters in a capsule on the right; the entries as rows of time | mark | text with a thin line under each; the
                         five actions under a line at the bottom, Save bug report the filled one, Clear screen a plain word on the right -->
                    <Grid x:Name="PageLog" Grid.Row="1" Margin="24,16,24,18" Visibility="Collapsed" local:Look.Round="True" TextElement.FontSize="13"
                          Loaded="PageLog_Loaded">
                        <Grid.Resources>
                            <local:LogPart x:Key="LogPart"/>
                            <!-- a filter in the capsule: 24 px, rounded 12, the one picked in Surface3 SemiBold (Accounts' filters) -->
                            <Style x:Key="LogFilter" TargetType="RadioButton">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="GroupName" Value="logf"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="b" Background="Transparent" Height="24" Padding="12,0" CornerRadius="12">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- an entry: 8 px above and below, 4 at the sides, a 4 % line under it; a light wash under the mouse -->
                            <Style x:Key="LogRow" TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="4,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Lift}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- beta.10: with 600 lines, what failed was hard to find: a filter by kind and a search -->
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                <TextBox x:Name="LogSearch" Style="{StaticResource FieldBox}" Width="200" Tag="Search the Log" TextChanged="LogFilter_Changed" VerticalAlignment="Center"/>
                                <Border Margin="10,0,0,0" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LogAll" Style="{StaticResource LogFilter}" GroupName="logf" Content="All" IsChecked="True" Checked="LogFilter_Changed"/>
                                        <RadioButton x:Name="LogWarn" Style="{StaticResource LogFilter}" GroupName="logf" Content="Warnings and errors" Checked="LogFilter_Changed"/>
                                        <RadioButton x:Name="LogErr" Style="{StaticResource LogFilter}" GroupName="logf" Content="Errors" Checked="LogFilter_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Log" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" LineHeight="26.4" LineStackingStrategy="BlockLineHeight"/>
                                <TextBlock Margin="0,3,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis">
                                    <Run x:Name="LogSummary" Foreground="{StaticResource Muted}"/><Run x:Name="LogCountSep" Foreground="{StaticResource Faint}"/><Run Text="{Binding Text, ElementName=LogCount, Mode=OneWay}" Foreground="{StaticResource Faint}"/>
                                </TextBlock>
                                <!-- "2 of 600 lines" while a filter or a search is on: the code fills it, the line above shows it -->
                                <TextBlock x:Name="LogCount" Visibility="Collapsed"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid x:Name="LogTools" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed"/>
                        <ListBox x:Name="LogList" Grid.Row="2" Margin="0,16,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" ItemContainerStyle="{StaticResource LogRow}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,2,0,0"/>
                                            <local:StatusMark Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0">
                                                <local:StatusMark.Style>
                                                    <Style TargetType="local:StatusMark">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Brush" Value="{StaticResource Good}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Brush" Value="{StaticResource Warn}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Brush" Value="{StaticResource Bad}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:StatusMark.Style>
                                            </local:StatusMark>
                                            <!-- the lead ("Config (Sync now):") SemiBold, the rest in Info; an Info line all in Muted -->
                                            <TextBlock Grid.Column="4" TextWrapping="Wrap" Tag="{Binding Level}" FontSize="12.5" LineHeight="17.5" LineStackingStrategy="BlockLineHeight">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Info"><Setter Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Shown, Mode=OneWay, Converter={StaticResource LogPart}, ConverterParameter=head}" FontWeight="SemiBold"/><Run Text="{Binding Shown, Mode=OneWay, Converter={StaticResource LogPart}, ConverterParameter=rest}">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Setter Property="Foreground" Value="{StaticResource Info}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Info"><Setter Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,0,0,0">
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Click="LogClear_Click" Margin="0,14,0,0" Content="Clear screen" ToolTip="Clears this list. The log file stays in SRT_Dados."/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Click="LogCopy_Click" Margin="0,0,8,0" Content="Copy all" ToolTip="Copies the log so you can paste it where you need it (e.g. to ask for help)"/>
                                <Button Click="AppChanges_Click" Content="What the app changed" Margin="0,0,8,0"
                                        ToolTip="The Firewall rules, routes and blocked IPs the app made in Windows now, and the command that undoes them"/>
                                <Button Style="{StaticResource Primary}" Click="ExportReport_Click" Margin="0,0,8,0" Content="Save bug report"
                                        ToolTip="Saves a .zip on the Desktop to attach to a bug report: this log, the app's settings and rules, Steam's connection log and CS2's console. Your home IP and API key are left out."/>
                                <Button Click="ReportProblem_Click" Margin="0,0,8,0" Content="Report a problem"
                                        ToolTip="Opens a new issue on GitHub with the app and Windows versions filled in. Nothing is sent until you press Submit there."/>
                            </WrapPanel>
                        </DockPanel>
                    </Grid>

                    <!-- ======================================== Page: Settings -->
                    <!-- Settings (26 Nov, App v3 design, p8; groups and options as in docs/DESIGN.md > App layout): the twelve groups
                         listed on the left (a click scrolls to the group, the list follows the scroll), the groups one under the other on the
                         right, at most 900 px wide; on a wide window the list and the groups sit together in the middle (SettingsPad). Each option is a row under a thin line: the name and its line in Faint on the left, the
                         switch (32 x 18) or the field on the right. The page's styles below keep the keys the code and the tests use
                         (Group, Switch, OptSub, Danger) and give them this look only here -->
                    <Grid x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" local:Look.Round="True" TextElement.FontSize="13" Loaded="PageSettings_Loaded" SizeChanged="PageSettings_SizeChanged" IsVisibleChanged="PageSettings_VisibleChanged"
                          TextBlock.LineHeight="18.2" TextBlock.LineStackingStrategy="BlockLineHeight">
                        <Grid.Resources>
                            <local:UpperText x:Key="SetUpper"/>
                            <local:FlagName x:Key="FlagName"/>
                            <SolidColorBrush x:Key="BadLine" Color="#40EF6461"/>
                            <SolidColorBrush x:Key="BadEdge" Color="#73EF6461"/>
                            <!-- a group: its name 16 px SemiBold, 28 px above it, the rows 10 px under it -->
                            <Style x:Key="Group" TargetType="HeaderedContentControl">
                                <Setter Property="Margin" Value="0,28,0,0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="HeaderedContentControl">
                                            <StackPanel>
                                                <ContentPresenter ContentSource="Header" TextElement.FontFamily="{StaticResource DisplayFont}" TextElement.FontSize="16"
                                                                  TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}" TextBlock.LineHeight="21.3"/>
                                                <ContentPresenter Margin="0,10,0,0" TextElement.Foreground="{StaticResource Text}"/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- an option: the row with the line above it; the switch on the right, accent with a dark knob when on, a RouteOff ring
                                 with a Muted knob when off -->
                            <Style x:Key="Switch" TargetType="CheckBox">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Right" Width="32" Height="18" Margin="24,1,0,0" VerticalAlignment="Top">
                                                        <Border x:Name="track" CornerRadius="9" BorderBrush="{StaticResource RouteOff}" BorderThickness="1.5" Background="Transparent"/>
                                                        <Ellipse x:Name="knob" Width="10" Height="10" Fill="{StaticResource Muted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </Grid>
                                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="track" Property="BorderThickness" Value="0"/>
                                                    <Setter TargetName="knob" Property="Fill" Value="{StaticResource AccentText}"/>
                                                    <Setter TargetName="knob" Property="Width" Value="12"/>
                                                    <Setter TargetName="knob" Property="Height" Value="12"/>
                                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsChecked" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Muted}"/>
                                                </MultiTrigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="track" Property="Background" Value="{StaticResource AccentHover}"/>
                                                </MultiTrigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- the line under an option's name: 12 px Faint, 2 px under it -->
                            <Style x:Key="OptSub" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Margin" Value="0,2,0,0"/>
                                <Setter Property="LineHeight" Value="16.8"/>
                                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                            </Style>
                            <!-- a group's own line under its name (New IP + next account, Open with CS2, Player flags): 12 px Muted -->
                            <Style x:Key="SetDesc" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Margin" Value="0,-7,0,10"/>
                                <Setter Property="LineHeight" Value="16.8"/>
                            </Style>
                            <!-- the name over a field (Method, Data off (s), the hotkeys): 12 px Muted, 5 px above the field -->
                            <Style x:Key="SetLabel" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="LineHeight" Value="16.8"/>
                            </Style>
                            <!-- a row that isn't a switch: the same line above it and 10 px above and below -->
                            <Style x:Key="SetRow" TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                <Setter Property="Padding" Value="0,10"/>
                            </Style>
                            <!-- a small square action in a row (remove, edit): 28 px, rounded 6, the hairline, the glyph in Muted -->
                            <Style x:Key="SetSq" TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="8,0,0,0"/>
                                <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource InfoSoft}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- Remove Pickroute: a red outline pill (Bad at 45 %), a faint red wash under the mouse -->
                            <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
                                <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="13,0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="wash" CornerRadius="14" Background="{StaticResource Bad}" Opacity="0"/>
                                                <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource BadEdge}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="wash" Property="Opacity" Value="0.08"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- 27 Nov, Find a setting: a result is the setting's name (12.5 px Text) over its group (11.5 px Muted), 10 px in,
                                 rounded 6, Surface under the pointer, like the list of groups it takes the place of -->
                            <Style x:Key="SetFoundItem" TargetType="Button">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Margin" Value="0,0,0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,5,6,6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- the list of groups: 28 px, 10 px in, rounded 6, 12.5 px Muted; the group in view in Lift, Text, SemiBold -->
                            <Style x:Key="SetNavItem" TargetType="RadioButton">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Margin" Value="0,0,0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="GroupName" Value="setnav"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,0,6,0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Lift}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SetNavCol" Width="196"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- the title, "12 groups" and the list of groups; Remove the app in red. 27 Nov: it scrolls when the window is
                             short (1080p at 200 % leaves 516 px, and Remove the app went under the status bar) -->
                        <ScrollViewer x:Name="SetSide" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,16,12,16">
                            <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" LineHeight="26.4" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="SetCount" FontSize="12.5" LineHeight="17.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                            <!-- 27 Nov: Find a setting (Ctrl+F on this page). While it has text, the results take the list's place -->
                            <TextBox x:Name="SetFind" Style="{StaticResource FieldBox}" Tag="Find a setting" Margin="0,14,0,0" AutomationProperties.Name="Find a setting"
                                     TextChanged="SetFind_Changed" PreviewKeyDown="SetFind_Key" ToolTip="Words from a setting's name or what it does: sound, startup, tray, update, language…"/>
                            <StackPanel x:Name="SetFound" Margin="0,10,0,0" Visibility="Collapsed"/>
                            <StackPanel x:Name="SetNav" Margin="0,10,0,0">
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Protection" IsChecked="True"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Mobile data"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Change IP"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="New IP + next account"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Hotkeys and sounds"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Open with CS2"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Player flags"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Steam"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Privacy"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="App"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Maintenance"/>
                                <RadioButton Style="{StaticResource SetNavItem}" Click="SetNav_Click" Content="Remove the app" Foreground="{StaticResource Bad}"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="SetScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="SetScroll_Changed">
                        <Grid x:Name="SetContent" Margin="20,0,32,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="900"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="SetGroups" Margin="0,-12,0,0">
                                <HeaderedContentControl Style="{StaticResource Group}" Header="Protection">
                                    <StackPanel x:Name="ProtectionOptions">
                                        <CheckBox x:Name="LockCs2Box" Style="{StaticResource Switch}" Click="SettingChanged"
                                                  ToolTip="CS2 game traffic only goes through the phone. If the phone disconnects, CS2 goes offline instead of using your home network. Web content that CS2 or its add-ons load still uses your normal connection.">
                                            <StackPanel>
                                                <TextBlock Text="CS2 only through the phone"/>
                                                <TextBlock Text="If the phone disconnects, CS2 goes offline instead of using your home network. Off: servers not on your Servers page can see your home IP." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SteamEgressBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="Steam through the phone"/>
                                                <TextBlock Text="Avoids the 'No Steam logon' kick. In Game only with CS2 only through the phone on, matchmaking needs it. Steam downloads also use mobile data." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <!-- beta.11: features without protection, only when you choose it (a warning when you turn it on) -->
                                        <CheckBox x:Name="UseOffBox" Style="{StaticResource Switch}" Click="UseOff_Click"
                                                  ToolTip="Off (the default): with protection off, Servers, Join and Log in with CS2 wait for protection. On: they work on your home connection and nothing is blocked, so servers see your home IP. Turn on protection whenever you want to play through the phone.">
                                            <StackPanel>
                                                <TextBlock Text="Use the app with protection off"/>
                                                <TextBlock Text="Servers, Join and Log in work on your home connection. Servers see your home IP." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <!-- beta.10: when protection turns on and off by itself, apart from what it does. The label in capitals, 11 px SemiBold Muted -->
                                        <TextBlock x:Name="SetStartCloseKey" Text="Start and close" Visibility="Collapsed"/>
                                        <TextBlock Text="{Binding Text, ElementName=SetStartCloseKey, Converter={StaticResource SetUpper}}" FontSize="11" FontWeight="SemiBold" LineHeight="15.4"
                                                   Foreground="{StaticResource Muted}" Margin="0,12,0,4"/>
                                        <CheckBox x:Name="ProtectOnStartBox" Style="{StaticResource Switch}" Click="SettingChanged"
                                                  ToolTip="Off (the default): the app always starts with protection off and you turn it on in Connection or the tray icon. On: it turns on by itself at every start, also with Windows. With no phone connected, your servers stay blocked until it is, and CS2 too once the app has checked a phone.">
                                            <StackPanel>
                                                <TextBlock Text="Turn on protection when the app starts"/>
                                                <TextBlock Text="Also with Windows. Without the phone, your servers and CS2 stay blocked until you connect it." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="CleanupBox" Style="{StaticResource Switch}" Click="SettingChanged"
                                                  ToolTip="Off: the block stays on after you close the app, so CS2 stays locked to the phone. The first time you close the app with protection on, it asks you and sets this from your answer. Regions you turned off stay off either way.">
                                            <StackPanel>
                                                <TextBlock Text="Turn off protection when closing the app"/>
                                                <TextBlock Text="Off: the block stays on after you close the app. Regions you turned off stay off." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Group}" Header="Mobile data">
                                    <StackPanel>
                                        <CheckBox x:Name="KeepOffBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="Save mobile data"/>
                                                <TextBlock Text="In 'Game only' and 'No phone', stops Windows from moving the whole PC onto the phone." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="AutoModeBox" Style="{StaticResource Switch}" Click="SettingChanged"
                                                  ToolTip="When the mobile connection is weak, the app changes Whole PC to Game only, so the rest of your PC stops sharing the phone with CS2. It changes back when the connection is good and CS2 is closed. You always get a message.">
                                            <StackPanel>
                                                <TextBlock Text="Fall back to Game only on a weak connection"/>
                                                <TextBlock Text="So the rest of the PC stops sharing a weak phone connection with CS2." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <Border Style="{StaticResource SetRow}">
                                            <DockPanel>
                                                <TextBox x:Name="DataWarnBox" DockPanel.Dock="Right" Style="{StaticResource FieldBox}" Width="64" Margin="24,1,0,0" VerticalAlignment="Top"
                                                         FontFamily="{StaticResource Mono}" FontSize="12" LostFocus="DataWarn_Changed"
                                                         ToolTip="The app counts what goes through the phone's adapter (shown under Phone on the Connection page) and warns once a month when it passes this."/>
                                                <StackPanel>
                                                    <TextBlock Text="Warn me after"/>
                                                    <TextBlock Text="GB a month, 0 = off" Style="{StaticResource OptSub}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Group}" Header="Change IP">
                                    <StackPanel>
                                    <Border Style="{StaticResource SetRow}">
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="Method" Style="{StaticResource SetLabel}"/>
                                            <ComboBox x:Name="MethodCombo" Style="{StaticResource FieldCombo}" Width="240" SelectionChanged="SettingChanged"
                                                      ToolTip="Mobile data: turns off data only. Airplane mode: the carrier almost always gives a new IP, but some phones drop USB tethering.">
                                                <ComboBoxItem Content="Turn mobile data off and on" Tag="data"/>
                                                <ComboBoxItem Content="Airplane mode" Tag="airplane"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="Data off (s)" Style="{StaticResource SetLabel}" ToolTip="How long data stays off on each attempt"/>
                                            <TextBox x:Name="OffSecondsBox" Style="{StaticResource FieldBox}" Width="80" FontFamily="{StaticResource Mono}" FontSize="12" LostFocus="SettingChanged"
                                                     ToolTip="How long data stays off. 4 to 10 s is normal."/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock Text="Attempts" Style="{StaticResource SetLabel}"/>
                                            <TextBox x:Name="AttemptsBox" Style="{StaticResource FieldBox}" Width="80" FontFamily="{StaticResource Mono}" FontSize="12" LostFocus="SettingChanged"
                                                     ToolTip="If the carrier returns the same IP, the app retries up to this many times."/>
                                        </StackPanel>
                                    </WrapPanel>
                                    </Border>
                                    <CheckBox x:Name="New16Box" Style="{StaticResource Switch}" Click="SettingChanged">
                                        <StackPanel>
                                            <TextBlock Text="Keep changing until the IP is in a new range"/>
                                            <TextBlock Text="Many admins ban a whole range (the first two numbers of the IP, like 198.51.x.x). Uses the attempts above." Style="{StaticResource OptSub}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="GoodLinkBox" Style="{StaticResource Switch}" Click="SettingChanged"
                                              ToolTip="On mobile data the lag in CS2 is mostly jitter: the ping is fine, but your moves reach the server late. Mobile data off and on keeps the phone on the same cell, so each change again uses airplane mode (not on the hotspot), and the phone looks for the network again: it can land on another cell. After each new IP the app pings for about 2 s, as in Checks > Connection quality, and changes again when jitter is 20 ms or more (or 2 of the 10 pings are lost), 3 more changes at most, on top of the attempts. Each check adds 5 to 15 s to Change IP.">
                                        <StackPanel>
                                            <TextBlock Text="Keep changing until the connection is good"/>
                                            <TextBlock Text="Changes again while jitter is 20 ms or more: up to 3 more changes than the attempts above." Style="{StaticResource OptSub}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>
                                <HeaderedContentControl x:Name="SwitchGroup" Style="{StaticResource Group}" Header="New IP + next account">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SetDesc}" Background="Transparent"
                                                   ToolTip="The steps ticked in this group, in order. Both hotkeys work in game. The Change IP and rejoin hotkey is separate: it changes the IP when it can and rejoins with the same account, or with the next one if that account is banned on the last server."
                                                   Text="What the New IP + next account button and hotkey do, in order."/>
                                        <!-- the steps numbered in Faint mono, their lines 18 px in -->
                                        <CheckBox x:Name="SwIpBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <DockPanel><TextBlock Text="1" Width="18" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,1,0,0"/><TextBlock Text="Change the IP"/></DockPanel>
                                                <TextBlock Text="Like the Change IP button. If the IP can't change, the other steps still run." Style="{StaticResource OptSub}" Padding="18,0,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SwAccountBox" Style="{StaticResource Switch}" Click="SettingChanged"
                                                  ToolTip="The account you used longest ago, never the current one. Accounts not in rotation, banned or on cooldown are left out. With Rejoin the last server on, so are accounts banned on that server or its community.">
                                            <StackPanel>
                                                <DockPanel><TextBlock Text="2" Width="18" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,1,0,0"/><TextBlock Text="Log in to the next account"/></DockPanel>
                                                <TextBlock Text="The account you used longest ago that is in rotation, not banned and not on cooldown." Style="{StaticResource OptSub}" Padding="18,0,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SwRejoinBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <DockPanel><TextBlock Text="3" Width="18" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,1,0,0"/><TextBlock Text="Rejoin the last server"/></DockPanel>
                                                <TextBlock Text="Joins through the phone with protection confirmed, or on your home connection in No phone or with Use the app with protection off. If off, CS2 opens in the main menu." Style="{StaticResource OptSub}" Padding="18,0,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SwOpenWithBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <DockPanel><TextBlock Text="4" Width="18" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,1,0,0"/><TextBlock Text="Open your CS2 programs"/></DockPanel>
                                                <TextBlock Text="The programs listed under Open with CS2. Only when this command opens CS2." Style="{StaticResource OptSub}" Padding="18,0,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Group}" Header="Hotkeys and sounds">
                                    <StackPanel>
                                        <Border Style="{StaticResource SetRow}">
                                        <WrapPanel>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="New IP + next account hotkey" Style="{StaticResource SetLabel}"/>
                                                <TextBox x:Name="HotkeySwitchBox" Style="{StaticResource FieldBox}" Width="180" FontFamily="{StaticResource Mono}" FontSize="12" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"
                                                         ToolTip="Click here and press the keys. Escape puts back Ctrl+Shift+F9."/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Change IP and rejoin hotkey" Style="{StaticResource SetLabel}"/>
                                                <TextBox x:Name="HotkeyRejoinBox" Style="{StaticResource FieldBox}" Width="180" FontFamily="{StaticResource Mono}" FontSize="12" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"
                                                         ToolTip="Click here and press the keys. Escape puts back Ctrl+Shift+F10."/>
                                            </StackPanel>
                                        </WrapPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource OptSub}" Margin="0,0,0,10"
                                                   Text="Press the keys you want. Avoid Ctrl+Alt: on many keyboards it is AltGr, which types @ and €."/>
                                        <CheckBox x:Name="SoundsBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="Sounds for commands"/>
                                                <TextBlock Text="A short sound when a hotkey or button starts something, and another when it ends or fails. You hear them in game." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Group}" Header="Open with CS2">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SetDesc}" Background="Transparent"
                                                   ToolTip="Like Discord, Spotify or a stats tracker. They open as you, without the app's admin rights, and only if they aren't running yet."
                                                   Text="Programs that open when the app opens CS2, if they aren't running yet."/>
                                        <!-- a program: the check and its name, the path in mono under it; As admin and remove on the right -->
                                        <ItemsControl x:Name="OpenWithList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SetRow}">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,0,0,0">
                                                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding AsAdmin}" Click="OpenWithToggle_Click" VerticalAlignment="Center"
                                                                      ToolTip="Opens it with Run as administrator: Windows asks first (UAC). For programs that only work as admin.">
                                                                <TextBlock Text="As admin"/>
                                                            </CheckBox>
                                                            <Button Style="{StaticResource SetSq}" Content="&#xE74D;" Click="OpenWithRemove_Click" ToolTip="Remove"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <CheckBox Style="{StaticResource Check}" FontSize="13" IsChecked="{Binding Enabled}" Click="OpenWithToggle_Click" ToolTip="{Binding Path}" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Name}" Margin="2,0,0,0"/>
                                                            </CheckBox>
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource OptSub}" FontFamily="{StaticResource Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource SetRow}">
                                            <Button HorizontalAlignment="Left" Margin="0" Content="Add program" Click="OpenWithAdd_Click" ToolTip="Pick an .exe file"/>
                                        </Border>
                                    </StackPanel>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Group}" Header="Player flags">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SetDesc}" Background="Transparent"
                                                   ToolTip="Servers only show player names. A flag with only a name marks anyone who uses that name. With the player's Steam profile the flag stays on them after a name change, and it can show which server they are on if their game details are public. A Steam Web API key makes this check faster."
                                                   Text="A flag with only a name marks anyone who uses that name. Add their Steam profile to keep it after a name change."/>
                                        <Border Style="{StaticResource SetRow}" Visibility="{Binding Visibility, ElementName=FlagsEmpty}">
                                            <TextBlock x:Name="FlagsEmpty" Text="No flags yet. Right-click a player in Servers, or add one by profile link." Style="{StaticResource OptSub}" Margin="0"/>
                                        </Border>
                                        <!-- a flag: the name SemiBold and its label in Muted, how it is matched under it; the colour (click to change it),
                                             Follow, edit and remove on the right -->
                                        <ItemsControl x:Name="FlagList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SetRow}">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,0,0,0">
                                                            <Button Click="FlagEdit_Click" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Color: click to change it">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent" Padding="0,4">
                                                                            <Border x:Name="sw" Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" BorderBrush="Transparent" BorderThickness="1"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="sw" Property="BorderBrush" Value="{StaticResource Text}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <CheckBox Style="{StaticResource Check}" Content="Follow" IsChecked="{Binding Follow}" Click="FlagFollow_Click" VerticalAlignment="Center"
                                                                      ToolTip="Tells you when this player shows up on another server in your list"/>
                                                            <Button Style="{StaticResource SetSq}" Content="&#xE70F;" Click="FlagEdit_Click" ToolTip="Edit"/>
                                                            <Button Style="{StaticResource SetSq}" Content="&#xE74D;" Click="FlagRemove_Click" ToolTip="Remove flag"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock TextTrimming="CharacterEllipsis"><Run FontWeight="SemiBold"><Run.Text><MultiBinding Converter="{StaticResource FlagName}" Mode="OneWay"><Binding Path="Title"/><Binding Path="Label"/></MultiBinding></Run.Text></Run><Run Text=" · " Foreground="{StaticResource Muted}"/><Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource OptSub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource SetRow}">
                                            <Button HorizontalAlignment="Left" Margin="0" Content="Add by profile link" Click="FlagAdd_Click"
                                                    ToolTip="Paste a steamcommunity.com link or a SteamID64"/>
                                        </Border>
                                        <CheckBox x:Name="AutoJoinBox" Style="{StaticResource Switch}" Click="SettingChanged">
                                            <StackPanel>
                                                <TextBlock Text="Ask to join when a followed player moves"/>
                                                <TextBlock Text="Only while CS2 is open. It never opens CS2 or joins without your OK." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Group}" Header="Steam">
                                    <StackPanel>
                                        <Border Style="{StaticResource SetRow}">
                                            <DockPanel>
                                                <!-- the key (hidden, or shown in the box under it), Show as a word, Get key as a pill -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,1,0,0">
                                                    <Grid Width="200">
                                                        <PasswordBox x:Name="ApiKeyPwd" Style="{StaticResource FieldPwd}" FontFamily="{StaticResource Mono}" FontSize="12" LostFocus="SettingChanged"
                                                                     ToolTip="Works without a key too. Hidden so it doesn't show on stream or in screenshots."/>
                                                        <TextBox x:Name="ApiKeyBox" Style="{StaticResource FieldBox}" FontFamily="{StaticResource Mono}" FontSize="12" LostFocus="SettingChanged" Tag="Works without a key too" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <Button x:Name="ApiKeyShowBtn" Style="{StaticResource LinkBtn}" Margin="8,0,0,0" Click="ApiKeyShow_Click" Content="Show" ToolTipService.ShowOnDisabled="True" ToolTip="Shows the key"/>
                                                    <Button Margin="8,0,0,0" Click="ApiKeyLink_Click" Content="Get key" ToolTip="Opens steamcommunity.com/dev/apikey"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Steam Web API key (optional)"/>
                                                    <TextBlock Text="With it, bans come from the official API. It stays on this PC, encrypted for your Windows user." Style="{StaticResource OptSub}"/>
                                                    <TextBlock x:Name="ApiKeyLostText" Visibility="Collapsed" Style="{StaticResource OptSub}" Foreground="{StaticResource Warn}" Margin="0,6,0,0"
                                                               Text="The saved key was encrypted by another Windows user or on another PC, so it can't be read here. Paste it again."/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <CheckBox x:Name="LaunchOptsBox" Style="{StaticResource Switch}" Click="SettingChanged"
                                                  ToolTip="Adds -condebug -conclearlog to CS2's launch options (Steam > CS2 > Properties) of every account on this PC. What you already have there stays. Only while Steam is closed: Steam would overwrite it otherwise. A backup of each file goes to SRT_Dados\launch-options.">
                                            <StackPanel>
                                                <TextBlock Text="See kicks and bans when Steam opens CS2"/>
                                                <TextBlock Text="CS2 only writes its console log with -condebug. The app adds it to CS2's launch options while Steam is closed, and keeps what you have there." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="LaunchOptsBtn" Margin="0" Content="Add to CS2's launch options now" Click="LaunchOpts_Click"
                                                    ToolTip="Closes Steam if it is open (it asks first), adds the two options to every account, and opens Steam again."/>
                                            <TextBlock x:Name="LaunchOptsText" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Group}" Header="Privacy">
                                    <StackPanel>
                                        <CheckBox x:Name="OptStreamer" Style="{StaticResource Switch}" Click="AccOpt_Click"
                                                  ToolTip="For streams: hides usernames, your home IP in the Log page and the Steam API key">
                                            <StackPanel>
                                                <TextBlock Text="Hide usernames"/>
                                                <TextBlock Text="Also your home IP on the Log page and the Steam API key. For streams." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="AutoStreamerBox" Style="{StaticResource Switch}" Click="AutoStreamer_Click"
                                                  ToolTip="While OBS Studio or Streamlabs is running, the app hides usernames, your home IP in the Log page and the API key, as Hide usernames does. They show again when it closes.">
                                            <StackPanel>
                                                <TextBlock Text="Hide usernames while OBS or Streamlabs is open"/>
                                                <TextBlock Text="So a login or your home IP never ends up on a stream." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <!-- Telemetry: on by default, answered once before the app opens (App.StatsGate), this switch turns it off, README > Telemetry -->
                                        <CheckBox x:Name="StatsBox" Style="{StaticResource Switch}" Click="StatsSwitch_Click"
                                                  ToolTip="Off: nothing is counted or sent. The random ID stays, so turning it on again carries on with the same one.">
                                            <StackPanel>
                                                <TextBlock Text="Send usage stats"/>
                                                <TextBlock Text="Helps find and fix bugs. Off: nothing is sent and the app works the same." Style="{StaticResource OptSub}"/>
                                                <!-- the same line as the one above it: what is sent, no name (its tooltip lists it, MainWindow.Settings.cs) -->
                                                <TextBlock x:Name="StatsLine" Style="{StaticResource OptSub}" TextWrapping="Wrap" Margin="0" Background="Transparent"
                                                           Text="A random ID made for this install, with no name (never from your PC or you). Never IPs, servers, accounts or names."/>
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Click="DeleteStats_Click" Margin="0,0,8,0" HorizontalAlignment="Left" Content="Delete my stats"
                                                    ToolTip="Deletes everything the stats server keeps under this install's ID, then the app starts over with a new ID."/>
                                            <Button Click="DeleteLogs_Click" Margin="0" Content="Delete log files" ToolTip="Deletes the log files in SRT_Dados (they hold your home IP, Steam names and servers). The log keeps about 14 days on its own."/>
                                        </StackPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Group}" Header="App">
                                    <StackPanel>
                                        <Border Style="{StaticResource SetRow}">
                                            <DockPanel>
                                                <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Style="{StaticResource FieldCombo}" Width="200" Margin="24,1,0,0" VerticalAlignment="Top" SelectionChanged="LanguageBox_Changed">
                                                    <ComboBoxItem Content="Automatic (Windows)"/>
                                                </ComboBox>
                                                <StackPanel>
                                                    <TextBlock Text="Language"/>
                                                    <TextBlock Text="Changing it applies the next time you open the app." Style="{StaticResource OptSub}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource Switch}" Click="StartWithWindows_Click" ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="A scheduled task named 'CS2 IP Changer' opens the app in the notification area when you sign in, with its admin rights and without the UAC prompt each time. Protection starts off, unless Settings > Protection > Turn on protection when the app starts is on. Only for the copy installed in C:\Program Files\CS2 IP Changer. Turning this off, Settings > Remove the app and --restore delete the task.">
                                            <StackPanel>
                                                <TextBlock Text="Start with Windows"/>
                                                <TextBlock Text="Opens in the notification area when you sign in. Protection starts as set in Settings > Protection." Style="{StaticResource OptSub}"/>
                                                <TextBlock x:Name="AutostartHint" Visibility="Collapsed" Style="{StaticResource OptSub}" Foreground="{StaticResource Warn}"
                                                           Text="Only for the installed copy: start the app from Downloads and click Install."/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="CloseToTrayBox" Style="{StaticResource Switch}" Click="CloseToTray_Click"
                                                  ToolTip="The X hides the window and the app keeps running in the notification area (next to the clock). Click the icon to open it; right-click it for its menu, Quit included.">
                                            <StackPanel>
                                                <TextBlock Text="Close to the notification area"/>
                                                <TextBlock Text="The X hides the window. Quit is in the icon's menu." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="CheckUpdatesBox" Style="{StaticResource Switch}" Click="CheckUpdates_Click">
                                            <StackPanel>
                                                <TextBlock Text="Check for updates"/>
                                                <TextBlock Text="Once a day, on GitHub. Nothing installs without your OK and a matching SHA-256." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="TestVersionsBox" Style="{StaticResource Switch}" Click="TestVersions_Click"
                                                  ToolTip="Each new version comes out first as a test version (a pre-release on GitHub), signed and checked like the stable ones. It becomes stable after it is tested. Turned off, the app offers the next stable version that is newer than yours.">
                                            <StackPanel>
                                                <TextBlock Text="Get test versions"/>
                                                <TextBlock Text="New versions before they are fully tested. Off: only stable versions." Style="{StaticResource OptSub}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <!-- 10 Nov: the first-run tour, again -->
                                        <Border Style="{StaticResource SetRow}">
                                            <Button Click="TourAgain_Click" Margin="0" HorizontalAlignment="Left" Content="{x:Static local:Texts.TourAgain}" ToolTip="{x:Static local:Texts.TourAgainTip}"/>
                                        </Border>
                                        <!-- 1.0.0: the app's old name, for those who knew it by it -->
                                        <TextBlock x:Name="FormerlyText" Style="{StaticResource OptSub}" Margin="0,10,0,0" Text="Formerly CS2 IP Changer"/>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Group}" Header="Maintenance">
                                    <Border Style="{StaticResource SetRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="OpenData_Click" Margin="0,0,8,0" Content="Open data folder" ToolTip="Opens the SRT_Dados folder, next to the .exe"/>
                                            <Button Click="OpenFirewall_Click" Margin="0" Content="Open Windows Firewall" ToolTip="The app's rules are under Outbound Rules, named 'Pickroute'."/>
                                        </StackPanel>
                                    </Border>
                                </HeaderedContentControl>

                                <!-- in red: its name, the line above the row (Bad at 25 %) and the button's outline -->
                                <HeaderedContentControl Style="{StaticResource Group}" Header="Remove the app" Foreground="{StaticResource Bad}">
                                    <Border Style="{StaticResource SetRow}" BorderBrush="{StaticResource BadLine}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Danger}" Margin="24,0,0,0" VerticalAlignment="Center" Click="RemoveAll_Click" Content="Remove Pickroute"
                                                    ToolTip="Asks first. Also in Windows Settings > Apps > Installed apps, for the copy in C:\Program Files\CS2 IP Changer."/>
                                            <TextBlock FontSize="12" LineHeight="16.8" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Text="Removes the rules, routes and task the app made, then the app itself. You choose whether your settings and accounts stay."/>
                                        </DockPanel>
                                    </Border>
                                </HeaderedContentControl>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Status line (26 Nov, App v3): the phone as Connection shows it, the mobile data, and the quick switch's hotkey.
                         Only bindings to what the app already shows (Connection > Phone, Settings > Hotkeys and sounds) -->
                    <Border Grid.Row="2" Height="28" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,0">
                        <DockPanel VerticalAlignment="Center" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                                <TextBlock Text="New IP + next account" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0" Padding="6,1,6,2" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Text, ElementName=HotkeySwitchBox}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" ClipToBounds="True">
                                <local:StatusMark Brush="{Binding Fill, ElementName=PhoneDot}"/>
                                <TextBlock Text="{Binding Text, ElementName=PhoneState}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Text, ElementName=PhoneDetail}" Margin="8,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                                <TextBlock Text="·" Margin="8,0,0,0" Foreground="{StaticResource Faint}" Opacity="0.55" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=DataUsage}"/>
                                <TextBlock Text="{Binding Text, ElementName=DataUsage}" Margin="8,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Visibility, ElementName=DataUsage}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Toast -->
                    <Border x:Name="ToastBox" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" MaxWidth="420"
                            Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Visibility="Collapsed" Opacity="0">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <DockPanel>
                                <Border x:Name="ToastStrip" DockPanel.Dock="Top" Height="2" Background="{StaticResource TopLine}"/>
                                <StackPanel Orientation="Horizontal" Margin="12,9,12,10">
                                    <TextBlock x:Name="ToastIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Good}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="360"/>
                                        <!-- beta.11: a toast can carry one action (Add a server you just joined) -->
                                        <Button x:Name="ToastActionBtn" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,3"
                                                Visibility="Collapsed" Click="ToastAction_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Border>

                </Grid>
            </Grid>

            <!-- the 2 px line at the top of the window, over the sidebar and the top bar, in its full colours (at 42 % until 26 Nov at
                 night: the owner saw it half faded; with every other gradient gone it is the brand's one mark) -->
            <Border Grid.RowSpan="2" Height="2" VerticalAlignment="Top" Background="{StaticResource TopLine}" IsHitTestVisible="False"/>

            <!-- Dialog -->
            <!-- beta.10: Phone setup as steps that check themselves (PhoneSetup.Steps), each with its button when the app can do it -->
            <Grid x:Name="SetupPane" Grid.Row="1" Margin="0,40,0,0" Background="#B0000000" Visibility="Collapsed" local:Look.Round="True">
                <HeaderedContentControl Style="{StaticResource DialogGroup}" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,10,18,8">
                    <HeaderedContentControl.Header>
                        <TextBlock Text="Phone setup" Style="{StaticResource DialogTitle}"/>
                    </HeaderedContentControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="SetupSummary" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Updates by itself. Do the red step and it turns green."/>
                        <ItemsControl x:Name="SetupSteps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8" Background="{Binding RowBack}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Top" Margin="4,4,0,0">
                                                <local:StatusMark Brush="{Binding Brush}" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding TitleBrush}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailBrush}" FontSize="12" TextWrapping="Wrap"
                                                           Visibility="{Binding DetailVisibility}"/>
                                                <!-- 10 Nov: the phone tool's download, in the row -->
                                                <ProgressBar Margin="0,6,0,0" Height="2" Maximum="100" Value="{Binding PercentValue, Mode=OneWay}" Visibility="{Binding PercentVisibility}"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Style="{StaticResource Primary}" Content="{Binding Action}" Click="SetupAction_Click" Margin="0" MinWidth="86" VerticalAlignment="Top"
                                                    Visibility="{Binding HasMainAction, Converter={StaticResource Vis}}" IsEnabled="{Binding Idle}"/>
                                            <!-- 24 Nov: a second way (Use the hotspot on the cable row) is a grey button, so the cable stays the one to follow -->
                                            <Button Grid.Column="3" Content="{Binding Action}" Click="SetupAction_Click" Margin="0" MinWidth="86" VerticalAlignment="Top"
                                                    Visibility="{Binding HasQuietAction, Converter={StaticResource Vis}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 10 Nov: USB debugging drawn step by step for the phone's brand (Texts.Guides, built in PhoneGuide.cs) -->
                        <ContentControl x:Name="SetupGuide" Margin="0,12,0,0" Focusable="False" Visibility="Collapsed"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SetupFoot" Style="{StaticResource OptSub}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <!-- 24 Nov: ready with protection off ends on Turn on protection, with Close next to it (SetupEnd) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="SetupCloseBtn" Content="Close" Click="SetupClose_Click" Margin="0"/>
                                <Button x:Name="SetupTurnOnBtn" Style="{StaticResource Primary}" Content="Turn on protection" Click="SetupTurnOn_Click" Margin="6,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>
            </Grid>
            <!-- 24 Nov: the first start's two doors (MainWindow.Start.cs). 46 of 57 never plugged a phone in and Regions is the most used
                 page, so the start asks before pushing anyone to the phone. Each door draws the page it opens; the tour is behind Show me around -->
            <Grid x:Name="StartPane" Grid.Row="1" Margin="0,40,0,0" Background="#B0000000" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" local:Look.Round="True">
                <HeaderedContentControl Style="{StaticResource DialogGroup}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,12,18,16">
                    <HeaderedContentControl.Header>
                        <TextBlock Text="{x:Static local:Texts.DoorsTitle}" Style="{StaticResource DialogTitle}"/>
                    </HeaderedContentControl.Header>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DoorRegionsBtn" Style="{StaticResource Door}" Click="DoorRegions_Click" AutomationProperties.Name="{x:Static local:Texts.DoorRegions}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- The Regions list as the page draws it: two allowed, two blocked -->
                                    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,8" Height="112" IsHitTestVisible="False">
                                        <StackPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="True" Focusable="False" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Frankfurt" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="24 ms" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Good}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,5,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="True" Focusable="False" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Vienna" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="30 ms" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Good}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,5,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="False" Focusable="False" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Chicago" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="128 ms" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Bad}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,5,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="False" Focusable="False" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Dubai" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="141 ms" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Bad}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Static local:Texts.DoorRegions}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,4"/>
                                    <TextBlock Grid.Row="2" Text="{x:Static local:Texts.DoorRegionsText}" Style="{StaticResource Sub}" TextWrapping="Wrap" LineHeight="18"/>
                                    <TextBlock Grid.Row="3" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,10,0,0"><Run Text="{x:Static local:Texts.DoorRegionsGo}"/><Run Text="  &#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10"/></TextBlock>
                                </Grid>
                            </Button>
                            <Button x:Name="DoorPhoneBtn" Grid.Column="2" Style="{StaticResource Door}" Click="DoorPhone_Click" AutomationProperties.Name="{x:Static local:Texts.DoorPhone}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- The phone as Phone setup draws it (PhoneGuide), and the Status box's pair: the home IP, then the carrier's -->
                                    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" Height="112" IsHitTestVisible="False">
                                        <Grid>
                                            <Border Width="50" Height="88" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Background="{StaticResource Bg}" HorizontalAlignment="Left" Margin="22,0,0,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <Border Width="14" Height="2" Background="{StaticResource Line}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                                    <Border Height="6" Background="{StaticResource Surface3}" VerticalAlignment="Top" Margin="6,16,6,0"/>
                                                    <Border Height="6" Background="{StaticResource Surface3}" VerticalAlignment="Top" Margin="6,27,14,0"/>
                                                    <Border Height="8" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0" VerticalAlignment="Top" Margin="6,39,6,0"/>
                                                    <Border Height="6" Background="{StaticResource Surface3}" VerticalAlignment="Top" Margin="6,53,10,0"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="92,0,8,0">
                                                <TextBlock Text="Your home IP" FontSize="10" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="203.0.•••.•••" FontSize="13" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Faint}" Margin="0,1,0,0"/>
                                                <TextBlock Text="&#xE74B;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Accent}" Margin="2,5,0,5"/>
                                                <TextBlock Text="IP servers see" FontSize="10" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="198.51.100.23" FontSize="13" FontFamily="{StaticResource Mono}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Static local:Texts.DoorPhone}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,4"/>
                                    <TextBlock Grid.Row="2" Text="{x:Static local:Texts.DoorPhoneText}" Style="{StaticResource Sub}" TextWrapping="Wrap" LineHeight="18"/>
                                    <TextBlock Grid.Row="3" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,10,0,0"><Run Text="{x:Static local:Texts.SetUpPhone}"/><Run Text="  &#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10"/></TextBlock>
                                </Grid>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="DoorTourBtn" Click="DoorTour_Click" Content="{x:Static local:Texts.DoorTour}"/>
                            <Button x:Name="DoorLaterBtn" Click="DoorLater_Click" Margin="0" Content="{x:Static local:Texts.TourLater}"/>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>
            </Grid>
            <!-- Below the top bar (4 nov.): its Cancel stops the command that asked, so the question never hides the way out -->
            <Grid x:Name="Dialog" Grid.Row="1" Margin="0,40,0,0" Background="#B0000000" Visibility="Collapsed" local:Look.Round="True" MouseLeftButtonDown="DialogBackdrop_MouseDown">
                <Grid Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <HeaderedContentControl Style="{StaticResource DialogGroup}" Padding="18,12,18,16">
                    <HeaderedContentControl.Header>
                        <TextBlock x:Name="DialogTitle" Style="{StaticResource DialogTitle}" TextWrapping="Wrap"/>
                    </HeaderedContentControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="DialogText" Style="{StaticResource Sub}" LineHeight="19"/>
                        <StackPanel x:Name="DialogChoices" Margin="0,14,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="DialogLabel1" Style="{StaticResource Key}" Margin="0,14,0,4" Visibility="Collapsed"/>
                        <TextBox x:Name="DialogInput" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="DialogLabel2" Style="{StaticResource Key}" Margin="0,10,0,4" Visibility="Collapsed"/>
                        <TextBox x:Name="DialogInput2" Margin="0,0,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="DialogColorLabel" Text="Color" Style="{StaticResource Key}" Margin="0,10,0,4" Visibility="Collapsed"/>
                        <WrapPanel x:Name="DialogColors" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button x:Name="DialogCancel" Content="Cancel" Click="DialogCancel_Click"/>
                            <Button x:Name="DialogOk" Style="{StaticResource Primary}" Content="Continue" Margin="0" Click="DialogOk_Click"/>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>
                <!-- Every question has a way out that does neither (like Esc): the X, or a click outside the box -->
                <Button x:Name="DialogClose" Style="{StaticResource Chrome}" Width="34" Height="30" FontSize="10" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,10,8,0" Click="DialogClose_Click" ToolTip="Close without choosing (Esc)" AutomationProperties.Name="Close"/>
                </Grid>
            </Grid>
            <!-- 10 Nov: the first-run tour (MainWindow.Tour.cs, texts in Texts.Tour). The shade has a hole over the real control it points at -->
            <Grid x:Name="TourPane" Grid.Row="1" Visibility="Collapsed" Background="Transparent" local:Look.Round="True">
                <Path x:Name="TourShade" Fill="#B0000000"/>
                <Rectangle x:Name="TourRing" Stroke="{StaticResource Accent}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                <Canvas>
                    <HeaderedContentControl x:Name="TourBox" Style="{StaticResource DialogGroup}" Width="360" Padding="16,12,16,14">
                        <!-- 24 Nov: "5 of 5" sits in the title, and the buttons go to a second line when a language doesn't fit them in 360 px
                             (ru, es and pt-BR pushed the count out and cut the last button) -->
                        <HeaderedContentControl.Header>
                            <TextBlock Style="{StaticResource DialogTitle}"><Run x:Name="TourTitle"/><Run Text="   "/><Run x:Name="TourCount" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}"/></TextBlock>
                        </HeaderedContentControl.Header>
                        <StackPanel>
                            <TextBlock x:Name="TourText" Style="{StaticResource Sub}" TextWrapping="Wrap" LineHeight="19"/>
                            <TextBlock x:Name="TourHint" Style="{StaticResource OptSub}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" Text="{x:Static local:Texts.TourAgainHint}"/>
                            <WrapPanel x:Name="TourButtons" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="TourSkipBtn" Click="TourSkip_Click" Margin="0,6,6,0" Content="{x:Static local:Texts.TourSkip}"/>
                                <Button x:Name="TourBackBtn" Click="TourBack_Click" Margin="0,6,6,0" Content="{x:Static local:Texts.TourBack}"/>
                                <Button x:Name="TourNextBtn" Style="{StaticResource Primary}" Margin="0,6,0,0" Click="TourNext_Click" Content="{x:Static local:Texts.TourNext}"/>
                            </WrapPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</Window>

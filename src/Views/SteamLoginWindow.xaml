<Window x:Class="SRT.SteamLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Steam" Width="460" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseLeftButtonDown="Drag">
    <!-- Same as the main window's Key and OptSub (they live in MainWindow.xaml, not in Theme.xaml) -->
    <Window.Resources>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="OptSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="MaxWidth" Value="640"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource TopLine}"/>
            <HeaderedContentControl Grid.Row="1" Style="{StaticResource Group}" Margin="14,14,14,6" Padding="18,20,18,16">
                <HeaderedContentControl.Header>
                    <TextBlock x:Name="Title_" Text="Sign in to Steam"/>
                </HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock x:Name="Intro" Style="{StaticResource Sub}" LineHeight="19"/>
                    <StackPanel Orientation="Horizontal" Margin="-9,12,0,10">
                        <RadioButton x:Name="ModePwd" Style="{StaticResource Seg}" GroupName="loginmode" Content="Password" IsChecked="True" Checked="Mode_Checked"/>
                        <RadioButton x:Name="ModeQr" Style="{StaticResource Seg}" GroupName="loginmode" Content="QR code (Steam app)" Checked="Mode_Checked"/>
                    </StackPanel>

                    <StackPanel x:Name="PwdPanel">
                        <TextBlock Text="Username" Style="{StaticResource Key}"/>
                        <TextBlock x:Name="LoginText" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                        <TextBlock Text="Password" Style="{StaticResource Key}"/>
                        <PasswordBox x:Name="Pwd" Margin="0,2,0,0"/>
                        <TextBlock Text="Used once to sign in, then deleted. Never saved, never in the log." Style="{StaticResource OptSub}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock x:Name="CodeLabel" Text="Steam Guard code" Style="{StaticResource Key}"/>
                        <TextBox x:Name="Code" FontFamily="{StaticResource Mono}" FontSize="15" Margin="0,2,0,0" MaxLength="10" CharacterCasing="Upper"/>
                    </StackPanel>

                    <StackPanel x:Name="QrPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                        <Border Background="White" Padding="0" Width="196" Height="196">
                            <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock Text="Steam app on your phone: Steam Guard, then the QR scanner. Then approve the sign-in." Style="{StaticResource OptSub}"
                                   TextAlignment="Center" Margin="0,8,0,0" MaxWidth="360"/>
                    </StackPanel>

                    <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Faint}" Margin="0,12,0,0" MinHeight="16"/>
                    <ProgressBar x:Name="Busy" IsIndeterminate="True" Margin="0,6,0,0" Visibility="Hidden"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click"/>
                        <Button x:Name="GoBtn" Style="{StaticResource Primary}" Content="Sign in" Margin="0" Click="Go_Click" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>
        </Grid>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CS2IPChanger</AssemblyName>
    <RootNamespace>SRT</RootNamespace>
    <Version>0.1.0-beta.4</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>CS2 IP Changer</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- The app runs as admin: DOTNET_STARTUP_HOOKS from the user's environment must not load code into it -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <!-- Dev build: only when the Privado/ folder exists (it stays out of git) -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\Privado')">
    <DefineConstants>$(DefineConstants);PRIVADO</DefineConstants>
    <InformationalVersion>$(Version)+dev</InformationalVersion>
  </PropertyGroup>

  <!-- Recording build (dotnet publish -c Release -p:Recording=true): personal data never reaches the screen, see Core/Recording.cs -->
  <PropertyGroup Condition="'$(Recording)'=='true'">
    <DefineConstants>$(DefineConstants);RECORDING</DefineConstants>
    <AssemblyName>CS2IPChanger-Recording</AssemblyName>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <!-- Test build (no UAC prompt) to take screenshots on the dev PC -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <ApplicationManifest>app.debug.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- Command sounds: Kenney "Interface Sounds" (CC0), see Assets/Sounds/LICENSE-kenney.txt -->
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="Sounds.%(Filename).wav" />
  </ItemGroup>

</Project>

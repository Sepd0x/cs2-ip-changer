<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ Accent color and top line -->
    <Color x:Key="AccentColor">#5BA8F0</Color>
    <Color x:Key="AccentLightColor">#7EBCF5</Color>
    <Color x:Key="AccentDarkColor">#3E87D0</Color>
    <Color x:Key="AccentSoftColor">#225BA8F0</Color>
    <SolidColorBrush x:Key="AccentDim" Color="#8C5BA8F0"/>
    <Color x:Key="Top1">#3BB4E5</Color>
    <Color x:Key="Top2">#C64FC6</Color>
    <Color x:Key="Top3">#D8E03A</Color>

    <!-- ============================================================ Base (same for all three colors) -->
    <Color x:Key="BgColor">#0E0E0E</Color>
    <Color x:Key="SurfaceColor">#171717</Color>
    <SolidColorBrush x:Key="Bg" Color="#0E0E0E"/>
    <SolidColorBrush x:Key="Side" Color="#0B0B0B"/>
    <SolidColorBrush x:Key="Surface" Color="#171717"/>
    <SolidColorBrush x:Key="Surface2" Color="#1D1D1D"/>
    <SolidColorBrush x:Key="Surface3" Color="#262626"/>
    <SolidColorBrush x:Key="Edge" Color="#050505"/>
    <SolidColorBrush x:Key="Line" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="LineStrong" Color="#383838"/>
    <SolidColorBrush x:Key="Text" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="Muted" Color="#ADADAD"/>
    <SolidColorBrush x:Key="Faint" Color="#888888"/>
    <SolidColorBrush x:Key="Good" Color="#7CC95A"/>
    <SolidColorBrush x:Key="GoodSoft" Color="#1E7CC95A"/>
    <SolidColorBrush x:Key="Warn" Color="#E3BF4B"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#1EE3BF4B"/>
    <SolidColorBrush x:Key="Bad" Color="#F05A4F"/>
    <SolidColorBrush x:Key="BadSoft" Color="#22F05A4F"/>
    <SolidColorBrush x:Key="BadDim" Color="#8CF05A4F"/>
    <SolidColorBrush x:Key="Info" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#10FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentText" Color="#0B0B0B"/>
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}"/>
    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentLightColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentDarkColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BoxFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A3A3A" Offset="0"/>
        <GradientStop Color="#262626" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BtnFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#252525" Offset="0"/>
        <GradientStop Color="#1C1C1C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BtnFillHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E2E2E" Offset="0"/>
        <GradientStop Color="#232323" Offset="1"/>
    </LinearGradientBrush>
    <!-- the thin line at the top of the window -->
    <LinearGradientBrush x:Key="TopLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Top1}" Offset="0"/>
        <GradientStop Color="{StaticResource Top2}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Top3}" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============================================================ Text -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Labels, hints and tags: here once, so the main window and the Steam sign-in window share them -->
    <Style x:Key="Tag" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,10,3"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Key" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style x:Key="OptSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
        <Setter Property="MaxWidth" Value="640"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ============================================================ Group box: the title sits on the line -->
    <Style x:Key="Group" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="14,16,14,12"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Border Margin="0,7,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Padding="5,0" Height="16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{StaticResource BgColor}" Offset="0"/>
                                    <GradientStop Color="{StaticResource BgColor}" Offset="0.5"/>
                                    <GradientStop Color="{StaticResource SurfaceColor}" Offset="0.5"/>
                                    <GradientStop Color="{StaticResource SurfaceColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.FontWeight="SemiBold" TextElement.FontSize="12" TextElement.Foreground="{StaticResource Text}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog: the title chip sits on the dimmed page -->
    <Style x:Key="DialogGroup" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="14,16,14,12"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Border Margin="0,7,0,0" Background="{StaticResource Surface}" BorderBrush="#000000" BorderThickness="1">
                            <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Padding="5,0" Height="16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#040404" Offset="0"/>
                                    <GradientStop Color="#040404" Offset="0.5"/>
                                    <GradientStop Color="{StaticResource SurfaceColor}" Offset="0.5"/>
                                    <GradientStop Color="{StaticResource SurfaceColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.FontWeight="SemiBold" TextElement.FontSize="12" TextElement.Foreground="{StaticResource Text}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Tooltip -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MaxWidth" Value="340"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="9,6">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="LineHeight" Value="17"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Buttons -->
    <!-- Keyboard focus (Tab): a thin accent outline; the mouse doesn't show it -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{StaticResource Accent}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Background" Value="{StaticResource BtnFill}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BtnFillHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentDim}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <!-- Disabled: plain, so it doesn't read as selected -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                <Setter Property="Background" Value="{StaticResource BtnFill}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource Bad}"/>
        <Style.Triggers>
            <!-- Disabled: grey, so it doesn't read as an active dark red button -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The Primary recipe in red: the confirm button of a dialog that undoes or deletes something -->
    <Style x:Key="DangerStrong" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource Bad}"/>
        <Setter Property="Background" Value="{StaticResource BadSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BadDim}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                <Setter Property="Background" Value="{StaticResource BtnFill}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- In-row actions (Join, Log in, Restore, Sign in, Update): the compact height -->
    <Style x:Key="RowBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>
    <Style x:Key="RowPrimary" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- A secondary in-row action: plain text, framed only while its row is hovered or selected -->
    <Style x:Key="RowGhost" TargetType="Button" BasedOn="{StaticResource RowBtn}">
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="o" BorderBrush="Transparent" BorderThickness="1">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="o" Property="BorderBrush" Value="{StaticResource Edge}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BtnFill}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="o" Property="BorderBrush" Value="{StaticResource Edge}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BtnFill}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="o" Property="BorderBrush" Value="{StaticResource Edge}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BtnFillHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style x:Key="Chrome" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Tag" Value="close"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BadSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Tabs on the left: icon and name -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="Height" Value="62"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
        <Setter Property="ToolTipService.Placement" Value="Right"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,1,0,1">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center"/>
                                <ContentPresenter Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- the active tab: a 2 px accent bar on the left edge -->
                            <Border x:Name="bar" Width="2" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Accent}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Bg}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text tabs (filters): the selected one turns white and underlined -->
    <Style x:Key="Seg" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="9,6" Margin="0,0,2,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox: small square, filled with the color when on -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                            <Border x:Name="box" Width="13" Height="13" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Background="{StaticResource BoxFill}"/>
                            <Path x:Name="tick" Data="M 3,6.5 L 5.5,9 L 10,4" Stroke="{StaticResource AccentText}" StrokeThickness="1.8" Visibility="Collapsed"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AccentFill}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentFill}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Muted}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Choice (radio): the same 13 px square as the checkbox, with a 5 px square inside when picked -->
    <Style x:Key="Choice" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,9"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                            <Border x:Name="box" Width="13" Height="13" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Background="{StaticResource BoxFill}"/>
                            <Border x:Name="dot" Width="5" Height="5" Background="{StaticResource AccentFill}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentFill}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Muted}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Fields -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="in" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Faint}" Margin="{TemplateBinding Padding}" FontFamily="{StaticResource UiFont}"
                                           Padding="2,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="in" Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="in" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="in" Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
                        <Border x:Name="b" Background="{StaticResource BtnFill}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="8" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BtnFillHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <!-- The same double frame as the context menu, so every popup matches -->
                            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Thin scrollbars -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="{StaticResource LineStrong}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThumbStyle}" Margin="1"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThumbStyle}" Margin="1"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ Card (accounts) -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ============================================================ Lists -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="b" Background="Transparent" Padding="8,4">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="bar" Width="2" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
                            <!-- Many accounts (Copy from an account): the menu scrolls instead of running off the screen -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                                <StackPanel IsItemsHost="True"/>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HasDropShadow" Value="False"/>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" Padding="8,5" MinWidth="200">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="12" Width="22" Foreground="{StaticResource Faint}"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource Line}" Margin="4,3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Foreground" Value="{StaticResource AccentFill}"/>
        <Setter Property="Background" Value="{StaticResource Surface3}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
